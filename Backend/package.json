{
  "name": "backend",
  "version": "1.0.0",
  "description": "Fastify backend with MySQL Sequelize",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "bot": "node telegram-bot.js",
