function encryptText(plainText) {
  const key = crypto.randomBytes(32);
  const iv = crypto.randomBytes(16);
  const cipher = crypto.createCipheriv('aes-256-cbc', key, iv);
  let encrypted = cipher.update(plainText, 'utf8', 'base64');
  encrypted += cipher.final('base64');
  return { encryptedData: iv.toString('base64') + ',' + encrypted + ',' + key.toString('base64') };
}

function decryptText(keyBase64, encryptedText, ivBase64) {
  try {
    const key = Buffer.from(keyBase64, 'base64');
    const iv = Buffer.from(ivBase64, 'base64');
    const decipher = crypto.createDecipheriv('aes-256-cbc', key, iv);
    let decrypted = decipher.update(encryptedText, 'base64', 'utf8');
    decrypted += decipher.final('utf8');
    return decrypted;
  } catch (err) {
    throw new Error('Decryption failed');
  }
}

// Parse Deribit quarterly expiry from symbol like "BTC-24APR26" → ms timestamp at 08:00 UTC
function parseExpiryFromSymbol(symbol) {
  const m = (symbol || '').match(/(\d{1,2})([A-Z]{3})(\d{2})$/);
  if (!m) return null;
  const months = { JAN: 0, FEB: 1, MAR: 2, APR: 3, MAY: 4, JUN: 5, JUL: 6, AUG: 7, SEP: 8, OCT: 9, NOV: 10, DEC: 11 };
  const day = parseInt(m[1]);
  const month = months[m[2]];
  const year = 2000 + parseInt(m[3]);
  if (month == null) return null;
  return new Date(Date.UTC(year, month, day, 8, 0, 0)).getTime();
}

const getApiCredentials = async (account) => {
  try {
    let vaultAddresspair = null;
    let passphrasepair = null;
    let seedpair = null;

    const [ak0, ak1, ak2] = account.Api_Key.split(',', 3);
    const apiKeypair = decryptText(ak2, ak1, ak0);

    let secretKeypair = null;
    if (account.Secret_Key) {
      const [sk0, sk1, sk2] = account.Secret_Key.split(',', 3);
      secretKeypair = decryptText(sk2, sk1, sk0);
    }
    if (account.vaultAddress) {
      const [va0, va1, va2] = account.vaultAddress.split(',', 3);
      vaultAddresspair = decryptText(va2, va1, va0);
    }
    if (account.passphrase) {
      const [pk0, pk1, pk2] = account.passphrase.split(',', 3);
      passphrasepair = decryptText(pk2, pk1, pk0);
    }
    if (account.seed) {
      const [sd0, sd1, sd2] = account.seed.split(',', 3);
      seedpair = decryptText(sd2, sd1, sd0);
    }
    return {
      apiKey: apiKeypair,
      secret: secretKeypair,
      accounttype: account.Account_Type,
      vaultAddress: vaultAddresspair,
      passphrase: passphrasepair,
      seed: seedpair,
    };
  } catch (error) {
    console.error(`Error getting API credentials: ${error.message}`);
    throw new Error('Failed to retrieve API credentials');
  }
};

