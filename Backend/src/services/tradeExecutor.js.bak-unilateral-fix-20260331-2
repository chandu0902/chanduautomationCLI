  async _cancelOrder(exchange, client, orderId, symbol, type) {
    const ex = exchange.toLowerCase();
    if (ex === 'deribit') {
      const cred = client.credential;
      await cancelorder(orderId, cred.apiKey, cred.secretKey);
    } else if (ex === 'hyperliquid') {
      const coin = this._buildHyperliquidCoin(symbol, type);
      await hypecancelOrder(client, { symbol: coin, id: orderId });
    }
  }

  async _getOrderStatus(exchange, client, orderId) {
    const ex = exchange.toLowerCase();
    if (ex === 'deribit') {
      const cred = client.credential;
      const resp = await deribitorderStatus(orderId, cred.apiKey, cred.secretKey);
      const orderState = resp?.result?.order_state || resp?.result?.[0]?.order_state;
      const filledPrice = resp?.result?.average_price || resp?.result?.[0]?.average_price || null;
      if (orderState === 'filled') {
        // get_order_state does NOT return fee — use get_user_trades_by_order instead
        let commission = null;
        try {
          const tradeResp = await signedRequest(
            `/api/v2/private/get_user_trades_by_order?order_id=${orderId}`,
            cred.apiKey, cred.secretKey
          );
          const fills = Array.isArray(tradeResp?.result) ? tradeResp.result : [];
          if (fills.length > 0) {
            // Sum fees across all fills (fee is in BTC, negative = maker rebate)
            commission = fills.reduce((sum, f) => sum + (f.fee ?? 0), 0);
          }
        } catch (e) {
          console.warn(`[_getOrderStatus] fee fetch failed for ${orderId}: ${e.message}`);
        }
        return { status: 'filled', filledPrice, commission };
      }
      if (orderState === 'cancelled' || orderState === 'rejected') return { status: 'cancelled' };
      return { status: 'open' };
    } else if (ex === 'hyperliquid') {
      const statusResp = await gethypeOrderStatus(client, orderId);
      const orderStatus = statusResp?.order?.status || statusResp?.status;
      const orderData = statusResp?.order?.order || {};
      const origSz = parseFloat(orderData.origSz || 0);
      const remainSz = parseFloat(orderData.sz || 0);
      const filledSz = origSz > 0 ? parseFloat((origSz - remainSz).toFixed(6)) : 0;
      const avgPx = parseFloat(orderData.limitPx || 0) || null;
      if (orderStatus === 'filled' || orderStatus === 'Filled') {
        return { status: 'filled', filledPrice: avgPx, filledSz: origSz };
      }
      if (orderStatus === 'canceled' || orderStatus === 'Canceled' || orderStatus === 'cancelled')
        return { status: 'cancelled', filledSz };
      return { status: 'open', filledSz, filledPrice: avgPx };
    }
    return { status: 'unknown' };
  }

  // ─── ENABLE / DISABLE ──────────────────────────────────────────────

  async enableTrading(pairId) {
    if (this.pairs.has(pairId) && this.pairs.get(pairId).enabled) {
      return { success: false, message: 'Trading already enabled for this pair' };
    }

    const pair = await StatArbInput.findByPk(pairId);
    if (!pair) return { success: false, message: 'Pair not found' };

    // Two-leg pair: any combination of futures/perps on either or both legs
    const t1 = (pair.type1 || '').toLowerCase();
    const t2 = (pair.type2 || '').toLowerCase();
    const _isFutOrPerp = t => t === 'future' || t === 'futures' || t === 'perps' || t === 'perp' || t === 'perpetual';
    const isBasisPair = _isFutOrPerp(t1) && _isFutOrPerp(t2);

    if (!pair.tradeAccountB) {
      return { success: false, message: 'Pair missing tradeAccountB (executing leg account)' };
    }
    const _unilateral = !!(pair.unilateralMode === true || pair.unilateralMode === 1);
    if (!_unilateral && !pair.qty2) {
      return { success: false, message: 'Pair missing qty2 (executing leg quantity)' };
    }
    if (isBasisPair && !pair.tradeAccountA) {
      return { success: false, message: 'Basis pair missing tradeAccountA (futures leg account)' };
    }

    const accountB = await AccountDetails.findOne({ where: { Trade_Account: pair.tradeAccountB } });
    if (!accountB) return { success: false, message: 'tradeAccountB not found in AccountDetails' };

    const state = new PairTradeState(pairId);
    state.pairConfig = pair;
    state.isBasisPair = isBasisPair;
    state.isDeribitBasis = isBasisPair &&
      (pair.exchange1 || '').toLowerCase() === 'deribit' &&
      (pair.exchange2 || '').toLowerCase() === 'deribit';
    state.unilateralMode = isBasisPair && _unilateral;
    state.tpSpreadDelta = pair.tpSpreadDelta != null ? parseFloat(pair.tpSpreadDelta) : null;
    state.slSpreadDelta = pair.slSpreadDelta != null ? parseFloat(pair.slSpreadDelta) : null;
    state.exchangeExec = pair.exchange2.toLowerCase();

    // Profit target / stop loss for basis pairs (both in USD gross P&L):
    //   profitTarget = USD gross profit to exit (must exceed fee floor of ~$0.10 for 300/240 notional)
    //   stopLoss     = USD gross loss to stop out (default = $0.10 ≈ 1σ spread move)
    //   Ratio target: profitTarget / stopLoss >= 1.5 for long-run profitability
    if (isBasisPair) {
      state.profitTarget = pair.profitTarget ?? null;
      state.profitFeeMultiplier = pair.profitFeeMultiplier != null ? parseInt(pair.profitFeeMultiplier) : 10;
      state.stopLoss = pair.stopLoss ?? null;
      state.maxHoldMs = pair.maxHoldMs != null ? parseInt(pair.maxHoldMs) : null;
      state.maxSpreadCap = pair.maxSpreadCap != null ? parseFloat(pair.maxSpreadCap) : null;
      state.entryPollTimeoutMs = pair.entryPollTimeoutMs != null ? parseInt(pair.entryPollTimeoutMs) : null;
      if (pair.spreadEntryLevels) {
        state._spreadLevels = pair.spreadEntryLevels.split(',').map(Number).filter(n => !isNaN(n) && n > 0).sort((a, b) => a - b);
        // Per-level qty proportional to spread level value (higher spread = more size)
        const _totalWeight = state._spreadLevels.reduce((a, b) => a + b, 0);
        // Deribit inverse futures: amount must be a multiple of 10 USD
        const _deribitLot = state.isDeribitBasis ? 10 : 1;
        const _roundLot = (n) => Math.max(_deribitLot, Math.round(n / _deribitLot) * _deribitLot);
        state._levelQty1 = state._spreadLevels.map(lvl => _roundLot((pair.qty1 * lvl) / _totalWeight));
        state._levelQty2 = state.unilateralMode
          ? state._spreadLevels.map(() => 0)
          : state._spreadLevels.map(lvl => _roundLot((pair.qty2 * lvl) / _totalWeight));

        const _lvlSummary = state._spreadLevels.map((lvl, i) =>
          state.unilateralMode
            ? `$${lvl}→${state._levelQty1[i]}`
            : `$${lvl}→${state._levelQty1[i]}/${state._levelQty2[i]}`
        ).join(' | ');
        const _uniTag = state.unilateralMode ? ' | UNILATERAL (futures only)' : '';
        console.log(`[TradeExecutor] Dollar spread entry levels pair ${pairId}: ${_lvlSummary} | SHORT_BASIS only | z-gate=${state.zEntryThreshold ?? 1.0}${_uniTag}`);
      }
    } else {
      state.profitTarget = pair.profitTarget ?? DEFAULT_PROFIT_TARGET;
      state.stopLoss = pair.stopLoss ?? DEFAULT_STOP_LOSS;
    }

    const credB = await getApiCredentials(accountB);
    try {
      state.clientExec = await this._initClient(state.exchangeExec, credB);
      console.log(`[TradeExecutor] ${state.exchangeExec} client (legB/exec) initialized for pair ${pairId}`);
    } catch (e) {
      return { success: false, message: `Failed to init exec client: ${e.message}` };
    }

    // Basis pair: also initialise the futures (legA) client
    if (isBasisPair) {
      const accountA = await AccountDetails.findOne({ where: { Trade_Account: pair.tradeAccountA } });
      if (!accountA) return { success: false, message: 'tradeAccountA not found in AccountDetails' };
      const credA = await getApiCredentials(accountA);
      try {
        state.clientA = await this._initClient(pair.exchange1.toLowerCase(), credA);
        state.exchangeA = pair.exchange1.toLowerCase();
        state.symbolA = pair.symbol1;
        state.typeA = pair.type1;
        console.log(`[TradeExecutor] ${state.exchangeA} client (legA/futures) initialized for pair ${pairId}`);
      } catch (e) {
        return { success: false, message: `Failed to init legA client: ${e.message}` };
      }
    }

    // Restore cumulative filled qty
    try {
      const closed = await Trade.findAll({
        where: { pairId, status: 'filled' },
        attributes: ['legA_qty'],
      });
      state.filledQty = closed.reduce((s, t) => s + (t.legA_qty || 0), 0);
      console.log(`[TradeExecutor] Cumulative filled qty pair ${pairId}: ${state.filledQty}`);
    } catch (e) {
      console.error(`[TradeExecutor] Failed to load filled qty: ${e.message}`);
    }

    // Restore open positions for multi-basis pairs from basis_positions table.
    // This is the single source of truth — avoids naive entry-count vs exit-count
    // arithmetic that fails on orphaned or partially-filled legs.
    if (isBasisPair && pair.maxPositions > 1) {
      try {
        const { Op } = require('sequelize');
        const activeBPs = await BasisPosition.findAll({
          where: { pairId, state: { [Op.in]: ['pending_entry', 'open', 'pending_exit'] } },
          order: [['id', 'ASC']],
        });
        for (const bp of activeBPs) {
          // Use per-level weighted qty when available, not raw config total
          const _lvlIdx = bp.gridLevel != null ? bp.gridLevel - 1 : -1;
          const qty1 = bp.legA_entryQty
            || (_lvlIdx >= 0 && state._levelQty1?.[_lvlIdx]) || pair.qty1;
          const qty2 = bp.legB_entryQty
            || (_lvlIdx >= 0 && state._levelQty2?.[_lvlIdx]) || pair.qty2;
          const rebateFut = DERIBIT_MAKER_REBATE * qty1;
          const takerPerp = DERIBIT_TAKER_FEE * qty2;
          const pos = {
            posId: Date.now() + Math.random(),
            _basisPositionId: bp.id,
            tradeId: bp.entryTradeId,
            direction: bp.direction,
            entryZScore: bp.entryZScore,
            entrySpread: bp.entrySpread,
            entryTime: bp.entryTime ? new Date(bp.entryTime).getTime() : Date.now(),
            _orderPriceA: bp.legA_entryPrice,
            entryPriceA: bp.legA_entryPrice,
            entryPriceB: bp.legB_entryPrice,
            orderIdA: bp.legA_entryOrderId,
            orderIdB: bp.legB_entryOrderId,
            closeOrderIdA: bp.legA_exitOrderId ?? null,
            closeOrderIdB: bp.legB_exitOrderId ?? null,
            legAFilled: bp.state !== 'pending_entry',
            legBFilled: bp.state !== 'pending_entry',
            exitLegAFilled: bp.state === 'pending_exit' && !!bp.legA_exitOrderId,
            exitLegBFilled: false,
            _exitPriceA: bp.legA_exitPrice ?? null,
            _exitPriceB: null,
            _exitCommA: null,
            _exitCommB: null,
            _exitTradeId: bp.exitTradeId ?? null,
            _pendingLegBSide: bp.state === 'pending_entry' ? (bp.direction === 'long' ? 'buy' : 'sell') : null,
            _pendingLegBPrice: null,
            _legBPlaced: bp.state === 'pending_exit' || bp.legB_entryPrice != null,
            qty1,
            qty2,
            posState: bp.state === 'pending_entry' ? 'pending' : 'open',
            entryCommissionA: null,
            entryCommissionUsd: null,
            entryTakerFeeUsd: null,
            _minProfitUsd: (state.profitFeeMultiplier ?? 10) * (takerPerp - rebateFut) * 2,
            _fillSpread: (bp.legA_entryPrice && bp.legB_entryPrice) ? parseFloat((bp.legA_entryPrice - bp.legB_entryPrice).toFixed(4)) : null,
            _exiting: bp.state === 'pending_exit',
            _pollTimer: null,
            _pollStart: 0,
            gridLevel: bp.gridLevel ?? null,
          };
          state.openPositions.push(pos);
          this._startMultiBasisPosPoll(state, pos);
          console.log(`[TradeExecutor] Restored pos pair ${pairId} bpId=${bp.id} state=${bp.state} gridLevel=${bp.gridLevel} | ${bp.direction} legA=${bp.legA_entryPrice} legB=${bp.legB_entryPrice} minProfit=$${pos._minProfitUsd.toFixed(4)}`);
        }
        if (activeBPs.length === 0) {
          console.log(`[TradeExecutor] No active basis positions to restore for pair ${pairId}`);
        }
      } catch (e) {
        console.error(`[TradeExecutor] Failed to restore open positions pair ${pairId}: ${e.message}`);
      }

      // ── Exchange reconciliation ─────────────────────────────────────
      // Cross-check DB "open" positions against actual exchange positions.
      // If the exchange has zero position size for a symbol the DB thinks
      // is open, mark the DB record as closed to prevent ghost positions.
      if (state.isDeribitBasis && state.clientA?.credential) {
        try {
          const exchangePositions = await getDeribitPositions(
            state.clientA.credential.apiKey,
            state.clientA.credential.secretKey,
            'BTC'
          );
          const sizeByInstrument = {};
          for (const ep of exchangePositions) {
            sizeByInstrument[ep.instrument_name] = Math.abs(ep.size || 0);
          }
          const futSymbol = pair.symbol1;
          const perpSymbol = pair.symbol2;
          const futSize = sizeByInstrument[futSymbol] || 0;
          const perpSize = sizeByInstrument[perpSymbol] || 0;
          const dbOpenCount = state.openPositions.filter(p => p.posState === 'open').length;
          if (dbOpenCount > 0 && futSize === 0 && perpSize === 0) {
            console.warn(`[TradeExecutor] RECONCILIATION pair ${pairId}: DB has ${dbOpenCount} open positions but exchange has 0 size for ${futSymbol}/${perpSymbol} — closing orphaned DB records`);
            for (const pos of state.openPositions.filter(p => p.posState === 'open')) {
              pos.posState = 'closed';
              if (pos._pollTimer) { clearInterval(pos._pollTimer); pos._pollTimer = null; }
              if (pos._basisPositionId) {
                BasisPosition.update({
                  state: 'closed', exitReason: 'reconciliation_no_exchange_pos',
                  exitTime: new Date(),
                }, { where: { id: pos._basisPositionId } }).catch(() => { });
              }
            }
            state.openPositions = state.openPositions.filter(p => p.posState !== 'closed');
          } else {
            console.log(`[TradeExecutor] Reconciliation pair ${pairId}: exchange ${futSymbol}=${futSize} ${perpSymbol}=${perpSize} | DB open=${dbOpenCount} — OK`);
          }
        } catch (e) {
          console.warn(`[TradeExecutor] Reconciliation check failed pair ${pairId}: ${e.message}`);
        }
      }
    }

    // Dynamic daily loss limit — USD override takes precedence over pct-based
    if (pair.dailyLossLimitUsd != null && pair.dailyLossLimitUsd > 0) {
      state.dailyLossLimit = parseFloat(pair.dailyLossLimitUsd);
      console.log(`[TradeExecutor] Daily loss limit pair ${pairId}: $${state.dailyLossLimit} (hard USD cap)`);
    } else if (pair.dailyLossLimitPct != null && pair.dailyLossLimitPct > 0) {
      try {
        const equity = await this._getAccountBalance(state);
        if (equity != null && equity > 0) {
          state.dailyLossLimit = parseFloat((equity * pair.dailyLossLimitPct / 100).toFixed(4));
          state._cachedBalance = equity;
          console.log(`[TradeExecutor] Daily loss limit pair ${pairId}: $${state.dailyLossLimit} (${pair.dailyLossLimitPct}% of $${equity.toFixed(2)})`);
        }
      } catch (e) {
        console.warn(`[TradeExecutor] Could not fetch balance for daily loss limit: ${e.message}`);
      }
    }

    // Per-pair z-score entry threshold override
    if (pair.zEntryThreshold != null && pair.zEntryThreshold > 0) {
      state.zEntryThreshold = parseFloat(pair.zEntryThreshold);
      console.log(`[TradeExecutor] Z-entry threshold pair ${pairId}: ±${state.zEntryThreshold} (override)`);
    }

    // Multi-position config (single-leg and basis pairs)
    if (pair.maxPositions != null && pair.maxPositions > 1) {
      state.maxPositions = parseInt(pair.maxPositions);
      state.zEntryMax = pair.zEntryMax != null ? parseFloat(pair.zEntryMax) : null;
      console.log(`[TradeExecutor] Multi-position pair ${pairId}: max=${state.maxPositions} z=[${state.zEntryThreshold ?? '?'},${state.zEntryMax ?? '∞'}]`);
    }

    // Grid config for Deribit basis carry-rate trading (isDeribitBasis + maxPositions > 1)
    // zEntryThreshold = lower rate bound (e.g. 2.0%), zEntryMax = upper rate bound (e.g. 4.0%)
    if (state.isDeribitBasis && state.maxPositions > 1) {
      const expiryMs = parseExpiryFromSymbol(pair.symbol1);
      if (expiryMs) {
        state._expiryMs = expiryMs;
        if (state._spreadLevels) {
          console.log(`[TradeExecutor] Deribit basis SPREAD-LEVEL pair ${pairId}: [$${state._spreadLevels.join('/$')}] SHORT_BASIS only expiry=${new Date(expiryMs).toISOString()}`);
        } else {
          const gridMin = state.zEntryThreshold ?? 2.0;
          const gridMax = state.zEntryMax ?? 4.0;
          const steps = state.maxPositions;
          state._gridLevels = Array.from({ length: steps }, (_, i) =>
            gridMin + (gridMax - gridMin) * (i / (steps - 1))
          );
          console.log(`[TradeExecutor] Deribit basis GRID pair ${pairId}: short=[${state._gridLevels.map((r, i) => '+' + (i + 1) + '@z' + r.toFixed(2)).join(', ')}] long=[${state._gridLevels.map((r, i) => '-' + (i + 1) + '@z-' + r.toFixed(2)).join(', ')}] expiry=${new Date(expiryMs).toISOString()}`);
        }
      }
    }

    // Per-leg quantity limits
    if (pair.maxLegAQty != null) state.maxLegAQty = parseFloat(pair.maxLegAQty);
    if (pair.maxLegBQty != null) state.maxLegBQty = parseFloat(pair.maxLegBQty);
    if (pair.maxNetQtyImbalance != null) state.maxNetQtyImbalance = parseFloat(pair.maxNetQtyImbalance);
    if (state.maxLegAQty || state.maxLegBQty || state.maxNetQtyImbalance) {
      console.log(`[TradeExecutor] Qty limits pair ${pairId}: maxLegA=${state.maxLegAQty ?? '∞'} maxLegB=${state.maxLegBQty ?? '∞'} maxImbalance=${state.maxNetQtyImbalance ?? '∞'}`);
    }

    // Daily profit limit
    if (pair.dailyProfitLimitPct != null && pair.dailyProfitLimitPct > 0) {
      try {
        const equity = state._cachedBalance ?? await this._getAccountBalance(state);
        if (equity != null && equity > 0) {
          state.dailyProfitLimit = parseFloat((equity * pair.dailyProfitLimitPct / 100).toFixed(4));
          console.log(`[TradeExecutor] Daily profit limit pair ${pairId}: $${state.dailyProfitLimit} (${pair.dailyProfitLimitPct}% of $${equity.toFixed(2)})`);
        }
      } catch (e) {
        console.warn(`[TradeExecutor] Could not fetch balance for daily profit limit: ${e.message}`);
      }
    }

    // Guard: refuse to enable a second pair that trades the same exec symbol on the same exchange.
    // This prevents the Mar-21 incident where 4 pairs raced on the same BRENTOIL orderbook.
    for (const [existingId, s] of this.pairs) {
      if (s.enabled && existingId !== pairId &&
        s.pairConfig.exchange2 === pair.exchange2 &&
        s.pairConfig.symbol2 === pair.symbol2) {
        return {
          success: false,
          message: `Conflict: pair ${existingId} is already trading ${pair.symbol2} on ${pair.exchange2}. Disable it first.`,
        };
      }
    }

    state.enabled = true;
    state.enabledAt = Date.now();
    this.pairs.set(pairId, state);
    const mode = !isBasisPair ? 'SINGLE-LEG' : (state.unilateralMode ? 'UNILATERAL BASIS (futures only)' : 'TWO-LEG BASIS');
    const _uniExit = state.unilateralMode && state.tpSpreadDelta != null
      ? ` | uni TPΔ=$${state.tpSpreadDelta} SLΔ=$${state.slSpreadDelta}` : '';
    console.log(`[TradeExecutor] ${mode} trading enabled pair ${pairId} | legA=${state.exchangeA || '-'}/${pair.symbol1} legB=${state.exchangeExec}/${pair.symbol2} (signal) | PT=${state.profitTarget} SL=${state.stopLoss}${_uniExit}`);

    // Reset session fields — actual startBalance saved after first reconcile
    const sessionEnabledAt = new Date();
    state._enabledAt = sessionEnabledAt;
    StatArbInput.update({
      sessionStartedAt: sessionEnabledAt,
      sessionStartBalance: null,
      sessionEndBalance: null,
      sessionPnl: null,
      sessionStoppedAt: null,
    }, { where: { id: pairId } }).catch(() => { });

    // Close any unclosed session rows from a previous crash, then create new row
    BotSessionLog.findOne({
      where: { pairId },
      order: [['id', 'DESC']],
    }).then(async lastSession => {
      // If previous session never closed (crash), backfill it now
      if (lastSession && lastSession.disabledAt == null) {
        const crashedAt = sessionEnabledAt; // best estimate: now
        const uptimeMs = lastSession.enabledAt
          ? crashedAt.getTime() - new Date(lastSession.enabledAt).getTime()
          : null;
        await BotSessionLog.update(
          { disabledAt: crashedAt, uptimeMs, stopReason: 'crash' },
          { where: { id: lastSession.id } }
        );
        console.log(`[TradeExecutor] Backfilled crashed session log ${lastSession.id} pair ${pairId}`);
      }
      const downtimeMs = (lastSession?.disabledAt)
        ? sessionEnabledAt.getTime() - new Date(lastSession.disabledAt).getTime()
        : null;
      return BotSessionLog.create({ pairId, enabledAt: sessionEnabledAt, downtimeMs });
    }).then(log => {
      state._sessionLogId = log.id;
    }).catch(() => { });

    // Start exchange reconciliation — immediate first run + 5-min periodic
    this._startReconcileTimer(pairId);
    this._reconcileWithExchange(pairId).catch(e =>
      console.error(`[TradeExecutor] Startup reconcile failed pair ${pairId}: ${e.message}`)
    );

    this._broadcastState(pairId);
    return { success: true, message: 'Trading enabled', state: state.state };
  }

  async disableTrading(pairId, reason = 'manual') {
    const state = this.pairs.get(pairId);
    if (!state || !state.enabled) {
      return { success: false, message: 'Trading not enabled for this pair' };
    }

    if (state.pollTimer) {
      clearInterval(state.pollTimer);
      state.pollTimer = null;
    }

    if (state._reconcileTimer) {
      clearInterval(state._reconcileTimer);
      state._reconcileTimer = null;
    }

    if (state.state === STATES.ENTRY_PENDING || state.state === STATES.EXIT_PENDING) {
      // Cancel legB (perp) order
      const idB = state.orderId || state.orderIdB || state.closeOrderIdB;
      if (idB) {
        try {
          await this._cancelOrder(state.exchangeExec, state.clientExec, idB, state.pairConfig.symbol2, state.pairConfig.type2);
          console.log(`[TradeExecutor] Cancelled legB order ${idB} pair ${pairId}`);
        } catch (e) {
          console.error(`[TradeExecutor] Failed to cancel legB order on disable: ${e.message}`);
        }
      }
      // Cancel legA (futures) order for basis pairs
      if (state.isBasisPair && state.clientA) {
        const idA = state.orderIdA || state.closeOrderIdA;
        if (idA) {
          try {
            await this._cancelOrder(state.exchangeA, state.clientA, idA, state.symbolA, state.typeA);
            console.log(`[TradeExecutor] Cancelled legA order ${idA} pair ${pairId}`);
          } catch (e) {
            console.error(`[TradeExecutor] Failed to cancel legA order on disable: ${e.message}`);
          }
        }
      }
    }

    // Cancel all per-position poll timers and mark pending DB entries cancelled
    if (state.openPositions && state.openPositions.length > 0) {
      for (const pos of state.openPositions) {
        if (pos._pollTimer) { clearInterval(pos._pollTimer); pos._pollTimer = null; }
        if (pos.posState === 'pending' && pos.tradeId) {
          Trade.update({ status: 'cancelled' }, { where: { id: pos.tradeId } }).catch(() => { });
        }
        if (pos.posState === 'exiting' && pos._exitTradeId) {
          Trade.update({ status: 'cancelled' }, { where: { id: pos._exitTradeId } }).catch(() => { });
        }
      }
    }

    // Fetch end balance from exchange and persist session + lifetime PnL + uptime
    try {
      const disabledAt = new Date();
      const uptimeMs = state._enabledAt ? disabledAt.getTime() - state._enabledAt.getTime() : null;
      const endBalance = await this._getAccountBalance(state);

      // Session PnL
      const sessionPnl = (endBalance != null && state._startBalance != null)
        ? parseFloat((endBalance - state._startBalance).toFixed(4))
        : null;

      // Lifetime PnL — read botStartBalance from DB (never overwritten)
      const pairRow = await StatArbInput.findByPk(pairId, { attributes: ['botStartBalance', 'totalUptimeMs'] });
      const botPnl = (endBalance != null && pairRow?.botStartBalance != null)
        ? parseFloat((endBalance - pairRow.botStartBalance).toFixed(4))
        : null;
      const totalUptimeMs = ((pairRow?.totalUptimeMs ?? 0) * 1) + (uptimeMs ?? 0);

      await StatArbInput.update({
        sessionEndBalance: endBalance,
        sessionPnl,
        sessionStoppedAt: disabledAt,
        botEndBalance: endBalance,
        botPnl,
        totalUptimeMs,
        lastStopReason: reason,
        lastDisabledAt: disabledAt,
      }, { where: { id: pairId } });

      // Close the BotSessionLog row for this session
      if (state._sessionLogId) {
        BotSessionLog.update({
          disabledAt,
          uptimeMs,
          stopReason: reason,
          startBalance: state._startBalance ?? null,
          endBalance: endBalance ?? null,
          sessionPnl,
        }, { where: { id: state._sessionLogId } }).catch(() => { });
      }

      console.log(`[TradeExecutor] Session ended pair ${pairId} reason=${reason} | uptime=${uptimeMs != null ? Math.round(uptimeMs / 60000) + 'min' : '?'} | balance: $${state._startBalance?.toFixed(2) ?? '?'} → $${endBalance?.toFixed(2) ?? '?'} | session pnl=${sessionPnl != null ? '$' + sessionPnl.toFixed(4) : '?'} | lifetime pnl=${botPnl != null ? '$' + botPnl.toFixed(4) : '?'}`);
    } catch (e) {
      console.warn(`[TradeExecutor] Failed to fetch end balance on disable pair ${pairId}: ${e.message}`);
    }

    state.enabled = false;
    state.state = STATES.IDLE;
    this.pairs.delete(pairId);
    console.log(`[TradeExecutor] Trading disabled pair ${pairId}`);
    this._broadcastState(pairId);
    return { success: true, message: 'Trading disabled' };
  }

  // ─── MAIN SPREAD UPDATE HANDLER ────────────────────────────────────

  onSpreadUpdate(pairId, sellStats, buyStats, orderbooks) {
    const state = this.pairs.get(pairId);
    if (!state || !state.enabled) return;

    state.lastOrderbooks = orderbooks;
    state.barCount++;

    // Warmup guard: don't trade until rolling window has enough history
    if (state.barCount < MIN_WARMUP_BARS) {
      if (state.barCount % 10 === 0) {
        console.log(`[TradeExecutor] pair ${pairId} WARMUP ${state.barCount}/${MIN_WARMUP_BARS} bars`);
      }
      return;
    }

    // Daily loss reset at midnight
    const today = new Date().toDateString();
    if (state.dailyResetDate !== today) { state.dailyResetDate = today; state.dailyLoss = 0; state.dailyProfit = 0; }

    // Need a stable mean
    if (!(sellStats.std > 0)) return;

    const spread = sellStats.spread;
    const mean = sellStats.mean;
    const dev = spread - mean;
    const absDev = Math.abs(dev);

    // Prices for fee calculation (both legs needed to normalise spread units)
    const obCL = orderbooks.leg1;
    const obBrent = orderbooks.leg2;
    const priceCL = parseFloat(obCL?.asks?.[0]?.price || obCL?.bids?.[0]?.price || 0);
    const priceBrent = parseFloat(obBrent?.asks?.[0]?.price || obBrent?.bids?.[0]?.price || 0);
    if (priceCL <= 0 || priceBrent <= 0) return;

    const qtyCL = state.pairConfig.qty1;
    const qtyBrent = state.pairConfig.qty2;

    // Fee cost in spread units (normalised to signal-leg notional)
    // Single-leg (CL/BRENT): BRENT maker round-trip + CL taker hedge round-trip (70% qty)
    // Basis pair: handled by ENTRY_MULT * feeMult (×2 multiplier applied below)
    const makerFee = MAKER_FEE_BY_EXCHANGE[state.exchangeExec] ?? MAKER_FEE;
    const takerFee = TAKER_FEE_BY_EXCHANGE[state.exchangeExec] ?? 0.00045;
    const brentFeeDollar = priceBrent * qtyBrent * makerFee * 2;
    const clHedgeDollar = !state.isBasisPair
      ? priceCL * (qtyBrent * CL_HEDGE_RATIO) * takerFee * 2
      : 0;
    const feeCost = (brentFeeDollar + clHedgeDollar) / (priceCL * qtyCL);

    // Log every 5 s
    if (!state._lastZLog || Date.now() - state._lastZLog > 5000) {
      const devMult = feeCost > 0 ? (absDev / feeCost).toFixed(1) : '?';
      console.log(`[TradeExecutor] pair ${pairId} | ${state.state} | spread=${spread.toFixed(6)} mean=${mean.toFixed(6)} | dev=${dev.toFixed(6)} (${devMult}×fee) | loss=$${state.dailyLoss.toFixed(4)}`);
      state._lastZLog = Date.now();
    }

    // ═══════════════════════════════════════════════════════════════════
    //  MULTI-POSITION PATH (single-leg only, maxPositions > 1)
    //  Allows up to N simultaneous independent positions.
    //  Each position manages its own entry/exit via per-position poll timers.
    // ═══════════════════════════════════════════════════════════════════
    if (!state.isBasisPair && state.maxPositions > 1) {
      // Check profit target for each open position every tick
      const obBrent = orderbooks.leg2;
      const brentBid = obBrent?.bids?.[0]?.price ? parseFloat(obBrent.bids[0].price) : null;
      const brentAsk = obBrent?.asks?.[0]?.price ? parseFloat(obBrent.asks[0].price) : null;
      for (const pos of state.openPositions) {
        if (pos.posState !== 'open' || pos._exiting) continue;
        if (!brentBid || !brentAsk) continue;
        const priceDelta = pos.direction === 'long' ? brentBid - pos.entryPrice : pos.entryPrice - brentAsk;
        if (priceDelta >= state.profitTarget) {
          console.log(`[TradeExecutor] MULTI-POS PROFIT TARGET pair ${pairId} pos=${pos.posId} | delta=$${priceDelta.toFixed(4)} >= $${state.profitTarget}`);
          pos._exiting = true;
          this._exitMultiPos(state, pos, orderbooks).catch(e => {
            console.error(`[TradeExecutor] Multi-pos exit error pair ${pairId}: ${e.message}`);
            pos._exiting = false;
          });
        }
      }

      // Try new entry if capacity available and risk limits OK
      const openCount = state.openPositions.filter(p => p.posState !== 'closed').length;
      const canEnter = openCount < state.maxPositions
        && !state._entering
        && state.dailyLoss < state.dailyLossLimit
        && state.dailyProfit < state.dailyProfitLimit
        && !(state.consecutiveLosses >= LOSS_STREAK_THRESHOLD && state.lastLossTime && (Date.now() - state.lastLossTime) < LOSS_STREAK_COOLDOWN_MS)
        && Date.now() - state.lastMultiEntryTime >= COOLDOWN_MS;

      if (canEnter) {
        const absZ = Math.abs(sellStats.zScore);
        const zMin = state.zEntryThreshold;
        const zMax = state.zEntryMax;
        const inRange = absZ >= zMin && (zMax == null || absZ <= zMax);
        const feeMult = 1;
        const entryThresh = ENTRY_MULT * feeCost * feeMult;
        if (inRange && absDev >= entryThresh) {
          const entryDir = dev > 0 ? 'long' : 'short';
          // z-spacing: prevent stacking positions entered at nearly the same z level
          const Z_SPACING = 0.3;
          const tooClose = state.openPositions.some(
            p => p.posState !== 'closed' && p.direction === entryDir && Math.abs((p.entryZScore ?? 0) - sellStats.zScore) < Z_SPACING
          );
          if (!tooClose) {
            console.log(`[TradeExecutor] MULTI-POS ENTRY pair ${pairId} [${openCount + 1}/${state.maxPositions}] | ${entryDir.toUpperCase()} | z=${sellStats.zScore?.toFixed(3)}`);
            state._entering = true;
            state.lastMultiEntryTime = Date.now();
            this._enterMultiPos(state, sellStats, orderbooks, entryDir).finally(() => { state._entering = false; });
          }
        }
      }
      return;
    }

    // ═══════════════════════════════════════════════════════════════════
    //  MULTI-POSITION BASIS PATH (isBasisPair + maxPositions > 1)
    //  Up to N simultaneous two-leg basis positions, each tracked independently.
    //  Exit: Deribit → unrealisedPnl > 0 (net of 2× charges); each pos has own prices.
    // ═══════════════════════════════════════════════════════════════════
    if (state.isBasisPair && state.maxPositions > 1) {
      // 1. Check exit condition for every open basis position
      for (const pos of state.openPositions) {
        if (pos.posState !== 'open' || pos._exiting) continue;
        const holdMs = Date.now() - pos.entryTime;
        if (holdMs < MIN_HOLD_MS) continue;

        let shouldExit = false;
        let exitReason = 'profit';

        const effectivePriceA = pos.entryPriceA || pos._orderPriceA;
        if (state.isDeribitBasis && effectivePriceA && pos.entryPriceB != null) {
          const ob1 = orderbooks.leg1;
          const ob2 = orderbooks.leg2;
          // On exit: buy back futures at ASK, sell perp at BID (fill-side prices)
          const liveA = pos.direction === 'long'
            ? parseFloat(ob1?.asks?.[0]?.price || effectivePriceA)
            : parseFloat(ob1?.bids?.[0]?.price || effectivePriceA);
          const liveB = pos.direction === 'long'
            ? parseFloat(ob2?.bids?.[0]?.price || pos.entryPriceB)
            : parseFloat(ob2?.asks?.[0]?.price || pos.entryPriceB);
          const qty1 = pos.qty1 || state.pairConfig.qty1;
          const qty2 = pos.qty2 || state.pairConfig.qty2;
          // Deribit inverse PnL: PnL = size × (1/entry − 1/mark)
          // direction='long' → legA is SHORT fut, legB is LONG perp
          const pnlA_btc = pos.direction === 'long'
            ? parseFloat((qty1 * (1 / liveA - 1 / effectivePriceA)).toFixed(8))
            : parseFloat((qty1 * (1 / effectivePriceA - 1 / liveA)).toFixed(8));
          const pnlB_btc = (state.unilateralMode || !qty2)
            ? 0
            : (pos.direction === 'long'
              ? parseFloat((qty2 * (1 / pos.entryPriceB - 1 / liveB)).toFixed(8))
              : parseFloat((qty2 * (1 / liveB - 1 / pos.entryPriceB)).toFixed(8)));
          const grossPnl_btc = pnlA_btc + pnlB_btc;
          // Convert to USD-equivalent for threshold comparison (DB stores thresholds in USD-like units)
          const _refPrice = liveA || effectivePriceA;
          const grossPnl = grossPnl_btc * _refPrice;
          const grossPnlFutOnly = parseFloat((pnlA_btc * _refPrice).toFixed(6));
          const unrealisedPnl = grossPnl - (pos._minProfitUsd || 0);
          const slUsd = state.stopLoss;
          const ptUsd = state.profitTarget > 0 ? state.profitTarget : null;
          // Use FILL spread (actual execution prices) for exit comparison, not signal spread.
          // Signal spread is preserved in DB for tracking but fill spread drives exit logic.
          const fillSpread = pos._fillSpread ?? (effectivePriceA - pos.entryPriceB);
          const perpAskNow = parseFloat(ob2?.asks?.[0]?.price || pos.entryPriceB);
          const currentSpread = liveA - perpAskNow;

          if (state.unilateralMode && state.tpSpreadDelta != null && state.slSpreadDelta != null) {
            const tpHit = (fillSpread - currentSpread) >= state.tpSpreadDelta;
            const slSpreadHit = (currentSpread - fillSpread) >= state.slSpreadDelta;
            const slUsdHit = slUsd != null && grossPnlFutOnly <= -slUsd;
            if (tpHit) {
              pos._profitBreachCount = (pos._profitBreachCount || 0) + 1;
              pos._stopBreachCount = 0;
              if (pos._profitBreachCount >= 6) { shouldExit = true; exitReason = 'profit'; }
            } else if (slSpreadHit || slUsdHit) {
              pos._stopBreachCount = (pos._stopBreachCount || 0) + 1;
              pos._profitBreachCount = 0;
              if (pos._stopBreachCount >= 3) { shouldExit = true; exitReason = 'stop'; }
            } else {
              pos._stopBreachCount = 0;
              pos._profitBreachCount = 0;
            }
          } else {
            const spreadNarrowed = currentSpread < fillSpread;
            const profitCondition = spreadNarrowed && (ptUsd != null ? grossPnl >= ptUsd : unrealisedPnl > 0);
            if (profitCondition) {
              pos._profitBreachCount = (pos._profitBreachCount || 0) + 1;
              pos._stopBreachCount = 0;
              if (pos._profitBreachCount >= 12) { shouldExit = true; exitReason = 'profit'; }
            } else if (slUsd != null && grossPnl <= -slUsd) {
              pos._stopBreachCount = (pos._stopBreachCount || 0) + 1;
              pos._profitBreachCount = 0;
              if (pos._stopBreachCount >= 3) { shouldExit = true; exitReason = 'stop'; }
            } else {
              pos._stopBreachCount = 0;
              pos._profitBreachCount = 0;
            }
          }
          // maxHoldMs is used only for entry timeout, not exit — positions hold until profit or stop.
        } else {
          // Non-Deribit basis: z-score reversion
          const currentZ = sellStats.zScore;
          const zReverted = pos.direction === 'long' ? currentZ < state.profitTarget : currentZ > -state.profitTarget;
          if (zReverted) { shouldExit = true; exitReason = 'profit'; }
          if (!shouldExit && state.maxHoldMs != null && holdMs >= state.maxHoldMs) {
            shouldExit = true; exitReason = 'timeout';
          }
        }

        if (shouldExit) {
          console.log(`[TradeExecutor] MULTI-BASIS EXIT pair ${pairId} pos=${pos.posId} reason=${exitReason}`);
          pos._exiting = true;
          // Capture dollar spread (futures - perp) at exit trigger using live orderbook mids
          const _obA = orderbooks?.leg1, _obB = orderbooks?.leg2;
          const _midA = _obA ? (parseFloat(_obA.asks?.[0]?.price || 0) + parseFloat(_obA.bids?.[0]?.price || 0)) / 2 : null;
          const _midB = _obB ? (parseFloat(_obB.asks?.[0]?.price || 0) + parseFloat(_obB.bids?.[0]?.price || 0)) / 2 : null;
          pos._exitSpread = (_midA && _midB) ? parseFloat((_midA - _midB).toFixed(4)) : null;
          this._exitMultiBasisPos(state, pos, orderbooks, exitReason).catch(e => {
            console.error(`[TradeExecutor] Multi-basis exit error pair ${pairId}: ${e.message}`);
            pos._exiting = false;
          });
        }
      }

      // 2. Try new entry
      // ── Per-leg qty check ────────────────────────────────────────────
      // Compute currently open (filled) qty on each leg from live positions
      let _legAOpenQty = 0, _legBOpenQty = 0;
      let _legAFillCount = 0, _legBFillCount = 0;
      for (const p of state.openPositions) {
        if (p.posState === 'closed') continue;
        if (p.legAFilled) { _legAOpenQty += (p.qty1 || 0); _legAFillCount++; }
        if (p.legBFilled) { _legBOpenQty += (p.qty2 || 0); _legBFillCount++; }
      }
      // Fully matched positions carry a structural imbalance of (qty1 - qty2) each
      // because the legs are intentionally sized differently for inverse P&L balance.
      // Subtract it so the check only fires on genuinely orphaned legs, not on the
      // normal asymmetric sizing.
      const _structuralImbalance = Math.min(_legAFillCount, _legBFillCount)
        * Math.abs((state.pairConfig?.qty1 || 0) - (state.pairConfig?.qty2 || 0));
      const _netImbalance = Math.max(0, Math.abs(_legAOpenQty - _legBOpenQty) - _structuralImbalance);

      // Net imbalance breach → stop bot immediately (hedge desync)
      if (!state.unilateralMode && state.maxNetQtyImbalance != null && _netImbalance > state.maxNetQtyImbalance) {
        if (!state._qtyLimitTriggered) {
          state._qtyLimitTriggered = true;
          console.error(`[TradeExecutor] NET QTY IMBALANCE pair ${pairId}: legA=${_legAOpenQty} legB=${_legBOpenQty} imbalance=${_netImbalance} > limit=${state.maxNetQtyImbalance} — STOPPING BOT`);
          this.disableTrading(pairId, 'qty_imbalance').catch(() => { });
          StatArbInput.update({ tradingEnabled: false }, { where: { id: pairId } }).catch(() => { });
        }
        return;
      }

      // Leg qty breach → stop bot
      if ((state.maxLegAQty != null && _legAOpenQty > state.maxLegAQty) ||
        (state.maxLegBQty != null && _legBOpenQty > state.maxLegBQty)) {
        if (!state._qtyLimitTriggered) {
          state._qtyLimitTriggered = true;
          console.error(`[TradeExecutor] LEG QTY LIMIT BREACHED pair ${pairId}: legA=${_legAOpenQty}/${state.maxLegAQty ?? '∞'} legB=${_legBOpenQty}/${state.maxLegBQty ?? '∞'} — STOPPING BOT`);
          this.disableTrading(pairId, 'leg_qty_limit').catch(() => { });
          StatArbInput.update({ tradingEnabled: false }, { where: { id: pairId } }).catch(() => { });
        }
        return;
      }

      const openCount = state.openPositions.filter(p => p.posState !== 'closed').length;
      // Bidirectional Deribit grid: allow maxPositions per direction (2× total cap)
      const maxAllowed = (state.isDeribitBasis && state._gridLevels && !state._spreadLevels) ? state.maxPositions * 2 : state.maxPositions;
      const canEnter = openCount < maxAllowed
        && !state._entering
        && state.dailyLoss < state.dailyLossLimit
        && state.dailyProfit < state.dailyProfitLimit
        && !(state.consecutiveLosses >= LOSS_STREAK_THRESHOLD && state.lastLossTime && (Date.now() - state.lastLossTime) < LOSS_STREAK_COOLDOWN_MS)
        && Date.now() - state.lastMultiEntryTime >= COOLDOWN_MS
        && (state.maxLegAQty == null || _legAOpenQty + (state._levelQty1 ? Math.max(...state._levelQty1) : (state.pairConfig.qty1 || 0)) <= state.maxLegAQty)
        && (state.unilateralMode || state.maxLegBQty == null || _legBOpenQty + (state._levelQty2 ? Math.max(...state._levelQty2) : (state.pairConfig.qty2 || 0)) <= state.maxLegBQty);

      if (canEnter) {
        if (state.isDeribitBasis && state._spreadLevels && state._expiryMs) {
          // ── DOLLAR SPREAD CROSSING ENTRY (simulation-compatible) ──────
          // SHORT_BASIS only. Enters when spot basis (futAsk - perpAsk) crosses
          // UP through a fixed dollar level. Z-score used as a gate, not trigger.
          // Uses ask-ask basis to match executable spread (sell fut@ask, buy perp@ask).

          // Warm-up guard: ignore first 30s after enable to avoid stale orderbook crossings
          const WARMUP_MS = 30000;
          if (state.enabledAt && (Date.now() - new Date(state.enabledAt).getTime()) < WARMUP_MS) {
            // Still warming up — skip entry logic but allow _prevBasis to populate
            const ob1 = orderbooks.leg1, ob2 = orderbooks.leg2;
            const _fa = parseFloat(ob1?.asks?.[0]?.price || 0);
            const _pa = parseFloat(ob2?.asks?.[0]?.price || 0);
            if (_fa > 0 && _pa > 0) state._prevBasis = _fa - _pa;
          } else {

          const ob1 = orderbooks.leg1;
          const ob2 = orderbooks.leg2;
          const futAsk = parseFloat(ob1?.asks?.[0]?.price || 0);
          const perpAsk = parseFloat(ob2?.asks?.[0]?.price || 0);
          if (futAsk > 0 && perpAsk > 0) {
            const basis = futAsk - perpAsk;

            // Backwardation guard: skip tick when basis is below the minimum entry level
            if (basis < state._spreadLevels[0]) {
              state._prevBasis = basis;
            } else {

            const currentZ = sellStats.zScore ?? 0;
            const zGate = state.zEntryThreshold ?? 1.0;
            const zMax = state.zEntryMax ?? null;
            const prevBasis = state._prevBasis;
            state._prevBasis = basis;
            if (!state._enteringLevels) state._enteringLevels = new Set();
            const _maxSpreadLevel = state.maxSpreadCap ?? state._spreadLevels[state._spreadLevels.length - 1];
            if (prevBasis !== undefined && currentZ >= zGate && (zMax == null || currentZ <= zMax) && basis <= _maxSpreadLevel) {
              const shortOpenCount = state.openPositions.filter(p => p.posState !== 'closed' && p.direction === 'long').length;
              if (shortOpenCount < state.maxPositions) {
                // One entry per tick — highest crossed level — when basis spikes from
                // $47→$80, enter at $75 (level 2) not $65 (level 1) to capture max spread.
                let _enteredThisTick = false;
                for (let i = state._spreadLevels.length - 1; i >= 0; i--) {
                  if (_enteredThisTick) break;
                  const dollarLevel = state._spreadLevels[i];
                  const levelId = i + 1;
                  if (prevBasis < dollarLevel && basis >= dollarLevel) {
                    const alreadyOpen = state.openPositions.some(
                      p => p.posState !== 'closed' && p.gridLevel === levelId
                    );
                    if (!alreadyOpen && !state._enteringLevels.has(levelId)) {
                      console.log(`[TradeExecutor] SPREAD-CROSS SHORT pair ${pairId} [+${levelId}@$${dollarLevel}] | basis=$${basis.toFixed(2)} prev=$${prevBasis.toFixed(2)} z=${currentZ.toFixed(3)}`);
                      state._enteringLevels.add(levelId);
                      state._entering = true;
                      state.lastMultiEntryTime = Date.now();
                      _enteredThisTick = true;
                      this._enterMultiBasisPos(state, sellStats, orderbooks, 'long', levelId).finally(() => {
                        state._enteringLevels.delete(levelId);
                        if (state._enteringLevels.size === 0) state._entering = false;
                      });
                    }
                  }
                }
              }
            }
            if (!state._lastSpreadLog || Date.now() - state._lastSpreadLog > 30000) {
              state._lastSpreadLog = Date.now();
              const shortPos = state.openPositions.filter(p => p.posState !== 'closed' && p.direction === 'long').length;
              console.log(`[TradeExecutor] SPREAD-GRID pair ${pairId} | basis=$${basis.toFixed(2)} z=${currentZ.toFixed(3)} | open=${shortPos}/${state.maxPositions} | loss=$${state.dailyLoss.toFixed(4)}`);
            }
          } // end backwardation guard
          }
          } // end warmup guard
        } else if (state.isDeribitBasis && state._gridLevels && state._expiryMs) {
          // ── BIDIRECTIONAL GRID ENTRY ──────────────────────────────────
          // +levels (SHORT basis, direction='long'): z-score elevated above threshold
          // -levels (LONG  basis, direction='short'): z-score depressed below threshold
          // One position per level, one entry per COOLDOWN_MS tick.
          const ob1 = orderbooks.leg1;
          const ob2 = orderbooks.leg2;
          const futAsk = parseFloat(ob1?.asks?.[0]?.price || 0);
          const perpBid = parseFloat(ob2?.bids?.[0]?.price || 0);
          if (futAsk > 0 && perpBid > 0) {
            const dteDays = (state._expiryMs - Date.now()) / 86400000;
            const basis = futAsk - perpBid;
            const impliedRate = dteDays > 0 ? (basis / perpBid) * (365 / dteDays) * 100 : 0;
            const currentZ = sellStats.zScore ?? 0;

            // ── TREND FILTER ─────────────────────────────────────────────
            // Block new entries when futures price is moving directionally.
            // Track price over a 5-min rolling window; skip if move > 0.15%.
            const now = Date.now();
            if (!state._priceHistory) state._priceHistory = [];
            state._priceHistory.push({ t: now, p: futAsk });
            state._priceHistory = state._priceHistory.filter(x => now - x.t <= 300000);
            const oldest = state._priceHistory[0];
            const priceMoveAbs = oldest ? Math.abs(futAsk - oldest.p) / oldest.p : 0;
            const TREND_THRESHOLD = 0.0015;
            if (priceMoveAbs >= TREND_THRESHOLD) {
              if (!state._lastTrendLog || now - state._lastTrendLog > 30000) {
                state._lastTrendLog = now;
                console.log(`[TradeExecutor] TREND BLOCK pair ${pairId} | futMove=${(priceMoveAbs * 100).toFixed(3)}% in 5min — skipping grid entry`);
              }
              return;
            }

            // ── REGIME FILTER ─────────────────────────────────────────────
            if (!sellStats.isMeanReverting) {
              if (!state._lastRegimeLog || now - state._lastRegimeLog > 30000) {
                state._lastRegimeLog = now;
                console.log(`[TradeExecutor] REGIME BLOCK pair ${pairId} | regimeScore=${sellStats.regimeScore?.toFixed(3)} — skipping grid entry`);
              }
              return;
            }

            // ── SPREAD MOMENTUM HISTORY ───────────────────────────────────
            // Track basis (dollar spread) for per-direction momentum checks.
            // SHORT: only enter when spread has peaked and declining ≥ $3.
            // LONG:  only enter when spread has troughed and rising ≥ $3.
            if (!state._basisHistory) state._basisHistory = [];
            state._basisHistory.push({ t: now, b: basis });
            state._basisHistory = state._basisHistory.filter(x => now - x.t <= 180000);
            const SPREAD_CHANGE_MIN = 6.0; // Require $6 momentum — filters obvious uptrend entries
            const hasBasisHistory = state._basisHistory.length >= 6;
            const basisPeak = hasBasisHistory ? Math.max(...state._basisHistory.map(x => x.b)) : null;
            const basisTrough = hasBasisHistory ? Math.min(...state._basisHistory.map(x => x.b)) : null;

            if (!state._enteringLevels) state._enteringLevels = new Set();

            // ── SHORT BASIS (+levels): sell futures, buy perp ─────────────
            const shortOpenCount = state.openPositions.filter(p => p.posState !== 'closed' && p.direction === 'long').length;
            const shortMomentumOk = !hasBasisHistory || (basisPeak - basis) >= SPREAD_CHANGE_MIN;
            if (shortOpenCount < state.maxPositions && shortMomentumOk) {
              for (let lvl = state._gridLevels.length - 1; lvl >= 0; lvl--) {
                const levelZ = state._gridLevels[lvl];
                const levelId = lvl + 1;  // +1, +2, +3 ...
                if (currentZ >= levelZ) {
                  const alreadyOpen = state.openPositions.some(
                    p => p.posState !== 'closed' && p.gridLevel === levelId
                  );
                  if (!alreadyOpen && !state._enteringLevels.has(levelId)) {
                    console.log(`[TradeExecutor] SHORT BASIS GRID ENTRY pair ${pairId} [+${levelId}] [${shortOpenCount + 1}/${state.maxPositions}] | z=${currentZ.toFixed(3)} >= ${levelZ.toFixed(2)} rate=${impliedRate.toFixed(3)}%`);
                    state._enteringLevels.add(levelId);
                    state._entering = true;
                    state.lastMultiEntryTime = Date.now();
                    this._enterMultiBasisPos(state, sellStats, orderbooks, 'long', levelId).finally(() => {
                      state._enteringLevels.delete(levelId);
                      if (state._enteringLevels.size === 0) state._entering = false;
                    });
                    break;
                  }
                }
              }
            } else if (hasBasisHistory && !shortMomentumOk) {
              if (!state._lastMomentumLog || now - state._lastMomentumLog > 30000) {
                state._lastMomentumLog = now;
                console.log(`[TradeExecutor] MOMENTUM BLOCK SHORT pair ${pairId} | basis=$${basis.toFixed(2)} peak=$${basisPeak.toFixed(2)} decline=$${(basisPeak - basis).toFixed(2)} < $${SPREAD_CHANGE_MIN}`);
              }
            }

            // ── LONG BASIS (-levels): buy futures, sell perp ──────────────
            // Enters when basis rises >= SPREAD_CHANGE_MIN from its 3-min trough (momentum reversal).
            // Symmetric to SHORT_BASIS which enters when basis falls from its 3-min peak.
            const longOpenCount = state.openPositions.filter(p => p.posState !== 'closed' && p.direction === 'short').length;
            const longMomentumOk = hasBasisHistory && (basis - basisTrough) >= SPREAD_CHANGE_MIN;
            if (longOpenCount < state.maxPositions && longMomentumOk) {
              for (let lvl = state._gridLevels.length - 1; lvl >= 0; lvl--) {
                const levelId = -(lvl + 1);  // -1, -2, -3 ...
                if (true) {  // momentum condition already checked above
                  const alreadyOpen = state.openPositions.some(
                    p => p.posState !== 'closed' && p.gridLevel === levelId
                  );
                  if (!alreadyOpen && !state._enteringLevels.has(levelId)) {
                    console.log(`[TradeExecutor] LONG BASIS GRID ENTRY pair ${pairId} [-${lvl + 1}] [${longOpenCount + 1}/${state.maxPositions}] | z=${currentZ.toFixed(3)} <= -${levelZ.toFixed(2)} rate=${impliedRate.toFixed(3)}%`);
                    state._enteringLevels.add(levelId);
                    state._entering = true;
                    state.lastMultiEntryTime = Date.now();
                    this._enterMultiBasisPos(state, sellStats, orderbooks, 'short', levelId).finally(() => {
                      state._enteringLevels.delete(levelId);
                      if (state._enteringLevels.size === 0) state._entering = false;
                    });
                    break;
                  }
                }
              }
            } else if (hasBasisHistory && !longMomentumOk) {
              if (!state._lastLongMomLog || now - state._lastLongMomLog > 30000) {
                state._lastLongMomLog = now;
                console.log(`[TradeExecutor] MOMENTUM BLOCK LONG pair ${pairId} | basis=$${basis.toFixed(2)} trough=$${basisTrough.toFixed(2)} rise=$${(basis - basisTrough).toFixed(2)} < $${SPREAD_CHANGE_MIN}`);
              }
            }
          }
        } else {
          // ── Z-SCORE ENTRY (non-Deribit or no grid config) ────────────
          const absZ = Math.abs(sellStats.zScore);
          const zMin = state.zEntryThreshold;
          const zMax = state.zEntryMax;
          const inRange = absZ >= zMin && (zMax == null || absZ <= zMax);
          if (inRange && sellStats.isMeanReverting) {
            const entryDir = sellStats.zScore > 0 ? 'long' : 'short';
            const Z_SPACING = 0.3;
            const tooClose = state.openPositions.some(
              p => p.posState !== 'closed' && p.direction === entryDir && Math.abs((p.entryZScore ?? 0) - sellStats.zScore) < Z_SPACING
            );
            if (!tooClose) {
              console.log(`[TradeExecutor] MULTI-BASIS ENTRY pair ${pairId} [${openCount + 1}/${state.maxPositions}] | ${entryDir.toUpperCase()} | z=${sellStats.zScore?.toFixed(3)}`);
              state._entering = true;
              state.lastMultiEntryTime = Date.now();
              this._enterMultiBasisPos(state, sellStats, orderbooks, entryDir, null).finally(() => { state._entering = false; });
            }
          }
        }
      }

      // Periodic status log
      if (!state._lastZLog || Date.now() - state._lastZLog > 5000) {
        state._lastZLog = Date.now();
        if (state.isDeribitBasis && state._expiryMs) {
          const ob1 = orderbooks.leg1; const ob2 = orderbooks.leg2;
          const futAsk = parseFloat(ob1?.asks?.[0]?.price || 0);
          const perpBid = parseFloat(ob2?.bids?.[0]?.price || 0);
          let rateStr = 'N/A';
          if (futAsk > 0 && perpBid > 0) {
            const dteDays = (state._expiryMs - Date.now()) / 86400000;
            if (dteDays > 0) rateStr = (((futAsk - perpBid) / perpBid) * (365 / dteDays) * 100).toFixed(4) + '%';
          }
          const shortPos = state.openPositions.filter(p => p.posState !== 'closed' && p.direction === 'long').length;
          const longPos = state.openPositions.filter(p => p.posState !== 'closed' && p.direction === 'short').length;
          console.log(`[TradeExecutor] MULTI-BASIS pair ${pairId} | rate=${rateStr} z=${(sellStats.zScore ?? 0).toFixed(3)} grid=±[${state._gridLevels?.map((r, i) => (i + 1) + '@' + r.toFixed(2)).join(',')}] | short=${shortPos}/${state.maxPositions} long=${longPos}/${state.maxPositions} | loss=$${state.dailyLoss.toFixed(4)}`);
        } else {
          console.log(`[TradeExecutor] MULTI-BASIS pair ${pairId} | z=${sellStats.zScore?.toFixed(3)} regime=${sellStats.regimeScore?.toFixed(3)} | positions=${openCount}/${state.maxPositions} | loss=$${state.dailyLoss.toFixed(4)}`);
        }
      }
      return;
    }

    // ═══════════════════════════════════════════════════════════════════
    //  ENTRY: spread deviates >= ENTRY_MULT × feeCost
    //  Signal: dev > 0 → CL expensive vs BRENT → BUY BRENT (long)
    //          dev < 0 → CL cheap vs BRENT    → SELL BRENT (short)
    // ═══════════════════════════════════════════════════════════════════
    if (state.state === STATES.IDLE && !state._entering) {

      // Daily loss limit
      if (state.dailyLoss >= state.dailyLossLimit) {
        if (!state._lastDailyLog || Date.now() - state._lastDailyLog > 60000) {
          console.log(`[TradeExecutor] DAILY LOSS LIMIT $${state.dailyLossLimit} reached pair ${pairId} — triggering emergency close`);
          state._lastDailyLog = Date.now();
          // Emergency: reconcile exchange state then cancel all orders and close all positions
          this._emergencyCloseAll(pairId, 'daily_loss_limit').catch(e =>
            console.error(`[TradeExecutor] _emergencyCloseAll failed pair ${pairId}: ${e.message}`)
          );
        }
        return;
      }

      // Daily profit limit
      if (state.dailyProfit >= state.dailyProfitLimit) {
        if (!state._lastProfitLog || Date.now() - state._lastProfitLog > 60000) {
          console.log(`[TradeExecutor] DAILY PROFIT LIMIT $${state.dailyProfitLimit.toFixed(2)} reached pair ${pairId} | profit=$${state.dailyProfit.toFixed(4)}`);
          state._lastProfitLog = Date.now();
        }
        return;
      }

      // Loss streak cooldown
      if (state.consecutiveLosses >= LOSS_STREAK_THRESHOLD && state.lastLossTime) {
        const msSinceLoss = Date.now() - state.lastLossTime;
        if (msSinceLoss < LOSS_STREAK_COOLDOWN_MS) {
          if (!state._lastStreakLog || Date.now() - state._lastStreakLog > 60000) {
            console.log(`[TradeExecutor] LOSS STREAK PAUSE pair ${pairId} | ${state.consecutiveLosses} consecutive SL hits, waiting ${((LOSS_STREAK_COOLDOWN_MS - msSinceLoss) / 1000).toFixed(0)}s`);
            state._lastStreakLog = Date.now();
          }
          return;
        } else {
          state.consecutiveLosses = 0; // reset after cooldown expires
        }
      }

      // Cooldown
      if (state.lastTradeTime && Date.now() - state.lastTradeTime < COOLDOWN_MS) return;

      // Regime filter: for basis pairs only — single-leg pairs (CL/BRENT) skip this check
      // because cold-start slow-mean adaptation causes regimeScore to stay high (2–5) during
      // exactly the period when z-score is elevated (the two are inversely correlated at startup).
      if (state.isBasisPair && !sellStats.isMeanReverting) {
        if (!state._lastRegimeLog || Date.now() - state._lastRegimeLog > 10000) {
          console.log(`[TradeExecutor] SKIP pair ${pairId} | trending regime (regimeScore=${sellStats.regimeScore?.toFixed(3)})`);
          state._lastRegimeLog = Date.now();
        }
        return;
      }

      // All pairs: require minimum |z-score| — per-pair override via DB, else global constant
      const zMin = state.zEntryThreshold;
      if (Math.abs(sellStats.zScore) < zMin) {
        if (!state._lastCostLog || Date.now() - state._lastCostLog > 10000) {
          console.log(`[TradeExecutor] SKIP pair ${pairId} | z=${sellStats.zScore?.toFixed(3)} < ±${zMin}`);
          state._lastCostLog = Date.now();
        }
        return;
      }

      // Entry threshold (fee-coverage check for non-basis, or additional sanity for basis)
      const feeMult = state.isBasisPair ? 2 : 1; // both legs for basis
      const entryThreshold = ENTRY_MULT * feeCost * feeMult;
      if (absDev < entryThreshold) {
        if (!state._lastCostLog || Date.now() - state._lastCostLog > 10000) {
          console.log(`[TradeExecutor] SKIP pair ${pairId} | dev=${absDev.toFixed(6)} < ${entryThreshold.toFixed(6)} (${ENTRY_MULT}×fee)`);
          state._lastCostLog = Date.now();
        }
        return;
      }

      // direction: long = buy legB(perp) [+ sell legA(futures) for basis]
      //            short = sell legB(perp) [+ buy legA(futures) for basis]
      const entryDir = dev > 0 ? 'long' : 'short';
      state.entryFeeCost = feeCost;

      const modeStr = state.isBasisPair ? 'BASIS' : 'SINGLE-LEG';
      console.log(`[TradeExecutor] ENTRY signal pair ${pairId} [${modeStr}] | ${entryDir.toUpperCase()} | z=${sellStats.zScore?.toFixed(3)} dev=${absDev.toFixed(6)} | PT=${state.profitTarget} SL=${state.stopLoss}`);

      state._entering = true;
      this._enterPosition(state, sellStats, orderbooks, entryDir).finally(() => { state._entering = false; });

      // ═══════════════════════════════════════════════════════════════════
      //  EXIT
      //  Basis pairs  → z-score reversion (spread returned to mean) or
      //                 z-score expansion stop (spread keeps diverging)
      //  Single-leg   → dollar P&L on exec leg hits profit target or SL
      // ═══════════════════════════════════════════════════════════════════
    } else if (state.state === STATES.POSITION_OPEN && !state._exiting) {

      const holdMs = Date.now() - (state.entryTime || 0);
      const maxHold = state.isBasisPair ? state.maxHoldMs : MAX_HOLD_MS;
      if (holdMs < MIN_HOLD_MS) return;

      if (state.isBasisPair) {
        // ── Basis exit: interest-rate z-score reversion ────────────────
        const currentZ = sellStats.zScore;
        const entryZ = state.entryZScore || 0;

        const zReverted = state.direction === 'long'
          ? currentZ < state.profitTarget
          : currentZ > -state.profitTarget;

        const zStopped = state.stopLoss != null && (state.direction === 'long'
          ? currentZ > entryZ + state.stopLoss
          : currentZ < entryZ - state.stopLoss);

        // For Deribit basis: compute live unrealised PnL and only exit on actual profit
        let unrealisedPnl = null;
        if (state.isDeribitBasis && state.entryPriceA && state.entryPriceB) {
          const ob1 = orderbooks.leg1;
          const ob2 = orderbooks.leg2;
          // Use maker exit prices (matching _exitPosition logic):
          // BUY futures close → maker at bid; SELL futures close → maker at ask
          const liveA = state.direction === 'long'
            ? parseFloat(ob1?.bids?.[0]?.price || state.entryPriceA)   // BUY futures at maker bid
            : parseFloat(ob1?.asks?.[0]?.price || state.entryPriceA);  // SELL futures at maker ask
          // Perp always taker on exit: BUY at ask, SELL at bid
          const liveB = state.direction === 'long'
            ? parseFloat(ob2?.bids?.[0]?.price || state.entryPriceB)   // SELL perp at taker bid
            : parseFloat(ob2?.asks?.[0]?.price || state.entryPriceB);  // BUY perp at taker ask
          const { totalPnl } = this._calcBasisPnlUsd(state, liveA, liveB);
          // subtract round-trip charges (entry rebate already received; deduct exit charges)
          const minProfit = state._minProfitUsd || 0;
          unrealisedPnl = totalPnl - minProfit;
        }

        if (!state._lastZLog || Date.now() - state._lastZLog > 5000) {
          state._lastZLog = Date.now();
          const pnlStr = unrealisedPnl != null ? ` | net=$${unrealisedPnl.toFixed(4)} target=$${state.profitTarget ?? 0}` : '';
          const stopAtStr = state.stopLoss != null ? `±${(entryZ + state.stopLoss).toFixed(1)}` : 'none';
          console.log(`[TradeExecutor] HOLDING BASIS pair ${pairId} (${state.direction}) | z=${currentZ.toFixed(3)} entryZ=${entryZ.toFixed(3)} | stopAt${stopAtStr} | held ${(holdMs / 1000).toFixed(0)}s${pnlStr}`);
        }

        // Deribit basis: exit purely on USD profit — net PnL >= profitTarget
        if (state.isDeribitBasis) {
          if (unrealisedPnl != null && unrealisedPnl > 0) {
            console.log(`[TradeExecutor] BASIS PROFIT EXIT pair ${pairId} | net=$${unrealisedPnl.toFixed(4)} >= $${state.profitTarget ?? 0} target | z=${currentZ.toFixed(3)}`);
            state._exiting = true;
            this._exitPosition(state, 'profit', orderbooks).finally(() => { state._exiting = false; });
          }
          // timeout exit intentionally removed — hold until profit only
        } else {
          // Non-Deribit basis: z-score reversion exit
          if (zReverted) {
            console.log(`[TradeExecutor] BASIS PROFIT EXIT pair ${pairId} | z=${currentZ.toFixed(3)} reverted past ±${state.profitTarget}`);
            state._exiting = true;
            this._exitPosition(state, 'profit', orderbooks).finally(() => { state._exiting = false; });
          } else if (zStopped) {
            console.log(`[TradeExecutor] BASIS STOP LOSS pair ${pairId} | z=${currentZ.toFixed(3)} expanded ${state.stopLoss}σ beyond entry ${entryZ.toFixed(3)}`);
            state._exiting = true;
            this._exitPosition(state, 'stop', orderbooks).finally(() => { state._exiting = false; });
          }
          // timeout exit intentionally removed — hold until profit or stop only
        }

      } else {
        // ── Single-leg exit: price delta P&L ───────────────────────────
        const brentBid = obBrent?.bids?.[0]?.price ? parseFloat(obBrent.bids[0].price) : null;
        const brentAsk = obBrent?.asks?.[0]?.price ? parseFloat(obBrent.asks[0].price) : null;
        if (!brentBid || !brentAsk) return;

        const priceDelta = state.direction === 'long'
          ? brentBid - state.entryPrice
          : state.entryPrice - brentAsk;
        const unrealizedPnl = this._calcPnlUsd(state, priceDelta, qtyBrent, state.entryPrice);

        if (!state._lastZLog || Date.now() - state._lastZLog > 5000) {
          state._lastZLog = Date.now();
          console.log(`[TradeExecutor] HOLDING pair ${pairId} (${state.direction}) | delta=$${priceDelta.toFixed(4)} pnl=$${unrealizedPnl.toFixed(4)} | PT=$${state.profitTarget} SL=-$${state.stopLoss} | held ${(holdMs / 1000).toFixed(0)}s`);
        }

        if (priceDelta >= state.profitTarget) {
          console.log(`[TradeExecutor] PROFIT TARGET pair ${pairId} | delta=$${priceDelta.toFixed(4)} >= $${state.profitTarget}`);
          state._exiting = true;
          this._exitPosition(state, 'profit', orderbooks).finally(() => { state._exiting = false; });
        } else if (state.stopLoss > 0 && priceDelta <= -state.stopLoss) {
          console.log(`[TradeExecutor] STOP LOSS pair ${pairId} | delta=$${priceDelta.toFixed(4)} <= -$${state.stopLoss}`);
          state._exiting = true;
          this._exitPosition(state, 'stop', orderbooks).finally(() => { state._exiting = false; });
          // timeout exit intentionally removed — exit only on profit or stop
        }
      }
    }
  }

  // ─── PnL HELPER ────────────────────────────────────────────────────
  // Returns USD profit/loss for a price delta on the exec leg.
  // Deribit inverse (BTC/ETH perps/futures): qty = number of $10 USD contracts
  //   pnl = qty * $10 * priceDelta / entryPrice
  // Hyperliquid linear (BRENTOIL, CL etc): qty = units (barrels)
  //   pnl = priceDelta * qty
  _calcPnlUsd(state, priceDelta, qty, entryPrice) {
    if (state.exchangeExec === 'deribit') {
      const CONTRACT_SIZE = 10; // Deribit BTC/ETH contracts = $10 each
      return parseFloat(((qty * CONTRACT_SIZE * priceDelta) / entryPrice).toFixed(6));
    }
    return parseFloat((priceDelta * qty).toFixed(6));
  }

  // ─── MULTI-POSITION BASIS HELPERS ──────────────────────────────────

  async _enterMultiBasisPos(state, stats, orderbooks, direction, gridLevel = null) {
    const { pairId, pairConfig } = state;
    // Use per-level qty when available (proportional to spread level value)
    const _lvlIdx = (gridLevel != null && state._levelQty1) ? gridLevel - 1 : -1;
    const qty1 = (_lvlIdx >= 0 && state._levelQty1?.[_lvlIdx]) ? state._levelQty1[_lvlIdx] : pairConfig.qty1;
    const qty2 = state.unilateralMode ? 0 : ((_lvlIdx >= 0 && state._levelQty2?.[_lvlIdx]) ? state._levelQty2[_lvlIdx] : pairConfig.qty2);
    const ob1 = orderbooks.leg1;
    const ob2 = orderbooks.leg2;

    const legASide = direction === 'long' ? 'sell' : 'buy';
    const legAPriceRaw = direction === 'long' ? ob1?.asks?.[0]?.price : ob1?.bids?.[0]?.price;
    const legAPrice = legAPriceRaw ? parseFloat(legAPriceRaw) : null;
    const legBSide = direction === 'long' ? 'buy' : 'sell';
    const legBPriceRaw = direction === 'long' ? ob2?.asks?.[0]?.price : ob2?.bids?.[0]?.price;
    const legBPrice = legBPriceRaw ? parseFloat(legBPriceRaw) : null;

    if (!legAPrice || !legBPrice) {
      console.log(`[TradeExecutor] Multi-basis entry aborted pair ${pairId} — missing prices`);
      return;
    }

    // Sanity check: executable spread must be positive for short-basis entries
    const execSpread = legAPrice - legBPrice;
    if (direction === 'long' && execSpread <= 0) {
      console.error(`[TradeExecutor] ENTRY BLOCKED pair ${pairId}: executable spread $${execSpread.toFixed(2)} <= 0 (futAsk=${legAPrice} perpAsk=${legBPrice}) — backwardation, aborting`);
      return;
    }

    // Compute per-position min profit threshold:
    // Exit fires when grossPnl >= profitFeeMultiplier × round-trip net fee for this position.
    // profitFeeMultiplier (DB config, default 10): exit only when gross profit is N× the fee cost.
    // profitTarget (DB config, optional): hard USD override — used only when it exceeds the fee-based floor.
    let minProfitUsd = 0;
    if (state.isDeribitBasis) {
      // Fee in USD: qty is USD notional, no CONTRACT_SIZE multiply
      const rebateFut = DERIBIT_MAKER_REBATE * qty1;
      const takerPerp = DERIBIT_TAKER_FEE * qty2;
      const roundTripNet = state.unilateralMode
        ? (-rebateFut * 2) // maker-only both sides → net credit (negative cost)
        : (takerPerp - rebateFut) * 2;
      const multiplier = state.profitFeeMultiplier ?? 10;
      const feeFloor = multiplier * roundTripNet;
      minProfitUsd = (state.profitTarget > 0 && state.profitTarget > feeFloor)
        ? state.profitTarget
        : feeFloor;
      console.log(`[TradeExecutor] minProfitUsd pair ${state.pairId} = $${minProfitUsd.toFixed(4)} (${multiplier}× roundTrip=$${roundTripNet.toFixed(4)} = $${feeFloor.toFixed(4)}, profitTarget=$${(state.profitTarget || 0).toFixed(4)})`);
    }

    const legBIsMarket = state.isDeribitBasis && !state.unilateralMode;

    // ── UNILATERAL: futures (legA) only; perp is signal-only (no legB order).
    if (state.unilateralMode && state.isDeribitBasis) {
      const resultA = await (legASide === 'sell'
        ? this._placeSellOrder(state.exchangeA, state.clientA, state.symbolA, qty1, legAPrice, false, state.typeA)
        : this._placeBuyOrder(state.exchangeA, state.clientA, state.symbolA, qty1, legAPrice, false, state.typeA));

      if (resultA.fillStatus === 'error') {
        console.error(`[TradeExecutor] Unilateral entry: legA rejected pair ${pairId}: ${resultA.errorMsg}`);
        return;
      }

      const trade = await Trade.create({
        pairId,
        side: 'entry',
        legA_exchange: state.exchangeA,
        legA_symbol: state.symbolA,
        legA_side: legASide,
        legA_price: legAPrice,
        legA_qty: qty1,
        legA_orderId: resultA.orderId,
        legA_fillType: 'maker',
        legA_buyVwap: ob1?.buyVwap ?? null,
        legA_sellVwap: ob1?.sellVwap ?? null,
        legB_exchange: state.exchangeExec,
        legB_symbol: pairConfig.symbol2,
        legB_side: legBSide,
        legB_price: legBPrice,
        legB_qty: 0,
        legB_fillType: 'signal',
        legB_buyVwap: ob2?.buyVwap ?? null,
        legB_sellVwap: ob2?.sellVwap ?? null,
        zScoreAtEntry: stats.zScore,
        spreadAtEntry: legAPrice - legBPrice,
        status: 'open',
      });

      const pos = {
        posId: Date.now(),
        tradeId: trade.id,
        direction,
        entryZScore: stats.zScore,
        entryTime: Date.now(),
        _orderPriceA: legAPrice,
        _pendingLegBSide: null,
        _pendingLegBPrice: legBPrice,
        _legBPlaced: false,
        entryPriceA: resultA.fillStatus === 'filled' ? (resultA.filledPrice || legAPrice) : null,
        entryPriceB: null,
        orderIdA: resultA.orderId,
        orderIdB: null,
        closeOrderIdA: null,
        closeOrderIdB: null,
        legAFilled: resultA.fillStatus === 'filled',
        legBFilled: false,
        exitLegAFilled: false,
        exitLegBFilled: false,
        _exitPriceA: null,
        _exitPriceB: null,
        _exitCommA: null,
        _exitCommB: null,
        _exitTradeId: null,
        qty1,
        qty2: 0,
        posState: 'pending',
        entryCommissionA: (resultA.fillStatus === 'filled' && resultA.commission != null)
          ? parseFloat((Math.abs(resultA.commission) * (resultA.filledPrice || legAPrice)).toFixed(6)) : null,
        entryCommissionUsd: null,
        entryTakerFeeUsd: null,
        _minProfitUsd: minProfitUsd,
        _exiting: false,
        _pollTimer: null,
        _pollStart: 0,
        gridLevel,
        entrySpread: legAPrice - legBPrice,
        _unilateral: true,
      };

      BasisPosition.create({
        pairId,
        entryTradeId: trade.id,
        direction,
        gridLevel,
        state: 'pending_entry',
        entrySpread: legAPrice - legBPrice,
        entryZScore: stats.zScore,
        legA_entryPrice: pos.entryPriceA || legAPrice,
        legA_entryQty: qty1,
        legB_entryQty: 0,
        legA_entryOrderId: resultA.orderId,
        entryTime: new Date(),
      }).then(bp => { pos._basisPositionId = bp.id; }).catch(() => { });

      state.openPositions.push(pos);
      console.log(`[TradeExecutor] UNILATERAL entry pair ${pairId} pos=${pos.posId} | ${direction.toUpperCase()} legA ${legASide} @ ${legAPrice} — signal perp@ask ${legBPrice} (no perp order)`);

      if (pos.legAFilled) {
        await this._completeUnilateralEntryFill(state, pos);
        if (pos.legAFilled && pos.legBFilled) {
          const fillSpread = parseFloat((pos.entryPriceA - pos.entryPriceB).toFixed(4));
          pos._fillSpread = fillSpread;
          pos.posState = 'open';
          state.filledQty += qty1;
          await Trade.update({
            legA_price: pos.entryPriceA, legA_filledAt: new Date(),
            legB_price: pos.entryPriceB, legB_filledAt: new Date(),
            commission: pos.entryCommissionUsd ?? null, takerFeeUsd: null, status: 'filled',
          }, { where: { id: trade.id } }).catch(() => { });
          console.log(`[TradeExecutor] UNILATERAL OPEN pair ${pairId} pos=${pos.posId} | legA=${pos.entryPriceA} refPerpAsk=${pos.entryPriceB} | signalSpread=$${pos.entrySpread?.toFixed(2)} fillSpread=$${fillSpread.toFixed(2)}`);
          return;
        }
      }
      this._startMultiBasisPosPoll(state, pos);
      return;
    }

    // ── SEQUENTIAL ENTRY for Deribit basis: place legA (limit futures) first.
    // LegB (market perp) is only placed after legA is confirmed filled.
    // This prevents the same accumulation bug at entry: if legA is cancelled,
    // legB is never placed, so no naked perp position is created.
    if (legBIsMarket) {
      const resultA = await (legASide === 'sell'
        ? this._placeSellOrder(state.exchangeA, state.clientA, state.symbolA, qty1, legAPrice, false, state.typeA)
        : this._placeBuyOrder(state.exchangeA, state.clientA, state.symbolA, qty1, legAPrice, false, state.typeA));

      if (resultA.fillStatus === 'error') {
        console.error(`[TradeExecutor] Multi-basis entry: legA rejected pair ${pairId}: ${resultA.errorMsg}`);
        return;
      }

      const trade = await Trade.create({
        pairId,
        side: 'entry',
        legA_exchange: state.exchangeA,
        legA_symbol: state.symbolA,
        legA_side: legASide,
        legA_price: legAPrice,
        legA_qty: qty1,
        legA_orderId: resultA.orderId,
        legA_fillType: 'maker',
        legA_buyVwap: ob1?.buyVwap ?? null,
        legA_sellVwap: ob1?.sellVwap ?? null,
        legB_exchange: state.exchangeExec,
        legB_symbol: pairConfig.symbol2,
        legB_side: legBSide,
        legB_price: legBPrice,
        legB_qty: qty2,
        legB_fillType: 'taker',
        legB_buyVwap: ob2?.buyVwap ?? null,
        legB_sellVwap: ob2?.sellVwap ?? null,
        zScoreAtEntry: stats.zScore,
        spreadAtEntry: legAPrice - legBPrice,   // dollar spread: futures - perp
        status: 'open',
      });

      const pos = {
        posId: Date.now(),
        tradeId: trade.id,
        direction,
        entryZScore: stats.zScore,
        entryTime: Date.now(),
        _orderPriceA: legAPrice,
        _pendingLegBSide: legBSide,
        _pendingLegBPrice: legBPrice,
        _legBPlaced: false,
        entryPriceA: resultA.fillStatus === 'filled' ? (resultA.filledPrice || legAPrice) : null,
        entryPriceB: null,
        orderIdA: resultA.orderId,
        orderIdB: null,   // not placed yet
        closeOrderIdA: null,
        closeOrderIdB: null,
        legAFilled: resultA.fillStatus === 'filled',
        legBFilled: false,
        exitLegAFilled: false,
        exitLegBFilled: false,
        _exitPriceA: null,
        _exitPriceB: null,
        _exitCommA: null,
        _exitCommB: null,
        _exitTradeId: null,
        _pendingLegBSide: legBSide,
        _pendingLegBPrice: legBPrice,
        _legBPlaced: false,
        qty1,
        qty2,
        posState: 'pending',
        entryCommissionA: (resultA.fillStatus === 'filled' && resultA.commission != null)
          ? parseFloat((Math.abs(resultA.commission) * (resultA.filledPrice || legAPrice)).toFixed(6)) : null,
        entryCommissionUsd: null,
        entryTakerFeeUsd: null,
        _minProfitUsd: minProfitUsd,
        _exiting: false,
        _pollTimer: null,
        _pollStart: 0,
        gridLevel,
        entrySpread: legAPrice - legBPrice,   // dollar spread: futures - perp
      };

      // Persist to basis_positions for reconciliation
      BasisPosition.create({
        pairId,
        entryTradeId: trade.id,
        direction,
        gridLevel,
        state: 'pending_entry',
        entrySpread: legAPrice - legBPrice,
        entryZScore: stats.zScore,
        legA_entryPrice: pos.entryPriceA || legAPrice,
        legA_entryQty: qty1,
        legB_entryQty: qty2,
        legA_entryOrderId: resultA.orderId,
        entryTime: new Date(),
      }).then(bp => { pos._basisPositionId = bp.id; }).catch(() => { });

      state.openPositions.push(pos);
      console.log(`[TradeExecutor] MULTI-BASIS LIMIT (sequential) pair ${pairId} pos=${pos.posId} | ${direction.toUpperCase()} legA ${legASide} @ ${legAPrice} — awaiting fill before legB`);

      if (pos.legAFilled) {
        // LegA filled immediately — place legB now
        await this._placeEntryLegB(state, pos);
        if (pos.legAFilled && pos.legBFilled) {
          const fillSpread = parseFloat((pos.entryPriceA - pos.entryPriceB).toFixed(4));
          pos._fillSpread = fillSpread;
          pos.posState = 'open';
          state.filledQty += qty2;
          await Trade.update({ legA_price: pos.entryPriceA, legA_filledAt: new Date(), legB_price: pos.entryPriceB, legB_filledAt: new Date(), commission: pos.entryCommissionUsd ?? null, takerFeeUsd: pos.entryTakerFeeUsd ?? null, status: 'filled' }, { where: { id: trade.id } }).catch(() => { });
          console.log(`[TradeExecutor] MULTI-BASIS OPEN pair ${pairId} pos=${pos.posId} | ${direction.toUpperCase()} legA=${pos.entryPriceA} legB=${pos.entryPriceB} | signalSpread=$${pos.entrySpread?.toFixed(2)} fillSpread=$${fillSpread.toFixed(2)}`);
          return;
        }
      }
      this._startMultiBasisPosPoll(state, pos);
      return;
    }

    // ── PARALLEL ENTRY for non-Deribit (both legs limit, no market legB risk) ──
    const [resultA, resultB] = await Promise.all([
      legASide === 'sell'
        ? this._placeSellOrder(state.exchangeA, state.clientA, state.symbolA, qty1, legAPrice, false, state.typeA)
        : this._placeBuyOrder(state.exchangeA, state.clientA, state.symbolA, qty1, legAPrice, false, state.typeA),
      legBSide === 'buy'
        ? this._placeBuyOrder(state.exchangeExec, state.clientExec, pairConfig.symbol2, qty2, legBPrice, legBIsMarket, pairConfig.type2)
        : this._placeSellOrder(state.exchangeExec, state.clientExec, pairConfig.symbol2, qty2, legBPrice, legBIsMarket, pairConfig.type2),
    ]);

    if (resultA.fillStatus === 'error' || resultB.fillStatus === 'error') {
      console.error(`[TradeExecutor] Multi-basis entry rejected pair ${pairId}: A=${resultA.errorMsg} B=${resultB.errorMsg}`);
      if (resultA.orderId) await this._cancelOrder(state.exchangeA, state.clientA, resultA.orderId, state.symbolA, state.typeA).catch(() => { });
      if (resultB.orderId) await this._cancelOrder(state.exchangeExec, state.clientExec, resultB.orderId, pairConfig.symbol2, pairConfig.type2).catch(() => { });
      return;
    }

    const trade = await Trade.create({
      pairId,
      side: 'entry',
      legA_exchange: state.exchangeA,
      legA_symbol: state.symbolA,
      legA_side: legASide,
      legA_price: legAPrice,
      legA_qty: qty1,
      legA_orderId: resultA.orderId,
      legA_fillType: resultA.fillStatus === 'filled' ? 'taker' : 'maker',
      legB_exchange: state.exchangeExec,
      legB_symbol: pairConfig.symbol2,
      legB_side: legBSide,
      legB_price: legBPrice,
      legB_qty: qty2,
      legB_orderId: resultB.orderId,
      legB_fillType: legBIsMarket ? 'taker' : 'maker',
      zScoreAtEntry: stats.zScore,
      spreadAtEntry: stats.spread,
      status: 'open',
    });

    const pos = {
      posId: Date.now(),
      tradeId: trade.id,
      direction,
      entryZScore: stats.zScore,
      entryTime: Date.now(),
      _orderPriceA: legAPrice,
      entryPriceA: resultA.fillStatus === 'filled' ? (resultA.filledPrice || legAPrice) : null,
      entryPriceB: resultB.fillStatus === 'filled' ? (resultB.filledPrice || legBPrice) : null,
      orderIdA: resultA.orderId,
      orderIdB: resultB.orderId,
      closeOrderIdA: null,
      closeOrderIdB: null,
      legAFilled: resultA.fillStatus === 'filled',
      legBFilled: resultB.fillStatus === 'filled',
      exitLegAFilled: false,
      exitLegBFilled: false,
      _exitPriceA: null,
      _exitPriceB: null,
      _exitCommA: null,
      _exitCommB: null,
      _exitTradeId: null,
      _legBPlaced: true,
      qty1,
      qty2,
      posState: 'pending',
      entryCommissionA: null,
      entryCommissionUsd: null,
      entryTakerFeeUsd: null,
      _minProfitUsd: minProfitUsd,
      _exiting: false,
      _pollTimer: null,
      _pollStart: 0,
      gridLevel,
    };

    if (pos.legAFilled && pos.legBFilled) {
      pos.posState = 'open';
      state.filledQty += qty2;
      await Trade.update({ legA_filledAt: new Date(), legB_filledAt: new Date(), status: 'filled' }, { where: { id: trade.id } }).catch(() => { });
      console.log(`[TradeExecutor] MULTI-BASIS OPEN pair ${pairId} pos=${pos.posId} | ${direction.toUpperCase()} legA=${pos.entryPriceA} legB=${pos.entryPriceB}`);
    } else {
      this._startMultiBasisPosPoll(state, pos);
    }

    state.openPositions.push(pos);
    console.log(`[TradeExecutor] MULTI-BASIS LIMIT pair ${pairId} pos=${pos.posId} | ${direction.toUpperCase()} legA ${legASide} @ ${legAPrice} | legB ${legBSide} @ ${legBPrice}`);
  }

  _startMultiBasisPosPoll(state, pos) {
    if (pos._pollTimer) clearInterval(pos._pollTimer);
    pos._pollStart = Date.now();
    // For pending entries where legA hasn't filled yet, use a short timeout (10s)
    // to prevent the market from drifting while the post_only futures rests.
    // Once legA fills (waiting for legB), use the normal entry timeout.
    const LEGA_FILL_TIMEOUT = 30000;
    const isWaitingForLegA = pos.posState === 'pending' && !pos.legAFilled;
    const timeoutMs = pos.posState === 'exiting' ? EXIT_POLL_TIMEOUT
      : isWaitingForLegA ? LEGA_FILL_TIMEOUT
      : (state.entryPollTimeoutMs ?? ENTRY_POLL_TIMEOUT);

    pos._pollTimer = setInterval(async () => {
      try {
        // Timeout handling
        if (Date.now() - pos._pollStart > timeoutMs) {
          clearInterval(pos._pollTimer); pos._pollTimer = null;

          if (pos.posState === 'pending') {
            if (pos.legAFilled && !pos.legBFilled) {
              if (state.unilateralMode) {
                await this._completeUnilateralEntryFill(state, pos).catch(() => { });
                if (pos.legAFilled && pos.legBFilled) {
                  clearInterval(pos._pollTimer); pos._pollTimer = null;
                  state.filledQty += pos.qty1;
                  const fillSpread = parseFloat((pos.entryPriceA - pos.entryPriceB).toFixed(4));
                  pos._fillSpread = fillSpread;
                  await Trade.update({
                    legA_price: pos.entryPriceA, legA_filledAt: new Date(),
                    legB_price: pos.entryPriceB, legB_filledAt: new Date(),
                    commission: pos.entryCommissionUsd ?? null, takerFeeUsd: null, status: 'filled',
                  }, { where: { id: pos.tradeId } }).catch(() => { });
                  pos.posState = 'open';
                  console.log(`[TradeExecutor] UNILATERAL OPEN (timeout snap) pair ${state.pairId} pos=${pos.posId} fillSpread=$${fillSpread.toFixed(2)}`);
                } else {
                  this._startMultiBasisPosPoll(state, pos);
                }
                return;
              }
              // LegA filled but legB never placed/confirmed — must place legB now
              console.warn(`[TradeExecutor] Entry timeout: legA filled, legB not — forcing legB market pair ${state.pairId} pos=${pos.posId}`);
              pos._legBPlaced = false;
              pos.orderIdB = null;
              await this._placeEntryLegB(state, pos).catch(() => { });
              if (pos.legAFilled && pos.legBFilled) {
                state.filledQty += pos.qty2;
                const fillSpread = parseFloat((pos.entryPriceA - pos.entryPriceB).toFixed(4));
                pos._fillSpread = fillSpread;
                await Trade.update({ legA_price: pos.entryPriceA, legA_filledAt: new Date(), legB_price: pos.entryPriceB, legB_filledAt: new Date(), commission: pos.entryCommissionUsd ?? null, takerFeeUsd: pos.entryTakerFeeUsd ?? null, status: 'filled' }, { where: { id: pos.tradeId } }).catch(() => { });
                pos.posState = 'open';
                console.log(`[TradeExecutor] MULTI-BASIS OPEN pair ${state.pairId} pos=${pos.posId} | ${pos.direction.toUpperCase()} legA=${pos.entryPriceA} legB=${pos.entryPriceB} | signalSpread=$${pos.entrySpread?.toFixed(2)} fillSpread=$${fillSpread.toFixed(2)}`);
              } else {
                this._startMultiBasisPosPoll(state, pos); // keep polling legB
              }
              return;
            }
            if (!pos.legAFilled && pos.orderIdA) await this._cancelOrder(state.exchangeA, state.clientA, pos.orderIdA, state.symbolA, state.typeA).catch(() => { });
            if (!pos.legBFilled && pos.orderIdB) await this._cancelOrder(state.exchangeExec, state.clientExec, pos.orderIdB, state.pairConfig.symbol2, state.pairConfig.type2).catch(() => { });
            if (pos.tradeId) await Trade.update({ status: 'cancelled' }, { where: { id: pos.tradeId } }).catch(() => { });
            if (pos._basisPositionId) BasisPosition.update({ state: 'failed' }, { where: { id: pos._basisPositionId } }).catch(() => { });
            pos.posState = 'closed';
            state.openPositions = state.openPositions.filter(p => p !== pos);
            console.log(`[TradeExecutor] MULTI-BASIS entry timeout pair ${state.pairId} pos=${pos.posId}`);
          } else if (pos.posState === 'exiting') {
            if (pos.exitLegAFilled && !pos.exitLegBFilled) {
              if (state.unilateralMode) {
                const ob2 = state.lastOrderbooks?.leg2;
                pos._exitPriceB = parseFloat(ob2?.asks?.[0]?.price || pos.entryPriceB);
                pos.exitLegBFilled = true;
                pos._legBPlaced = true;
                await this._finalizeMultiBasisExit(state, pos).catch(() => { });
                return;
              }
              // LegA confirmed filled but legB never completed.
              // MUST NOT reset — futures already closed on exchange.
              // Keep retrying legB at market until it fills.
              console.warn(`[TradeExecutor] Exit timeout: legA filled, legB not — retrying legB market pair ${state.pairId} pos=${pos.posId}`);
              pos._legBPlaced = false; // force retry regardless of previous attempt
              pos.closeOrderIdB = null;
              await this._placeExitLegB(state, pos).catch(() => { });
              if (pos.exitLegAFilled && pos.exitLegBFilled) {
                // Both now done — finalize without restarting poll
                await this._finalizeMultiBasisExit(state, pos).catch(() => { });
              } else {
                // LegB still pending — restart poll timer (timer was cleared above)
                this._startMultiBasisPosPoll(state, pos);
              }
              return;
            }
            // Normal case: legA not yet filled — cancel any pending orders and allow retry
            if (!pos.exitLegAFilled && pos.closeOrderIdA) await this._cancelOrder(state.exchangeA, state.clientA, pos.closeOrderIdA, state.symbolA, state.typeA).catch(() => { });
            if (!pos.exitLegBFilled && pos.closeOrderIdB) await this._cancelOrder(state.exchangeExec, state.clientExec, pos.closeOrderIdB, state.pairConfig.symbol2, state.pairConfig.type2).catch(() => { });
            if (pos._exitTradeId) await Trade.update({ status: 'cancelled' }, { where: { id: pos._exitTradeId } }).catch(() => { });
            if (pos._basisPositionId) {
              BasisPosition.update({
                state: 'open', exitTradeId: null,
                legA_exitPrice: null, legA_exitOrderId: null,
                exitSpread: null, exitReason: null,
              }, { where: { id: pos._basisPositionId } }).catch(() => { });
            }
            pos.posState = 'open'; pos._exiting = false;
            pos.closeOrderIdA = null; pos.closeOrderIdB = null;
            pos.exitLegAFilled = false; pos.exitLegBFilled = false;
            pos._legBPlaced = false; pos._exitTradeId = null;
            pos._exitPriceA = null; pos._exitPriceB = null; pos._exitReason = null;
            console.log(`[TradeExecutor] MULTI-BASIS exit timeout — retry pair ${state.pairId} pos=${pos.posId}`);
          }
          return;
        }

        if (pos.posState === 'pending') {
          // Poll legA
          // ── Poll legA ────────────────────────────────────────────────
          if (pos.orderIdA && !pos.legAFilled) {
            const sA = await this._getOrderStatus(state.exchangeA, state.clientA, pos.orderIdA);
            if (sA.status === 'filled') {
              pos.legAFilled = true;
              pos.entryPriceA = sA.filledPrice || pos._orderPriceA || pos.entryPriceA;
              pos.entryCommissionA = sA.commission != null
                ? parseFloat((Math.abs(sA.commission) * pos.entryPriceA).toFixed(6)) : null;
              // Sequential mode: legA just filled — now place legB (or unilateral snapshot)
              if (state.unilateralMode) {
                if (!pos._legBPlaced) await this._completeUnilateralEntryFill(state, pos);
              } else if (!pos._legBPlaced && pos._pendingLegBSide) {
                await this._placeEntryLegB(state, pos);
              }
            } else if (sA.status === 'cancelled') {
              // LegA cancelled — do NOT place legB (prevents naked perp position)
              clearInterval(pos._pollTimer); pos._pollTimer = null;
              if (pos.tradeId) await Trade.update({ status: 'cancelled' }, { where: { id: pos.tradeId } }).catch(() => { });
              if (pos._basisPositionId) BasisPosition.update({ state: 'failed' }, { where: { id: pos._basisPositionId } }).catch(() => { });
              pos.posState = 'closed';
              state.openPositions = state.openPositions.filter(p => p !== pos);
              console.log(`[TradeExecutor] Sequential entry: legA cancelled, entry aborted — legB NOT placed pair ${state.pairId} pos=${pos.posId}`);
              return;
            }
          }
          // ── Poll legB (once placed) ───────────────────────────────
          if (pos.orderIdB && !pos.legBFilled) {
            const sB = await this._getOrderStatus(state.exchangeExec, state.clientExec, pos.orderIdB);
            if (sB.status === 'filled') {
              pos.legBFilled = true;
              pos.entryPriceB = sB.filledPrice || pos.entryPriceB;
              pos.entryTakerFeeUsd = sB.commission != null
                ? parseFloat((Math.abs(sB.commission) * (pos.entryPriceB || 1)).toFixed(6)) : null;
              pos.entryCommissionUsd = pos.entryCommissionA; // maker rebate only
            } else if (sB.status === 'cancelled') {
              // LegB (market) cancelled — retry immediately (should not happen for IOC, but handle it)
              if (pos.legAFilled) {
                console.warn(`[TradeExecutor] Sequential entry: legB cancelled after legA filled — retrying pair ${state.pairId} pos=${pos.posId}`);
                pos.orderIdB = null;
                pos._legBPlaced = false;
                await this._placeEntryLegB(state, pos);
              } else {
                // Neither leg filled — cancel legA and abort
                if (pos.orderIdA) await this._cancelOrder(state.exchangeA, state.clientA, pos.orderIdA, state.symbolA, state.typeA).catch(() => { });
                clearInterval(pos._pollTimer); pos._pollTimer = null;
                if (pos.tradeId) await Trade.update({ status: 'cancelled' }, { where: { id: pos.tradeId } }).catch(() => { });
                pos.posState = 'closed';
                state.openPositions = state.openPositions.filter(p => p !== pos);
                return;
              }
            }
          }

          if (pos.legAFilled && pos.legBFilled) {
            clearInterval(pos._pollTimer); pos._pollTimer = null;
            state.filledQty += state.unilateralMode ? pos.qty1 : pos.qty2;
            const fillSpread = parseFloat((pos.entryPriceA - pos.entryPriceB).toFixed(4));
            pos._fillSpread = fillSpread;
            await Trade.update({
              legA_price: pos.entryPriceA, legA_filledAt: new Date(),
              legB_price: pos.entryPriceB, legB_filledAt: new Date(),
              commission: pos.entryCommissionUsd ?? null,
              takerFeeUsd: state.unilateralMode ? null : pos.entryTakerFeeUsd ?? null,
              status: 'filled',
            }, { where: { id: pos.tradeId } }).catch(() => { });
            pos.posState = 'open';
            const _tag = state.unilateralMode ? 'UNILATERAL' : 'MULTI-BASIS';
            console.log(`[TradeExecutor] ${_tag} OPEN pair ${state.pairId} pos=${pos.posId} | ${pos.direction.toUpperCase()} legA=${pos.entryPriceA} legB=${pos.entryPriceB} | signalSpread=$${pos.entrySpread?.toFixed(2)} fillSpread=$${fillSpread.toFixed(2)}`);
          }

        } else if (pos.posState === 'exiting') {
          // ── Poll legA ────────────────────────────────────────────────────
          if (pos.closeOrderIdA && !pos.exitLegAFilled) {
            const sA = await this._getOrderStatus(state.exchangeA, state.clientA, pos.closeOrderIdA);
            if (sA.status === 'filled') {
              pos.exitLegAFilled = true;
              pos._exitPriceA = sA.filledPrice || pos._exitPriceA;
              pos._exitCommA = sA.commission;
              if (state.unilateralMode) {
                if (!pos._legBPlaced) {
                  const ob2u = state.lastOrderbooks?.leg2;
                  pos._exitPriceB = parseFloat(ob2u?.asks?.[0]?.price || pos.entryPriceB);
                  pos.exitLegBFilled = true;
                  pos._legBPlaced = true;
                }
              } else if (!pos._legBPlaced && pos._pendingLegBSide) {
                await this._placeExitLegB(state, pos);
              }
            } else if (sA.status === 'cancelled') {
              // LegA cancelled — abort exit without touching legB
              clearInterval(pos._pollTimer); pos._pollTimer = null;
              if (pos._exitTradeId) await Trade.update({ status: 'cancelled' }, { where: { id: pos._exitTradeId } }).catch(() => { });
              if (pos._basisPositionId) {
                BasisPosition.update({
                  state: 'open', exitTradeId: null,
                  legA_exitPrice: null, legA_exitOrderId: null,
                  exitSpread: null, exitReason: null,
                }, { where: { id: pos._basisPositionId } }).catch(() => { });
              }
              pos.posState = 'open';
              pos._exiting = false;
              pos.closeOrderIdA = null;
              pos.closeOrderIdB = null;
              pos.exitLegAFilled = false;
              pos.exitLegBFilled = false;
              pos._legBPlaced = false; pos._exitTradeId = null;
              pos._exitPriceA = null; pos._exitPriceB = null; pos._exitReason = null;
              console.log(`[TradeExecutor] Sequential exit: legA cancelled, aborting — legB NOT placed pair ${state.pairId} pos=${pos.posId}`);
              return;
            }
          }
          // ── Poll legB (once placed) ───────────────────────────────────────
          if (pos.closeOrderIdB && !pos.exitLegBFilled) {
            const sB = await this._getOrderStatus(state.exchangeExec, state.clientExec, pos.closeOrderIdB);
            if (sB.status === 'filled') {
              pos.exitLegBFilled = true;
              pos._exitPriceB = sB.filledPrice || pos._exitPriceB;
              pos._exitCommB = sB.commission;
            } else if (sB.status === 'cancelled') {
              // LegB cancelled after legA already filled — retry legB at market immediately
              if (pos.exitLegAFilled) {
                console.warn(`[TradeExecutor] Sequential exit: legB cancelled after legA filled — retrying market pair ${state.pairId} pos=${pos.posId}`);
                pos.closeOrderIdB = null;
                pos._legBPlaced = false;
                await this._placeExitLegB(state, pos);
              }
            }
          }
          if (pos.exitLegAFilled && pos.exitLegBFilled) {
            clearInterval(pos._pollTimer); pos._pollTimer = null;
            await this._finalizeMultiBasisExit(state, pos);
          }
        }
      } catch (e) {
        console.error(`[TradeExecutor] Multi-basis poll error pair ${state.pairId}: ${e.message}`);
      }
    }, POLL_INTERVAL);
  }

  async _exitMultiBasisPos(state, pos, orderbooks, reason) {
    const { pairId, pairConfig } = state;
    pos._exitReason = reason;
    if (pos._basisPositionId) {
      BasisPosition.update({
        state: 'pending_exit',
        exitReason: reason,
        exitSpread: pos._exitSpread ?? null,
      }, { where: { id: pos._basisPositionId } }).catch(() => { });
    }
    const ob1 = orderbooks.leg1;
    const ob2 = orderbooks.leg2;

    const legACloseSide = pos.direction === 'long' ? 'buy' : 'sell';
    const legAClosePrice = pos.direction === 'long'
      ? parseFloat(ob1?.bids?.[0]?.price || pos.entryPriceA)
      : parseFloat(ob1?.asks?.[0]?.price || pos.entryPriceA);

    const legBCloseSide = pos.direction === 'long' ? 'sell' : 'buy';
    const legBClosePrice = pos.direction === 'long'
      ? parseFloat(ob2?.bids?.[0]?.price || pos.entryPriceB)
      : parseFloat(ob2?.asks?.[0]?.price || pos.entryPriceB);

    const exitLegBIsMarket = state.isDeribitBasis && !state.unilateralMode;

    // ── UNILATERAL EXIT: close futures only; snapshot perp ask for spread / DB.
    if (state.unilateralMode) {
      const resultA = await (legACloseSide === 'buy'
        ? this._placeBuyOrder(state.exchangeA, state.clientA, state.symbolA, pos.qty1, legAClosePrice, false, state.typeA)
        : this._placeSellOrder(state.exchangeA, state.clientA, state.symbolA, pos.qty1, legAClosePrice, false, state.typeA));

      if (resultA.fillStatus === 'error') {
        console.error(`[TradeExecutor] Unilateral exit: legA placement error pair ${pairId} pos=${pos.posId}`);
        pos._exiting = false;
        return;
      }

      const exitTrade = await Trade.create({
        pairId,
        side: 'exit',
        legA_exchange: state.exchangeA,
        legA_symbol: state.symbolA,
        legA_side: legACloseSide,
        legA_price: legAClosePrice,
        legA_qty: pos.qty1,
        legA_orderId: resultA.orderId,
        legA_fillType: 'maker',
        legA_buyVwap: ob1?.buyVwap ?? null,
        legA_sellVwap: ob1?.sellVwap ?? null,
        legB_exchange: state.exchangeExec,
        legB_symbol: pairConfig.symbol2,
        legB_side: legBCloseSide,
        legB_price: parseFloat(ob2?.asks?.[0]?.price || pos.entryPriceB),
        legB_qty: 0,
        legB_fillType: 'signal',
        legB_buyVwap: ob2?.buyVwap ?? null,
        legB_sellVwap: ob2?.sellVwap ?? null,
        zScoreAtEntry: pos.entryZScore,
        spreadAtEntry: pos.entrySpread,
        status: 'open',
      });

      pos.closeOrderIdA = resultA.orderId;
      pos.closeOrderIdB = null;
      pos.exitLegAFilled = resultA.fillStatus === 'filled';
      pos.exitLegBFilled = false;
      pos._exitPriceA = pos.exitLegAFilled ? (resultA.filledPrice || legAClosePrice) : null;
      pos._exitPriceB = null;
      pos._exitCommA = pos.exitLegAFilled ? resultA.commission : null;
      pos._exitCommB = null;
      pos._exitTradeId = exitTrade.id;
      pos._pendingLegBSide = null;
      pos._legBPlaced = false;
      pos.posState = 'exiting';

      if (pos._basisPositionId) {
        BasisPosition.update({
          exitTradeId: exitTrade.id,
          legA_exitOrderId: resultA.orderId,
          legA_exitPrice: legAClosePrice,
          exitSpread: pos._exitSpread ?? null,
        }, { where: { id: pos._basisPositionId } }).catch(() => { });
      }

      if (pos.exitLegAFilled) {
        pos._exitPriceB = parseFloat(ob2?.asks?.[0]?.price || pos.entryPriceB);
        pos.exitLegBFilled = true;
        pos._legBPlaced = true;
        await this._finalizeMultiBasisExit(state, pos);
        return;
      }
      this._startMultiBasisPosPoll(state, pos);
      return;
    }

    // ── SEQUENTIAL EXIT (Deribit basis: legA = limit futures, legB = market perp) ──
    // LegB must NOT be placed until legA is confirmed filled.
    // Placing both in parallel caused the accumulation bug: every time the
    // futures limit was cancelled, the perp market still executed, compounding
    // the long perp exposure with no matching short futures to offset it.
    if (exitLegBIsMarket) {
      const resultA = await (legACloseSide === 'buy'
        ? this._placeBuyOrder(state.exchangeA, state.clientA, state.symbolA, pos.qty1, legAClosePrice, false, state.typeA)
        : this._placeSellOrder(state.exchangeA, state.clientA, state.symbolA, pos.qty1, legAClosePrice, false, state.typeA));

      if (resultA.fillStatus === 'error') {
        console.error(`[TradeExecutor] Sequential exit: legA placement error pair ${pairId} pos=${pos.posId}`);
        pos._exiting = false; return;
      }

      const exitTrade = await Trade.create({
        pairId,
        side: 'exit',
        legA_exchange: state.exchangeA,
        legA_symbol: state.symbolA,
        legA_side: legACloseSide,
        legA_price: legAClosePrice,
        legA_qty: pos.qty1,
        legA_orderId: resultA.orderId,
        legA_fillType: 'maker',
        legA_buyVwap: ob1?.buyVwap ?? null,
        legA_sellVwap: ob1?.sellVwap ?? null,
        legB_exchange: state.exchangeExec,
        legB_symbol: pairConfig.symbol2,
        legB_side: legBCloseSide,
        legB_price: legBClosePrice,
        legB_qty: pos.qty2,
        legB_fillType: 'taker',
        legB_buyVwap: ob2?.buyVwap ?? null,
        legB_sellVwap: ob2?.sellVwap ?? null,
        zScoreAtEntry: pos.entryZScore,
        spreadAtEntry: pos.entrySpread,
        status: 'open',
      });

      pos.closeOrderIdA = resultA.orderId;
      pos.closeOrderIdB = null;        // not placed yet
      pos.exitLegAFilled = resultA.fillStatus === 'filled';
      pos.exitLegBFilled = false;       // not placed yet
      pos._exitPriceA = pos.exitLegAFilled ? (resultA.filledPrice || legAClosePrice) : null;
      pos._exitPriceB = null;
      pos._exitCommA = pos.exitLegAFilled ? resultA.commission : null;
      pos._exitCommB = null;
      pos._exitTradeId = exitTrade.id;
      // Store legB params so poll can place it once legA confirms
      pos._pendingLegBSide = legBCloseSide;
      pos._pendingLegBPrice = legBClosePrice;
      pos._legBPlaced = false;
      pos.posState = 'exiting';

      // Link exit trade to BasisPosition
      if (pos._basisPositionId) {
        BasisPosition.update({
          exitTradeId: exitTrade.id,
          legA_exitOrderId: resultA.orderId,
          legA_exitPrice: legAClosePrice,
          exitSpread: pos._exitSpread ?? null,
        }, { where: { id: pos._basisPositionId } }).catch(() => { });
      }

      if (pos.exitLegAFilled) {
        // LegA filled immediately (market order case) — place legB now
        await this._placeExitLegB(state, pos);
        if (pos.exitLegAFilled && pos.exitLegBFilled) {
          await this._finalizeMultiBasisExit(state, pos);
          return;
        }
      }
      this._startMultiBasisPosPoll(state, pos);
      return;
    }

    // ── PARALLEL EXIT (both legs limit, non-Deribit basis) ────────────────────
    const [resultA, resultB] = await Promise.all([
      legACloseSide === 'buy'
        ? this._placeBuyOrder(state.exchangeA, state.clientA, state.symbolA, pos.qty1, legAClosePrice, false, state.typeA)
        : this._placeSellOrder(state.exchangeA, state.clientA, state.symbolA, pos.qty1, legAClosePrice, false, state.typeA),
      legBCloseSide === 'buy'
        ? this._placeBuyOrder(state.exchangeExec, state.clientExec, pairConfig.symbol2, pos.qty2, legBClosePrice, exitLegBIsMarket, pairConfig.type2)
        : this._placeSellOrder(state.exchangeExec, state.clientExec, pairConfig.symbol2, pos.qty2, legBClosePrice, exitLegBIsMarket, pairConfig.type2),
    ]);

    if (resultA.fillStatus === 'error' || resultB.fillStatus === 'error') {
      console.error(`[TradeExecutor] Multi-basis exit rejected pair ${pairId} pos=${pos.posId}`);
      pos._exiting = false; return;
    }

    const exitTrade = await Trade.create({
      pairId,
      side: 'exit',
      legA_exchange: state.exchangeA,
      legA_symbol: state.symbolA,
      legA_side: legACloseSide,
      legA_price: legAClosePrice,
      legA_qty: pos.qty1,
      legA_orderId: resultA.orderId,
      legA_fillType: resultA.fillStatus === 'filled' ? 'taker' : 'maker',
      legA_buyVwap: ob1?.buyVwap ?? null,
      legA_sellVwap: ob1?.sellVwap ?? null,
      legB_exchange: state.exchangeExec,
      legB_symbol: pairConfig.symbol2,
      legB_side: legBCloseSide,
      legB_price: legBClosePrice,
      legB_qty: pos.qty2,
      legB_orderId: resultB.orderId,
      legB_fillType: exitLegBIsMarket ? 'taker' : 'maker',
      legB_buyVwap: ob2?.buyVwap ?? null,
      legB_sellVwap: ob2?.sellVwap ?? null,
      zScoreAtEntry: pos.entryZScore,
      spreadAtEntry: pos.entrySpread,
      status: 'open',
    });

    pos.closeOrderIdA = resultA.orderId;
    pos.closeOrderIdB = resultB.orderId;
    pos.exitLegAFilled = resultA.fillStatus === 'filled';
    pos.exitLegBFilled = resultB.fillStatus === 'filled';
    pos._exitPriceA = pos.exitLegAFilled ? (resultA.filledPrice || legAClosePrice) : null;
    pos._exitPriceB = pos.exitLegBFilled ? (resultB.filledPrice || legBClosePrice) : null;
    pos._exitCommA = pos.exitLegAFilled ? resultA.commission : null;
    pos._exitCommB = pos.exitLegBFilled ? resultB.commission : null;
    pos._exitTradeId = exitTrade.id;
    pos._legBPlaced = true;
    pos.posState = 'exiting';

    if (pos.exitLegAFilled && pos.exitLegBFilled) {
      await this._finalizeMultiBasisExit(state, pos);
    } else {
      this._startMultiBasisPosPoll(state, pos);
    }
  }

  /** Perp is signal-only: record perp ask at fill time for spread / exit logic (no perp order). */
  async _completeUnilateralEntryFill(state, pos) {
    const { pairId } = state;
    pos._legBPlaced = true;
    const ob2 = state.lastOrderbooks?.leg2;
    const perpAsk = parseFloat(ob2?.asks?.[0]?.price || pos._pendingLegBPrice || 0);
    if (!perpAsk) {
      console.error(`[TradeExecutor] UNILATERAL: missing perp ask — cannot snapshot spread pair ${pairId} pos=${pos.posId}`);
      pos._legBPlaced = false;
      return;
    }
    pos.legBFilled = true;
    pos.entryPriceB = perpAsk;
    pos.orderIdB = null;
    pos.entryTakerFeeUsd = null;
    pos.entryCommissionUsd = pos.entryCommissionA;
    const fillSpread = parseFloat((pos.entryPriceA - perpAsk).toFixed(4));
    pos._fillSpread = fillSpread;
    if (pos.tradeId) {
      await Trade.update({
        legB_price: perpAsk,
        legB_qty: 0,
        legB_fillType: 'signal',
        legB_filledAt: new Date(),
      }, { where: { id: pos.tradeId } }).catch(() => { });
    }
    if (pos._basisPositionId) {
      BasisPosition.update({
        state: 'open',
        legB_entryPrice: perpAsk,
        legB_entryQty: 0,
        legB_entryOrderId: null,
      }, { where: { id: pos._basisPositionId } }).catch(() => { });
    }
    console.log(`[TradeExecutor] UNILATERAL entry snap pair ${pairId} pos=${pos.posId} | refPerpAsk=${perpAsk} fillSpread=$${fillSpread.toFixed(2)}`);
  }

  // Place legB of a sequential ENTRY after legA (futures limit) confirms filled.
  async _placeEntryLegB(state, pos) {
    const { pairId, pairConfig } = state;
    const ob2 = state.lastOrderbooks?.leg2;

    // Determine the minimum spread level for this position's grid level
    const minSpreadForLevel = (state._spreadLevels && pos.gridLevel)
      ? state._spreadLevels[pos.gridLevel - 1] || state._spreadLevels[0]
      : state._spreadLevels?.[0] || 0;

    // Use fresh orderbook price for market order
    let legBPrice = pos._pendingLegBPrice;
    if (ob2) {
      const freshPrice = pos._pendingLegBSide === 'buy'
        ? parseFloat(ob2?.asks?.[0]?.price || 0)
        : parseFloat(ob2?.bids?.[0]?.price || 0);
      if (freshPrice > 0) legBPrice = freshPrice;
    }

    // POST-FILL SPREAD VALIDATION — abort + unwind if executable spread collapsed
    if (state.isDeribitBasis && pos.entryPriceA && ob2) {
      const currentPerpAsk = parseFloat(ob2?.asks?.[0]?.price || 0);
      if (currentPerpAsk > 0) {
        const execSpread = pos.entryPriceA - currentPerpAsk;
        const minRequired = minSpreadForLevel * 0.5;
        if (execSpread < minRequired) {
          console.error(`[TradeExecutor] SPREAD COLLAPSED pair ${pairId} pos=${pos.posId}: execSpread=$${execSpread.toFixed(2)} < 50% of $${minSpreadForLevel} ($${minRequired.toFixed(2)}) — unwinding legA`);
          const unwindSide = pos._pendingLegBSide === 'buy' ? 'buy' : 'sell';
          try {
            if (unwindSide === 'buy') {
              await this._placeBuyOrder(state.exchangeA, state.clientA, state.symbolA, pos.qty1, pos.entryPriceA, true, state.typeA);
            } else {
              await this._placeSellOrder(state.exchangeA, state.clientA, state.symbolA, pos.qty1, pos.entryPriceA, true, state.typeA);
            }
            console.log(`[TradeExecutor] Unwound legA (${unwindSide} ${pos.qty1} futures at market) pair ${pairId} pos=${pos.posId}`);
          } catch (e) {
            console.error(`[TradeExecutor] UNWIND FAILED pair ${pairId}: ${e.message} — MANUAL CLOSE NEEDED`);
          }
          if (pos.tradeId) await Trade.update({ status: 'cancelled' }, { where: { id: pos.tradeId } }).catch(() => {});
          if (pos._basisPositionId) BasisPosition.update({ state: 'failed' }, { where: { id: pos._basisPositionId } }).catch(() => {});
          pos.posState = 'closed';
          state.openPositions = state.openPositions.filter(p => p !== pos);
          if (pos._pollTimer) { clearInterval(pos._pollTimer); pos._pollTimer = null; }
          return;
        }
        console.log(`[TradeExecutor] Spread validation OK: execSpread=$${execSpread.toFixed(2)} >= $${minRequired.toFixed(2)} (50% of $${minSpreadForLevel})`);
      }
    }

    console.log(`[TradeExecutor] Sequential entry: placing legB (market) pair ${pairId} pos=${pos.posId} side=${pos._pendingLegBSide} price=${legBPrice} qty=${pos.qty2} execSpread=$${pos.entryPriceA ? (pos.entryPriceA - legBPrice).toFixed(2) : '?'}`);

    pos._legBPlaced = true; // set BEFORE await to prevent duplicate placement from concurrent poll ticks

    const resultB = await (pos._pendingLegBSide === 'buy'
      ? this._placeBuyOrder(state.exchangeExec, state.clientExec, pairConfig.symbol2, pos.qty2, legBPrice, true, pairConfig.type2)
      : this._placeSellOrder(state.exchangeExec, state.clientExec, pairConfig.symbol2, pos.qty2, legBPrice, true, pairConfig.type2));

    if (resultB.fillStatus === 'error') {
      console.error(`[TradeExecutor] Sequential entry: legB placement error pair ${pairId} pos=${pos.posId} — will retry`);
      pos._legBPlaced = false;
      return;
    }
    pos.orderIdB   = resultB.orderId;
    pos.legBFilled = resultB.fillStatus === 'filled';
    pos.entryPriceB = resultB.filledPrice || legBPrice;
    pos.entryTakerFeeUsd = resultB.commission != null
      ? (state.exchangeExec === 'deribit'
          ? parseFloat((Math.abs(resultB.commission) * pos.entryPriceB).toFixed(6))
          : parseFloat(Math.abs(resultB.commission).toFixed(6)))
      : null;
    pos.entryCommissionUsd = pos.entryCommissionA; // maker rebate only
    if (pos.tradeId) {
      await Trade.update({ legB_orderId: resultB.orderId, legB_price: legBPrice }, { where: { id: pos.tradeId } }).catch(() => {});
    }
    // Update BasisPosition: legB order ID and price now known
    if (pos._basisPositionId) {
      const bpUpdate = { legB_entryOrderId: resultB.orderId, legB_entryPrice: pos.entryPriceB, legB_entryQty: pos.qty2 };
      if (pos.legBFilled) bpUpdate.state = 'open';
      BasisPosition.update(bpUpdate, { where: { id: pos._basisPositionId } }).catch(() => {});
    }
    console.log(`[TradeExecutor] Sequential entry: legB placed pair ${pairId} pos=${pos.posId} orderId=${resultB.orderId} filled=${pos.legBFilled} price=${legBPrice}`);
  }

  // Place legB of a sequential exit after legA has confirmed filled.
  // Always uses the current live orderbook price — NOT the stale snapshot
  // from when the exit was initiated. This is critical because legA (limit)
  // can take seconds to fill while the market moves.
  async _placeExitLegB(state, pos) {
    const { pairId, pairConfig } = state;

    // Refresh price from live orderbook; fall back to stored snapshot only if unavailable
    const ob2 = state.lastOrderbooks?.leg2;
    let legBPrice = pos._pendingLegBPrice; // stale fallback
    if (ob2) {
      const freshPrice = pos._pendingLegBSide === 'sell'
        ? parseFloat(ob2?.bids?.[0]?.price || 0)
        : parseFloat(ob2?.asks?.[0]?.price || 0);
      if (freshPrice > 0) legBPrice = freshPrice;
    }

    console.log(`[TradeExecutor] Sequential exit: placing legB (market) pair ${pairId} pos=${pos.posId} side=${pos._pendingLegBSide} price=${legBPrice} qty=${pos.qty2}`);

    pos._legBPlaced = true; // set BEFORE await to prevent duplicate placement from concurrent poll ticks

    const resultB = await (pos._pendingLegBSide === 'buy'
      ? this._placeBuyOrder(state.exchangeExec, state.clientExec, pairConfig.symbol2, pos.qty2, legBPrice, true, pairConfig.type2)
      : this._placeSellOrder(state.exchangeExec, state.clientExec, pairConfig.symbol2, pos.qty2, legBPrice, true, pairConfig.type2));

    if (resultB.fillStatus === 'error') {
      console.error(`[TradeExecutor] Sequential exit: legB placement error pair ${pairId} pos=${pos.posId} — will retry`);
      pos._legBPlaced = false; // allow poll to retry on next tick
      return;
    }
    pos.closeOrderIdB = resultB.orderId;
    pos.exitLegBFilled = resultB.fillStatus === 'filled';
    pos._exitPriceB = resultB.filledPrice || legBPrice;
    pos._exitCommB = resultB.commission;
    if (pos._exitTradeId) {
      await Trade.update({ legB_orderId: resultB.orderId, legB_price: legBPrice }, { where: { id: pos._exitTradeId } }).catch(() => { });
    }
    console.log(`[TradeExecutor] Sequential exit: legB placed pair ${pairId} pos=${pos.posId} orderId=${resultB.orderId} filled=${pos.exitLegBFilled} price=${legBPrice}`);
  }

  async _finalizeMultiBasisExit(state, pos) {
    const { pairId } = state;
    const exitPriceA = pos._exitPriceA || pos.entryPriceA;
    const exitPriceB = pos._exitPriceB != null ? pos._exitPriceB : pos.entryPriceB;

    // Deribit inverse PnL: PnL = size × (1/entry − 1/exit)
    // direction='long' → legA SHORT, legB LONG
    const pnlA = pos.direction === 'long'
      ? parseFloat((pos.qty1 * (1 / exitPriceA - 1 / pos.entryPriceA)).toFixed(8))
      : parseFloat((pos.qty1 * (1 / pos.entryPriceA - 1 / exitPriceA)).toFixed(8));
    const pnlB = (!pos.qty2 || state.unilateralMode)
      ? 0
      : (pos.direction === 'long'
        ? parseFloat((pos.qty2 * (1 / pos.entryPriceB - 1 / exitPriceB)).toFixed(8))
        : parseFloat((pos.qty2 * (1 / exitPriceB - 1 / pos.entryPriceB)).toFixed(8)));
    const totalPnl_btc = parseFloat((pnlA + pnlB).toFixed(8));
    // Convert to USD-equivalent for DB storage and daily loss tracking
    const _exitRef = exitPriceA || pos.entryPriceA;
    const totalPnl = parseFloat((totalPnl_btc * _exitRef).toFixed(6));
    const pnlA_usd = parseFloat((pnlA * _exitRef).toFixed(6));
    const pnlB_usd = parseFloat((pnlB * _exitRef).toFixed(6));

    // Commissions — Deribit BTC fee: negative = maker rebate, positive = taker fee
    const exitMakerRebateUsd = pos._exitCommA != null
      ? parseFloat((Math.abs(pos._exitCommA) * exitPriceA).toFixed(6)) : null;
    const exitTakerFeeUsd = pos._exitCommB != null
      ? parseFloat((Math.abs(pos._exitCommB) * exitPriceB).toFixed(6)) : null;
    const entryMakerRebate = pos.entryCommissionUsd != null ? Math.abs(pos.entryCommissionUsd) : 0;
    const entryTakerFee = pos.entryTakerFeeUsd != null ? pos.entryTakerFeeUsd : 0;
    const totalMakerRebate = parseFloat((entryMakerRebate + (exitMakerRebateUsd ?? 0)).toFixed(6));
    const totalTakerFee = parseFloat((entryTakerFee + (exitTakerFeeUsd ?? 0)).toFixed(6));
    const pnl = parseFloat((totalPnl + totalMakerRebate - totalTakerFee).toFixed(6));

    if (pnl < 0) {
      state.dailyLoss = parseFloat((state.dailyLoss + Math.abs(pnl)).toFixed(6));
      if (pos._exitReason === 'stop') { state.consecutiveLosses++; state.lastLossTime = Date.now(); }
    } else {
      state.dailyProfit = parseFloat((state.dailyProfit + pnl).toFixed(6));
      state.consecutiveLosses = 0;
    }
    state.lastTradeTime = Date.now();

    // Dollar spread at exit from actual fill prices (futures exit - perp exit)
    const dollarSpreadAtExit = parseFloat((exitPriceA - exitPriceB).toFixed(4));

    if (pos._exitTradeId) {
      await Trade.update({
        legA_price: exitPriceA, legA_filledAt: new Date(), legA_pnl: pnlA_usd,
        legB_price: exitPriceB, legB_filledAt: new Date(), legB_pnl: pnlB_usd,
        status: 'filled', pnl,
        commission: exitMakerRebateUsd ?? null,
        takerFeeUsd: exitTakerFeeUsd ?? null,
        spreadAtExit: dollarSpreadAtExit,
      }, { where: { id: pos._exitTradeId } }).catch(() => { });
    }

    // Close the BasisPosition record with full P&L and spread data
    if (pos._basisPositionId) {
      const exitTime = new Date();
      const holdMs = pos.entryTime ? (exitTime.getTime() - pos.entryTime) : null;
      const spreadChange = pos.entrySpread != null
        ? parseFloat((dollarSpreadAtExit - pos.entrySpread).toFixed(4))
        : null;
      BasisPosition.update({
        state: 'closed',
        exitSpread: dollarSpreadAtExit,
        exitReason: pos._exitReason ?? null,
        legA_exitPrice: exitPriceA,
        legB_exitPrice: exitPriceB,
        legB_exitOrderId: pos.closeOrderIdB ?? null,
        exitTime,
        holdMs,
        spreadChange,
        legA_pnl: pnlA_usd,
        legB_pnl: pnlB_usd,
        grossPnl: totalPnl,
        commission: totalMakerRebate || null,
        takerFeeUsd: totalTakerFee || null,
        netPnl: pnl,
      }, { where: { id: pos._basisPositionId } }).catch(() => { });
    }

    console.log(`[TradeExecutor] MULTI-BASIS CLOSED pair ${pairId} pos=${pos.posId} | ${pos.direction} | legA entry=${pos.entryPriceA} exit=${exitPriceA} | legB entry=${pos.entryPriceB} exit=${exitPriceB} | grossBTC=${totalPnl_btc.toFixed(8)} grossUSD=$${totalPnl.toFixed(4)} net=$${pnl.toFixed(4)} | dailyLoss=$${state.dailyLoss.toFixed(4)}`);
    pos.posState = 'closed';
    state.openPositions = state.openPositions.filter(p => p !== pos);
    this._broadcastState(pairId);
  }

  // ─── MULTI-POSITION HELPERS (single-leg only) ──────────────────────

  async _enterMultiPos(state, stats, orderbooks, direction) {
    const { pairId, pairConfig } = state;
    const symbolB = pairConfig.symbol2;
    const qty2 = pairConfig.qty2;
    const type2 = pairConfig.type2;
    const obPerp = orderbooks.leg2;

    let entryPrice, side;
    if (direction === 'long') {
      const bestBid = obPerp?.bids?.[0]?.price ? parseFloat(obPerp.bids[0].price) : null;
      if (!bestBid) return;
      entryPrice = bestBid; side = 'buy';
    } else {
      const bestAsk = obPerp?.asks?.[0]?.price ? parseFloat(obPerp.asks[0].price) : null;
      if (!bestAsk) return;
      entryPrice = bestAsk; side = 'sell';
    }

    const result = direction === 'long'
      ? await this._placeBuyOrder(state.exchangeExec, state.clientExec, symbolB, qty2, entryPrice, false, type2)
      : await this._placeSellOrder(state.exchangeExec, state.clientExec, symbolB, qty2, entryPrice, false, type2);

    const { orderId, fillStatus, errorMsg } = result;
    if (fillStatus === 'error' || !orderId) {
      console.error(`[TradeExecutor] Multi-pos entry rejected pair ${pairId}: ${errorMsg || 'no orderId'}`);
      return;
    }

    const trade = await Trade.create({
      pairId,
      side: 'entry',
      legA_exchange: state.exchangeExec,
      legA_symbol: symbolB,
      legA_side: side,
      legA_price: entryPrice,
      legA_qty: qty2,
      legA_orderId: orderId,
      legA_fillType: fillStatus === 'filled' ? 'taker' : 'maker',
      zScoreAtEntry: stats.zScore,
      spreadAtEntry: stats.spread,
      legB_exchange: null, legB_symbol: null, legB_side: null,
      status: 'open',
    });

    const pos = {
      posId: Date.now(),
      tradeId: trade.id,
      direction,
      entryPrice: null,
      entryZScore: stats.zScore,
      entryTime: Date.now(),
      qty: qty2,
      clHedgeQty: 0,
      clEntryPrice: null,
      orderId,
      exitOrderId: null,
      posState: 'pending',
      entryCommissionUsd: null,
      _orderPrice: entryPrice,
      _exitOrderPrice: null,
      _exitStartTime: null,
      _exiting: false,
      _pollTimer: null,
      _pollStart: 0,
    };
    state.openPositions.push(pos);

    console.log(`[TradeExecutor] MULTI-POS LIMIT pair ${pairId} | ${direction.toUpperCase()} ${symbolB} @ ${entryPrice} orderId=${orderId}`);
    this._startMultiPosPoll(state, pos, ENTRY_POLL_TIMEOUT);
  }

  _startMultiPosPoll(state, pos, timeoutMs) {
    if (pos._pollTimer) clearInterval(pos._pollTimer);
    pos._pollStart = Date.now();
    pos._pollTimer = setInterval(async () => {
      try {
        const orderId = pos.posState === 'pending' ? pos.orderId : pos.exitOrderId;
        if (!orderId) return;

        // Timeout
        if (Date.now() - pos._pollStart > timeoutMs) {
          clearInterval(pos._pollTimer); pos._pollTimer = null;
          if (pos.posState === 'pending') {
            await this._cancelOrder(state.exchangeExec, state.clientExec, pos.orderId, state.pairConfig.symbol2, state.pairConfig.type2).catch(() => { });
            if (pos.tradeId) await Trade.update({ status: 'cancelled' }, { where: { id: pos.tradeId } }).catch(() => { });
            pos.posState = 'closed';
            state.openPositions = state.openPositions.filter(p => p !== pos);
            console.log(`[TradeExecutor] MULTI-POS entry timeout pair ${state.pairId} pos=${pos.posId}`);
          } else if (pos.posState === 'exiting') {
            await this._cancelOrder(state.exchangeExec, state.clientExec, pos.exitOrderId, state.pairConfig.symbol2, state.pairConfig.type2).catch(() => { });
            pos.posState = 'open'; pos._exiting = false; pos.exitOrderId = null;
            console.log(`[TradeExecutor] MULTI-POS exit timeout — retry pair ${state.pairId} pos=${pos.posId}`);
          }
          return;
        }

        const { status, filledPrice, filledSz, commission } = await this._getOrderStatus(state.exchangeExec, state.clientExec, orderId);

        if (status === 'filled') {
          clearInterval(pos._pollTimer); pos._pollTimer = null;
          const price = filledPrice || (pos.posState === 'pending' ? pos._orderPrice : pos._exitOrderPrice);

          if (pos.posState === 'pending') {
            const actualQty = filledSz > 0 ? filledSz : pos.qty;
            pos.entryPrice = price;
            pos.qty = actualQty;
            pos.entryCommissionUsd = commission != null ? parseFloat(commission.toFixed(6)) : null;
            state.filledQty += actualQty;
            await Trade.update({ legA_price: price, legA_qty: actualQty, legA_filledAt: new Date(), commission: pos.entryCommissionUsd, status: 'filled' }, { where: { id: pos.tradeId } });
            pos.posState = 'open';
            console.log(`[TradeExecutor] MULTI-POS OPEN pair ${state.pairId} pos=${pos.posId} | ${pos.direction.toUpperCase()} @ ${price} qty=${actualQty}`);
            // Place CL hedge
            if (state.pairConfig.symbol1) {
              await this._placeMultiClHedge(state, pos).catch(e => console.error(`[TradeExecutor] Multi CL hedge error: ${e.message}`));
            }

          } else if (pos.posState === 'exiting') {
            await this._finalizeMultiExit(state, pos, price, commission);
          }

        } else if (status === 'cancelled') {
          clearInterval(pos._pollTimer); pos._pollTimer = null;
          if (pos.posState === 'pending') {
            if (pos.tradeId) await Trade.update({ status: 'cancelled' }, { where: { id: pos.tradeId } }).catch(() => { });
            pos.posState = 'closed';
            state.openPositions = state.openPositions.filter(p => p !== pos);
          } else if (pos.posState === 'exiting') {
            pos.posState = 'open'; pos._exiting = false; pos.exitOrderId = null;
          }
        }
      } catch (e) {
        console.error(`[TradeExecutor] Multi-pos poll error pair ${state.pairId}: ${e.message}`);
      }
    }, POLL_INTERVAL);
  }

  async _placeMultiClHedge(state, pos) {
    const clSymbol = state.pairConfig.symbol1;
    const clType = state.pairConfig.type1;
    if (!clSymbol || !state.pairConfig.exchange1) return;
    const clQty = parseFloat((pos.qty * CL_HEDGE_RATIO).toFixed(4));
    if (clQty <= 0) return;
    const clSide = pos.direction === 'long' ? 'sell' : 'buy';
    const obCL = state.lastOrderbooks?.leg1;
    const clPrice = clSide === 'sell'
      ? parseFloat(obCL?.bids?.[0]?.price || 0)
      : parseFloat(obCL?.asks?.[0]?.price || 0);
    if (clPrice <= 0) { console.warn(`[TradeExecutor] Multi CL hedge skipped — no price`); return; }
    const clResult = clSide === 'sell'
      ? await this._placeSellOrder(state.exchangeExec, state.clientExec, clSymbol, clQty, clPrice, true, clType)
      : await this._placeBuyOrder(state.exchangeExec, state.clientExec, clSymbol, clQty, clPrice, true, clType);
    pos.clHedgeQty = clQty;
    pos.clEntryPrice = clPrice;
    await Trade.update({ legB_exchange: state.exchangeExec, legB_symbol: clSymbol, legB_side: clSide, legB_price: clPrice, legB_qty: clQty, legB_orderId: clResult.orderId, legB_fillType: 'taker', legB_filledAt: new Date() }, { where: { id: pos.tradeId } }).catch(() => { });
    console.log(`[TradeExecutor] MULTI CL HEDGE pair ${state.pairId} pos=${pos.posId} | ${clSide.toUpperCase()} ${clSymbol} qty=${clQty} @ ${clPrice}`);
  }

  async _exitMultiPos(state, pos, orderbooks) {
    const { pairId, pairConfig } = state;
    const symbolB = pairConfig.symbol2;
    const qty2 = pos.qty;
    const type2 = pairConfig.type2;
    const obPerp = orderbooks.leg2;

    const exitSide = pos.direction === 'long' ? 'sell' : 'buy';
    const exitPrice = pos.direction === 'long'
      ? parseFloat(obPerp?.bids?.[0]?.price || pos.entryPrice)
      : parseFloat(obPerp?.asks?.[0]?.price || pos.entryPrice);

    const result = exitSide === 'sell'
      ? await this._placeSellOrder(state.exchangeExec, state.clientExec, symbolB, qty2, exitPrice, false, type2)
      : await this._placeBuyOrder(state.exchangeExec, state.clientExec, symbolB, qty2, exitPrice, false, type2);

    const { orderId, fillStatus, errorMsg } = result;
    if (fillStatus === 'error' || !orderId) {
      console.error(`[TradeExecutor] Multi-pos exit rejected pair ${pairId}: ${errorMsg || 'no orderId'}`);
      pos._exiting = false; return;
    }

    const exitTrade = await Trade.create({
      pairId,
      side: 'exit',
      legA_exchange: state.exchangeExec,
      legA_symbol: symbolB,
      legA_side: exitSide,
      legA_price: exitPrice,
      legA_qty: qty2,
      legA_orderId: orderId,
      legA_fillType: fillStatus === 'filled' ? 'taker' : 'maker',
      zScoreAtEntry: pos.entryZScore,
      spreadAtEntry: pos.entryZScore,
      legB_exchange: null, legB_symbol: null, legB_side: null,
      status: 'open',
    });
    pos.exitOrderId = orderId;
    pos._exitOrderPrice = exitPrice;
    pos._exitTradeId = exitTrade.id;
    pos._exitStartTime = Date.now();
    pos.posState = 'exiting';
    console.log(`[TradeExecutor] MULTI-POS EXIT LIMIT pair ${pairId} pos=${pos.posId} | ${exitSide.toUpperCase()} ${symbolB} @ ${exitPrice}`);
    this._startMultiPosPoll(state, pos, SINGLE_LEG_EXIT_POLL_TIMEOUT);
  }

  async _finalizeMultiExit(state, pos, exitPrice, commission) {
    const { pairId } = state;
    const priceDelta = pos.direction === 'long' ? exitPrice - pos.entryPrice : pos.entryPrice - exitPrice;
    // Deribit inverse: pnl = qty_USD × delta / entryPrice; linear (Hyperliquid etc.): pnl = delta × qty
    const grossPnl = state.exchangeExec === 'deribit'
      ? parseFloat(((pos.qty * priceDelta) / (pos.entryPrice || exitPrice)).toFixed(6))
      : parseFloat((priceDelta * pos.qty).toFixed(6));
    const exitCommissionUsd = commission != null ? parseFloat(commission.toFixed(6)) : null;
    const totalCommUsd = (pos.entryCommissionUsd != null && exitCommissionUsd != null)
      ? parseFloat((pos.entryCommissionUsd + exitCommissionUsd).toFixed(6))
      : exitCommissionUsd ?? pos.entryCommissionUsd ?? null;
    const pnl = totalCommUsd != null ? parseFloat((grossPnl - totalCommUsd).toFixed(6)) : grossPnl;

    if (pnl < 0) {
      state.dailyLoss = parseFloat((state.dailyLoss + Math.abs(pnl)).toFixed(6));
    } else {
      state.dailyProfit = parseFloat((state.dailyProfit + pnl).toFixed(6));
      state.consecutiveLosses = 0;
    }
    state.lastTradeTime = Date.now();

    if (pos._exitTradeId) {
      await Trade.update({ legA_price: exitPrice, legA_filledAt: new Date(), status: 'filled', pnl, legA_pnl: grossPnl, commission: totalCommUsd }, { where: { id: pos._exitTradeId } }).catch(() => { });
    }

    // Close CL hedge
    if (pos.clHedgeQty > 0) {
      const clSymbol = state.pairConfig.symbol1;
      const clType = state.pairConfig.type1;
      const clSide = pos.direction === 'long' ? 'buy' : 'sell';
      const obCL = state.lastOrderbooks?.leg1;
      const clPrice = clSide === 'buy' ? parseFloat(obCL?.asks?.[0]?.price || 0) : parseFloat(obCL?.bids?.[0]?.price || 0);
      if (clPrice > 0) {
        const clResult = clSide === 'buy'
          ? await this._placeBuyOrder(state.exchangeExec, state.clientExec, clSymbol, pos.clHedgeQty, clPrice, true, clType).catch(() => ({}))
          : await this._placeSellOrder(state.exchangeExec, state.clientExec, clSymbol, pos.clHedgeQty, clPrice, true, clType).catch(() => ({}));
        if (pos._exitTradeId) {
          await Trade.update({ legB_exchange: state.exchangeExec, legB_symbol: clSymbol, legB_side: clSide, legB_price: clPrice, legB_qty: pos.clHedgeQty, legB_orderId: clResult.orderId, legB_fillType: 'taker', legB_filledAt: new Date() }, { where: { id: pos._exitTradeId } }).catch(() => { });
        }
        console.log(`[TradeExecutor] MULTI CL HEDGE EXIT pair ${pairId} pos=${pos.posId} | ${clSide.toUpperCase()} ${clSymbol} qty=${pos.clHedgeQty} @ ${clPrice}`);
      }
    }

    console.log(`[TradeExecutor] MULTI-POS CLOSED pair ${pairId} pos=${pos.posId} | ${pos.direction} | entry=${pos.entryPrice} exit=${exitPrice} gross=$${grossPnl} net=$${pnl} | dailyLoss=$${state.dailyLoss.toFixed(4)}`);
    pos.posState = 'closed';
    state.openPositions = state.openPositions.filter(p => p !== pos);
    this._broadcastState(pairId);
  }

  // ─── ENTER POSITION ────────────────────────────────────────────────

  async _enterPosition(state, stats, orderbooks, direction) {
    const { pairId, pairConfig } = state;
    const symbolB = pairConfig.symbol2;
    const qty2 = pairConfig.qty2;
    const type2 = pairConfig.type2;
    const obPerp = orderbooks.leg2;   // leg2 = perp/exec leg

    // Max qty guard
    if (pairConfig.maxQty1 != null && state.filledQty + qty2 > pairConfig.maxQty1) {
      console.log(`[TradeExecutor] Max qty reached pair ${pairId} (${state.filledQty}/${pairConfig.maxQty1})`);
      return;
    }

    state.state = STATES.ENTRY_PENDING;
    state.direction = direction;
    state.entryZScore = stats.zScore;
    state.entrySpread = stats.spread;
    state.entryMean = stats.mean;
    state.entryTime = Date.now();
    state._entryBalanceBefore = state._cachedBalance || null;
    state.legAFilled = false;
    state.legBFilled = false;

    try {
      if (state.isBasisPair) {
        // ── TWO-LEG BASIS ENTRY ─────────────────────────────────────────
        // direction='long'  → dev>0 (futures premium high): SELL futures (legA) + BUY perp (legB)
        // direction='short' → dev<0 (futures premium low):  BUY futures (legA) + SELL perp (legB)
        const obFutures = orderbooks.leg1;
        const qty1 = pairConfig.qty1;

        // LegA (futures): sell when direction=long, buy when direction=short
        // MAKER order: SELL must post at ASK (passive offer side), BUY must post at BID (passive bid side)
        const legASide = direction === 'long' ? 'sell' : 'buy';
        const legAPriceRaw = direction === 'long'
          ? obFutures?.asks?.[0]?.price   // SELL futures as MAKER → join ask queue
          : obFutures?.bids?.[0]?.price;  // BUY futures as MAKER → join bid queue
        const legAPrice = legAPriceRaw ? parseFloat(legAPriceRaw) : null;

        // LegB (perp): TAKER market order — use ask for buy, bid for sell (actual fill price)
        const legBSide = direction === 'long' ? 'buy' : 'sell';
        const legBPriceRaw = direction === 'long'
          ? obPerp?.asks?.[0]?.price   // BUY perp as TAKER → ask price (actual cost)
          : obPerp?.bids?.[0]?.price;  // SELL perp as TAKER → bid price (actual proceeds)
        const legBPrice = legBPriceRaw ? parseFloat(legBPriceRaw) : null;

        if (!legAPrice || !legBPrice) {
          console.log(`[TradeExecutor] BASIS ENTRY aborted pair ${pairId} — missing price legA=${legAPrice} legB=${legBPrice}`);
          state.state = STATES.IDLE; state.direction = null; return;
        }

        state.orderPrice = legBPrice;

        // Deribit basis: futures leg = maker (limit), perp leg = taker (market fills immediately)
        const legBIsMarket = state.isDeribitBasis;
        // Compute min-profit threshold = profitFeeMultiplier × round-trip fee cost
        if (state.isDeribitBasis && legBPrice) {
          const notionalFut = (qty1 * 10) / legAPrice;  // BTC notional of futures leg
          const notionalPerp = (qty2 * 10) / legBPrice;  // BTC notional of perp leg
          const rebateFut = DERIBIT_MAKER_REBATE * notionalFut * legAPrice;
          const takerPerp = DERIBIT_TAKER_FEE * notionalPerp * legBPrice;
          const roundTripNet = (takerPerp - rebateFut) * 2; // full round-trip net fee (entry+exit)
          const multiplier = state.profitFeeMultiplier ?? 10;
          state._minProfitUsd = multiplier * roundTripNet;
        }

        console.log(`[TradeExecutor] BASIS ENTRY pair ${pairId} | ${direction.toUpperCase()} | legA ${legASide.toUpperCase()} ${state.symbolA} @ ${legAPrice} (MAKER) | legB ${legBSide.toUpperCase()} ${symbolB} @ ${legBPrice} (${legBIsMarket ? 'TAKER' : 'MAKER'})`);

        // Place both orders simultaneously
        const [resultA, resultB] = await Promise.all([
          legASide === 'sell'
            ? this._placeSellOrder(state.exchangeA, state.clientA, state.symbolA, qty1, legAPrice, false, state.typeA)
            : this._placeBuyOrder(state.exchangeA, state.clientA, state.symbolA, qty1, legAPrice, false, state.typeA),
          legBSide === 'buy'
            ? this._placeBuyOrder(state.exchangeExec, state.clientExec, symbolB, qty2, legBPrice, legBIsMarket, type2)
            : this._placeSellOrder(state.exchangeExec, state.clientExec, symbolB, qty2, legBPrice, legBIsMarket, type2),
        ]);

        if (resultA.fillStatus === 'error' || resultB.fillStatus === 'error') {
          console.error(`[TradeExecutor] BASIS ENTRY rejected pair ${pairId} | legA=${resultA.errorMsg} legB=${resultB.errorMsg}`);
          // Cancel whichever succeeded
          if (resultA.orderId) await this._cancelOrder(state.exchangeA, state.clientA, resultA.orderId, state.symbolA, state.typeA).catch(() => { });
          if (resultB.orderId) await this._cancelOrder(state.exchangeExec, state.clientExec, resultB.orderId, symbolB, type2).catch(() => { });
          state.state = STATES.IDLE; state.direction = null; return;
        }

        state.orderIdA = resultA.orderId;
        state.orderIdB = resultB.orderId;
        state.orderId = resultB.orderId; // keep compat

        // If either immediately filled (taker market orders fill synchronously)
        if (resultA.fillStatus === 'filled') { state.legAFilled = true; state.entryPriceA = resultA.filledPrice || legAPrice; }
        if (resultB.fillStatus === 'filled') {
          state.legBFilled = true;
          state.entryPriceB = resultB.filledPrice || legBPrice;
          state.entryPrice = state.entryPriceB;
          // Commission from taker fill (Deribit returns it in the order response)
          const commB = resultB.commission != null
            ? (state.exchangeExec === 'deribit'
              ? parseFloat((resultB.commission * state.entryPriceB).toFixed(6))
              : parseFloat(resultB.commission.toFixed(6)))
            : null;
          if (commB != null) {
            state.entryCommissionUsd = parseFloat(((state.entryCommissionA ?? 0) + commB).toFixed(6));
          }
        }

        const trade = await Trade.create({
          pairId,
          side: 'entry',
          legA_exchange: state.exchangeA,
          legA_symbol: state.symbolA,
          legA_side: legASide,
          legA_price: legAPrice,
          legA_qty: qty1,
          legA_orderId: state.orderIdA,
          legA_fillType: resultA.fillStatus === 'filled' ? 'taker' : 'maker',
          legA_buyVwap: obFutures?.buyVwap ?? null,
          legA_sellVwap: obFutures?.sellVwap ?? null,
          legB_exchange: state.exchangeExec,
          legB_symbol: symbolB,
          legB_side: legBSide,
          legB_price: legBPrice,
          legB_qty: qty2,
          legB_orderId: state.orderIdB,
          legB_fillType: resultB.fillStatus === 'filled' ? 'taker' : 'maker',
          legB_buyVwap: obPerp?.buyVwap ?? null,
          legB_sellVwap: obPerp?.sellVwap ?? null,
          zScoreAtEntry: stats.zScore,
          spreadAtEntry: stats.spread,
          balanceBefore: state._entryBalanceBefore,
          status: 'open',
        });
        state.activeTradeId = trade.id;

        if (state.legAFilled && state.legBFilled) {
          // Both immediately filled (taker)
          state.filledQty += qty2;
          state.state = STATES.POSITION_OPEN;
          await Trade.update({ legA_filledAt: new Date(), legB_filledAt: new Date(), status: 'filled' }, { where: { id: trade.id } });
        } else {
          this._startPoll(state, ENTRY_POLL_TIMEOUT);
        }
        this._broadcastState(pairId);

      } else {
        // ── SINGLE-LEG ENTRY (unchanged) ───────────────────────────────
        let entryPrice, side;
        if (direction === 'long') {
          const bestBid = obPerp?.bids?.[0]?.price ? parseFloat(obPerp.bids[0].price) : null;
          if (!bestBid) { console.log(`[TradeExecutor] No bid for ${symbolB}, skipping entry`); state.state = STATES.IDLE; state.direction = null; return; }
          entryPrice = bestBid; side = 'buy';
        } else {
          const bestAsk = obPerp?.asks?.[0]?.price ? parseFloat(obPerp.asks[0].price) : null;
          if (!bestAsk) { console.log(`[TradeExecutor] No ask for ${symbolB}, skipping entry`); state.state = STATES.IDLE; state.direction = null; return; }
          entryPrice = bestAsk; side = 'sell';
        }
        state.orderPrice = entryPrice;
        console.log(`[TradeExecutor] ENTRY pair ${pairId} | ${direction.toUpperCase()} ${symbolB} LIMIT @ ${entryPrice} (maker)`);

        const result = direction === 'long'
          ? await this._placeBuyOrder(state.exchangeExec, state.clientExec, symbolB, qty2, entryPrice, false, type2)
          : await this._placeSellOrder(state.exchangeExec, state.clientExec, symbolB, qty2, entryPrice, false, type2);

        const { orderId, fillStatus, errorMsg } = result;
        if (fillStatus === 'error') {
          console.error(`[TradeExecutor] Entry REJECTED pair ${pairId}: ${errorMsg}`);
          state.state = STATES.IDLE; state.direction = null; return;
        }
        if (orderId) {
          state.orderId = orderId;
          const trade = await Trade.create({
            pairId,
            side: 'entry',
            legA_exchange: state.exchangeExec,
            legA_symbol: symbolB,
            legA_side: side,
            legA_price: entryPrice,
            legA_qty: qty2,
            legA_orderId: orderId,
            legA_fillType: fillStatus === 'filled' ? 'taker' : 'maker',
            legA_buyVwap: obPerp?.buyVwap ?? null,
            legA_sellVwap: obPerp?.sellVwap ?? null,
            legB_exchange: null, legB_symbol: null, legB_side: null,
            zScoreAtEntry: stats.zScore,
            spreadAtEntry: stats.spread,
            balanceBefore: state._entryBalanceBefore,
            status: 'open',
          });
          state.activeTradeId = trade.id;
          this._startPoll(state, ENTRY_POLL_TIMEOUT);
          this._broadcastState(pairId);
        } else {
          console.error(`[TradeExecutor] Entry failed pair ${pairId} — no orderId`);
          state.state = STATES.IDLE; state.direction = null;
        }
      }
    } catch (e) {
      console.error(`[TradeExecutor] Entry error pair ${pairId}: ${e.message}`);
      state.state = STATES.IDLE; state.direction = null;
    }
  }

  // ─── EXIT POSITION ─────────────────────────────────────────────────

  async _exitPosition(state, reason, orderbooks) {
    const { pairId, pairConfig } = state;
    const symbolB = pairConfig.symbol2;
    const qty2 = pairConfig.qty2;
    const type2 = pairConfig.type2;
    const obPerp = orderbooks.leg2;

    state.state = STATES.EXIT_PENDING;
    state.exitReason = reason;
    state.exitLegAFilled = false;
    state.exitLegBFilled = false;

    try {
      if (state.isBasisPair) {
        // ── TWO-LEG BASIS EXIT ──────────────────────────────────────────
        // Close the opposite side of each leg at current best prices (market-maker limit)
        const obFutures = orderbooks.leg1;
        const qty1 = pairConfig.qty1;

        // LegA close: direction='long' means we sold futures → buy back; 'short' → sell back
        // MAKER order: BUY back posts at BID (passive), SELL back posts at ASK (passive)
        const legACloseSide = state.direction === 'long' ? 'buy' : 'sell';
        const legAClosePrice = state.direction === 'long'
          ? parseFloat(obFutures?.bids?.[0]?.price || state.entryPriceA || 0)  // BUY as MAKER → bid
          : parseFloat(obFutures?.asks?.[0]?.price || state.entryPriceA || 0); // SELL as MAKER → ask

        // LegB close: direction='long' means we bought perp → sell back; 'short' → buy back
        const legBCloseSide = state.direction === 'long' ? 'sell' : 'buy';
        const legBClosePrice = state.direction === 'long'
          ? parseFloat(obPerp?.bids?.[0]?.price || state.entryPriceB || 0)
          : parseFloat(obPerp?.asks?.[0]?.price || state.entryPriceB || 0);

        if (!legAClosePrice || !legBClosePrice) {
          console.error(`[TradeExecutor] BASIS EXIT aborted pair ${pairId} — missing close price`);
          state.state = STATES.POSITION_OPEN; state.exitReason = null; return;
        }

        state.orderPrice = legBClosePrice;
        const exitLegBIsMarket = state.isDeribitBasis; // perp always taker on exit
        console.log(`[TradeExecutor] BASIS EXIT (${reason}) pair ${pairId} | legA ${legACloseSide.toUpperCase()} ${state.symbolA} @ ${legAClosePrice} (MAKER) | legB ${legBCloseSide.toUpperCase()} ${symbolB} @ ${legBClosePrice} (${exitLegBIsMarket ? 'TAKER-sequential' : 'MAKER'})`);

        // SEQUENTIAL for Deribit basis: place legA first, legB only after legA confirmed filled
        if (exitLegBIsMarket) {
          const resultA = await (legACloseSide === 'buy'
            ? this._placeBuyOrder(state.exchangeA, state.clientA, state.symbolA, qty1, legAClosePrice, false, state.typeA)
            : this._placeSellOrder(state.exchangeA, state.clientA, state.symbolA, qty1, legAClosePrice, false, state.typeA));

          if (resultA.fillStatus === 'error') {
            console.error(`[TradeExecutor] BASIS EXIT legA rejected pair ${pairId}`);
            state.state = STATES.POSITION_OPEN; state.exitReason = null; return;
          }

          state.closeOrderIdA = resultA.orderId;
          state.closeOrderIdB = null;
          state.exitLegAFilled = resultA.fillStatus === 'filled';
          state.exitLegBFilled = false;
          state._exitPriceA = state.exitLegAFilled ? (resultA.filledPrice || legAClosePrice) : null;
          state._exitPriceB = null;
          state._exitCommA = state.exitLegAFilled ? (resultA.commission ?? null) : null;
          state._exitCommB = null;
          // Store legB details for sequential placement after legA fills
          state._pendingLegBSide = legBCloseSide;
          state._pendingLegBPrice = legBClosePrice;
          state._exitLegBPlaced = false;

          if (!state.exitTradeId) {
            const trade = await Trade.create({
              pairId,
              side: 'exit',
              legA_exchange: state.exchangeA,
              legA_symbol: state.symbolA,
              legA_side: legACloseSide,
              legA_price: legAClosePrice,
              legA_qty: qty1,
              legA_orderId: state.closeOrderIdA,
              legA_fillType: 'maker',
              legA_buyVwap: obFutures?.buyVwap ?? null,
              legA_sellVwap: obFutures?.sellVwap ?? null,
              legB_exchange: state.exchangeExec,
              legB_symbol: symbolB,
              legB_side: legBCloseSide,
              legB_price: legBClosePrice,
              legB_qty: qty2,
              legB_fillType: 'taker',
              legB_buyVwap: obPerp?.buyVwap ?? null,
              legB_sellVwap: obPerp?.sellVwap ?? null,
              zScoreAtEntry: state.entryZScore,
              spreadAtEntry: state.entrySpread,
              status: 'open',
            });
            state.exitTradeId = trade.id;
          } else {
            await Trade.update(
              { legA_orderId: state.closeOrderIdA, legA_price: legAClosePrice, status: 'open' },
              { where: { id: state.exitTradeId } }
            );
          }
          state.activeTradeId = state.exitTradeId;

          if (state.exitLegAFilled) {
            // LegA already filled (immediate) — place legB now via poll handler logic
            // Re-use _pollFill by leaving exitLegBFilled=false; poll will place legB
          }
          this._startPoll(state, EXIT_POLL_TIMEOUT);
          this._broadcastState(pairId);
          return;
        }

        // PARALLEL for non-Deribit basis (both legs limit on different exchanges)
        const [resultA, resultB] = await Promise.all([
          legACloseSide === 'buy'
            ? this._placeBuyOrder(state.exchangeA, state.clientA, state.symbolA, qty1, legAClosePrice, false, state.typeA)
            : this._placeSellOrder(state.exchangeA, state.clientA, state.symbolA, qty1, legAClosePrice, false, state.typeA),
          legBCloseSide === 'sell'
            ? this._placeSellOrder(state.exchangeExec, state.clientExec, symbolB, qty2, legBClosePrice, exitLegBIsMarket, type2)
            : this._placeBuyOrder(state.exchangeExec, state.clientExec, symbolB, qty2, legBClosePrice, exitLegBIsMarket, type2),
        ]);

        if (resultA.fillStatus === 'error' || resultB.fillStatus === 'error') {
          console.error(`[TradeExecutor] BASIS EXIT rejected pair ${pairId} | legA=${resultA.errorMsg} legB=${resultB?.errorMsg}`);
          state.state = STATES.POSITION_OPEN; state.exitReason = null; return;
        }

        state.closeOrderIdA = resultA.orderId;
        state.closeOrderIdB = resultB.orderId;
        state.orderId = resultB.orderId; // compat
        state._exitLegBPlaced = true;

        if (resultA.fillStatus === 'filled') { state.exitLegAFilled = true; state._exitPriceA = resultA.filledPrice || legAClosePrice; state._exitCommA = resultA.commission ?? null; }
        if (resultB.fillStatus === 'filled') { state.exitLegBFilled = true; state._exitPriceB = resultB.filledPrice || legBClosePrice; state._exitCommB = resultB.commission ?? null; }

        if (!state.exitTradeId) {
          const trade = await Trade.create({
            pairId,
            side: 'exit',
            legA_exchange: state.exchangeA,
            legA_symbol: state.symbolA,
            legA_side: legACloseSide,
            legA_price: legAClosePrice,
            legA_qty: qty1,
            legA_orderId: state.closeOrderIdA,
            legA_fillType: resultA.fillStatus === 'filled' ? 'taker' : 'maker',
            legA_buyVwap: obFutures?.buyVwap ?? null,
            legA_sellVwap: obFutures?.sellVwap ?? null,
            legB_exchange: state.exchangeExec,
            legB_symbol: symbolB,
            legB_side: legBCloseSide,
            legB_price: legBClosePrice,
            legB_qty: qty2,
            legB_orderId: state.closeOrderIdB,
            legB_fillType: resultB.fillStatus === 'filled' ? 'taker' : 'maker',
            legB_buyVwap: obPerp?.buyVwap ?? null,
            legB_sellVwap: obPerp?.sellVwap ?? null,
            zScoreAtEntry: state.entryZScore,
            spreadAtEntry: state.entrySpread,
            status: 'open',
          });
          state.exitTradeId = trade.id;
        } else {
          await Trade.update(
            {
              legA_orderId: state.closeOrderIdA, legA_price: legAClosePrice,
              legB_orderId: state.closeOrderIdB, legB_price: legBClosePrice, status: 'open'
            },
            { where: { id: state.exitTradeId } }
          );
        }
        state.activeTradeId = state.exitTradeId;

        if (state.exitLegAFilled && state.exitLegBFilled) {
          // Both immediately filled — finalise inline using actual fill prices
          await this._finaliseBasisExit(state, state._exitPriceA || legAClosePrice, state._exitPriceB || legBClosePrice, state._exitCommA, state._exitCommB);
        } else {
          this._startPoll(state, EXIT_POLL_TIMEOUT);
        }
        this._broadcastState(pairId);

      } else {
        // ── SINGLE-LEG EXIT — always maker (place at current best bid/ask) ──────
        // NEVER cross the spread on exit. Use current best bid (for sell) or best ask
        // (for buy) so the order rests in the book and earns the maker rebate.
        // Fallback to fixed price only if orderbook is unavailable.
        let exitPrice, side;
        if (state.direction === 'long') {
          const bestBid = obPerp?.bids?.[0]?.price ? parseFloat(obPerp.bids[0].price) : null;
          exitPrice = bestBid ?? parseFloat((state.entryPrice + state.profitTarget).toFixed(4));
          side = 'sell';
        } else {
          const bestAsk = obPerp?.asks?.[0]?.price ? parseFloat(obPerp.asks[0].price) : null;
          exitPrice = bestAsk ?? parseFloat((state.entryPrice - state.profitTarget).toFixed(4));
          side = 'buy';
        }
        state.orderPrice = exitPrice;
        console.log(`[TradeExecutor] EXIT (${reason}) pair ${pairId} | ${side.toUpperCase()} ${symbolB} LIMIT @ ${exitPrice} (maker at best ${side === 'sell' ? 'bid' : 'ask'})`);

        const result = state.direction === 'long'
          ? await this._placeSellOrder(state.exchangeExec, state.clientExec, symbolB, qty2, exitPrice, false, type2)
          : await this._placeBuyOrder(state.exchangeExec, state.clientExec, symbolB, qty2, exitPrice, false, type2);

        const { orderId, fillStatus, errorMsg } = result;
        if (fillStatus === 'error') {
          console.error(`[TradeExecutor] Exit REJECTED pair ${pairId}: ${errorMsg}`);
          state.state = STATES.POSITION_OPEN; state.exitReason = null; return;
        }
        if (orderId) {
          state.orderId = orderId;
          if (!state.exitTradeId) {
            const trade = await Trade.create({
              pairId,
              side: 'exit',
              legA_exchange: state.exchangeExec,
              legA_symbol: symbolB,
              legA_side: side,
              legA_price: exitPrice,
              legA_qty: qty2,
              legA_orderId: orderId,
              legA_fillType: fillStatus === 'filled' ? 'taker' : 'maker',
              legA_buyVwap: obPerp?.buyVwap ?? null,
              legA_sellVwap: obPerp?.sellVwap ?? null,
              legB_exchange: null, legB_symbol: null, legB_side: null,
              zScoreAtEntry: state.entryZScore,
              spreadAtEntry: state.entrySpread,
              status: 'open',
            });
            state.exitTradeId = trade.id;
          } else {
            await Trade.update(
              { legA_orderId: orderId, legA_price: exitPrice, status: 'open' },
              { where: { id: state.exitTradeId } }
            );
          }
          state.activeTradeId = state.exitTradeId;
          // Single-leg: wait up to 2 min for maker fill; basis: keep 30 s then retry
          const exitTimeout = state.isBasisPair ? EXIT_POLL_TIMEOUT : SINGLE_LEG_EXIT_POLL_TIMEOUT;
          this._startPoll(state, exitTimeout);
          this._broadcastState(pairId);
        } else {
          console.error(`[TradeExecutor] Exit failed pair ${pairId} — no orderId`);
          state.state = STATES.POSITION_OPEN; state.exitReason = null;
        }
      }
    } catch (e) {
      console.error(`[TradeExecutor] Exit error pair ${pairId}: ${e.message}`);
      state.state = STATES.POSITION_OPEN;
      state.exitReason = null;
    }
  }

  // ─── POLLING ───────────────────────────────────────────────────────

  _startPoll(state, timeoutMs) {
    if (state.pollTimer) clearInterval(state.pollTimer);
    state.pollStartTime = Date.now();

    state.pollTimer = setInterval(async () => {
      try {
        if (Date.now() - state.pollStartTime > timeoutMs) {
          clearInterval(state.pollTimer);
          state.pollTimer = null;

          console.warn(`[TradeExecutor] Poll timeout (${timeoutMs}ms) pair ${state.pairId} state=${state.state} reason=${state.exitReason} basis=${state.isBasisPair}`);

          if (state.isBasisPair) {
            // Cancel any unfilled legs and abort
            if (state.state === STATES.ENTRY_PENDING) {
              if (!state.legAFilled && state.orderIdA) await this._cancelOrder(state.exchangeA, state.clientA, state.orderIdA, state.symbolA, state.typeA).catch(() => { });
              if (!state.legBFilled && state.orderIdB) await this._cancelOrder(state.exchangeExec, state.clientExec, state.orderIdB, state.pairConfig.symbol2, state.pairConfig.type2).catch(() => { });
              // If one leg filled but not the other, market-close it at best available
              if (state.legAFilled && !state.legBFilled) {
                const closeSide = state.direction === 'long' ? 'buy' : 'sell'; // reverse of entry
                await this._placeBuyOrder(state.exchangeA, state.clientA, state.symbolA, state.pairConfig.qty1, 0, true, state.typeA).catch(() => { });
                console.warn(`[TradeExecutor] Basis entry timeout: emergency close legA ${closeSide}`);
              }
              if (state.activeTradeId) await Trade.update({ status: 'cancelled' }, { where: { id: state.activeTradeId } });
              state.state = STATES.IDLE; state.direction = null; state.orderIdA = null; state.orderIdB = null; state.orderId = null;
              state.legAFilled = false; state.legBFilled = false; state.activeTradeId = null;
            } else if (state.state === STATES.EXIT_PENDING) {
              if (state.exitLegAFilled && !state.exitLegBFilled) {
                // LegA filled but legB never completed — extend and keep retrying legB
                console.warn(`[TradeExecutor] BASIS exit timeout: legA filled, legB pending — extending pair ${state.pairId}`);
                state.pollStartTime = Date.now();
                state._exitLegBPlaced = false; // force re-place on next _pollFill
                state.closeOrderIdB = null;
                state.pollTimer = setInterval(async () => {
                  try {
                    if (Date.now() - state.pollStartTime > EXIT_POLL_TIMEOUT) {
                      clearInterval(state.pollTimer); state.pollTimer = null;
                      console.error(`[TradeExecutor] BASIS exit: legB retry exhausted pair ${state.pairId} — manual intervention required`);
                    } else {
                      await this._pollFill(state);
                    }
                  } catch (e) { console.error(`[TradeExecutor] legB retry poll error pair ${state.pairId}: ${e.message}`); }
                }, POLL_INTERVAL);
                this._broadcastState(state.pairId); return;
              }
              // Normal case: cancel unfilled, go back to POSITION_OPEN for retry
              if (!state.exitLegAFilled && state.closeOrderIdA) await this._cancelOrder(state.exchangeA, state.clientA, state.closeOrderIdA, state.symbolA, state.typeA).catch(() => { });
              if (!state.exitLegBFilled && state.closeOrderIdB) await this._cancelOrder(state.exchangeExec, state.clientExec, state.closeOrderIdB, state.pairConfig.symbol2, state.pairConfig.type2).catch(() => { });
              if (state.exitTradeId) await Trade.update({ status: 'cancelled' }, { where: { id: state.exitTradeId } }).catch(() => { });
              state.state = STATES.POSITION_OPEN; state.exitReason = null;
              state.closeOrderIdA = null; state.closeOrderIdB = null; state.orderId = null; state.activeTradeId = null;
              state.exitLegAFilled = false; state.exitLegBFilled = false; state._exitLegBPlaced = false;
            }
            this._broadcastState(state.pairId);
            return;
          }

          // Single-leg timeout handling (unchanged)
          let partialFillSz = 0;
          let partialFillPx = state.orderPrice;
          try {
            const finalStatus = await this._getOrderStatus(state.exchangeExec, state.clientExec, state.orderId);
            partialFillSz = finalStatus.filledSz || 0;
            partialFillPx = finalStatus.filledPrice || state.orderPrice;
          } catch (e) { /* ignore */ }

          try {
            await this._cancelOrder(state.exchangeExec, state.clientExec, state.orderId, state.pairConfig.symbol2, state.pairConfig.type2);
          } catch (e) {
            console.error(`[TradeExecutor] Failed to cancel timed-out order: ${e.message}`);
          }

          if (state.state === STATES.ENTRY_PENDING) {
            if (partialFillSz > 0) {
              state.entryPrice = partialFillPx;
              state.filledQty += partialFillSz;
              if (state.activeTradeId) await Trade.update({ legA_price: partialFillPx, legA_qty: partialFillSz, legA_filledAt: new Date(), status: 'filled' }, { where: { id: state.activeTradeId } });
              state.state = STATES.POSITION_OPEN; state.orderId = null; state.activeTradeId = null;
              this._broadcastState(state.pairId); return;
            }
            if (state.activeTradeId) await Trade.update({ status: 'cancelled' }, { where: { id: state.activeTradeId } });
            state.state = STATES.IDLE; state.direction = null; state.exitReason = null;
            state.orderId = null; state.activeTradeId = null;
          } else if (state.state === STATES.EXIT_PENDING) {
            state.state = STATES.POSITION_OPEN; state.exitReason = null;
            state.orderId = null; state.activeTradeId = null;
          }

          this._broadcastState(state.pairId);
          return;
        }

        await this._pollFill(state);
      } catch (e) {
        console.error(`[TradeExecutor] Poll error pair ${state.pairId}: ${e.message}`);
      }
    }, POLL_INTERVAL);
  }

  // ─── BASIS PnL HELPER ──────────────────────────────────────────────
  // ─── CL TAKER HEDGE HELPERS (single-leg CL/BRENT only) ────────────
  // After BRENT entry fills → place CL taker at 70% qty (opposite direction)
  async _placeClHedge(state, brentFilledQty, tradeId) {
    const clSymbol = state.pairConfig.symbol1;
    const clType = state.pairConfig.type1;
    if (!clSymbol || !state.pairConfig.exchange1) return;

    const clQty = parseFloat((brentFilledQty * CL_HEDGE_RATIO).toFixed(4));
    if (clQty <= 0) return;

    // Hedge is OPPOSITE to BRENT direction: long BRENT → sell CL, short BRENT → buy CL
    const clSide = state.direction === 'long' ? 'sell' : 'buy';
    const obCL = state.lastOrderbooks?.leg1;
    // Cross the spread intentionally (taker): sell hits the bid, buy hits the ask
    const clPrice = clSide === 'sell'
      ? parseFloat(obCL?.bids?.[0]?.price || 0)
      : parseFloat(obCL?.asks?.[0]?.price || 0);

    if (clPrice <= 0) {
      console.warn(`[TradeExecutor] CL hedge skipped pair ${state.pairId} — no CL price`);
      return;
    }

    try {
      const clResult = clSide === 'sell'
        ? await this._placeSellOrder(state.exchangeExec, state.clientExec, clSymbol, clQty, clPrice, true, clType)
        : await this._placeBuyOrder(state.exchangeExec, state.clientExec, clSymbol, clQty, clPrice, true, clType);

      state.clHedgeQty = clQty;
      state.clEntryPrice = clPrice;

      if (tradeId) {
        await Trade.update({
          legB_exchange: state.exchangeExec,
          legB_symbol: clSymbol,
          legB_side: clSide,
          legB_price: clPrice,
          legB_qty: clQty,
          legB_orderId: clResult.orderId,
          legB_fillType: 'taker',
          legB_filledAt: new Date(),
        }, { where: { id: tradeId } });
      }
      console.log(`[TradeExecutor] CL HEDGE ENTRY pair ${state.pairId} | ${clSide.toUpperCase()} ${clSymbol} qty=${clQty} @ ${clPrice} (taker)`);
    } catch (e) {
      console.error(`[TradeExecutor] CL hedge entry failed pair ${state.pairId}: ${e.message}`);
    }
  }

  // After BRENT exit fills → close CL hedge as taker
  async _closeClHedge(state, exitTradeId) {
    if (state.clHedgeQty <= 0) return;

    const clSymbol = state.pairConfig.symbol1;
    const clType = state.pairConfig.type1;
    const clQty = state.clHedgeQty;

    // Close direction: opposite of hedge entry (long BRENT → sold CL → buy it back)
    const clSide = state.direction === 'long' ? 'buy' : 'sell';
    const obCL = state.lastOrderbooks?.leg1;
    const clPrice = clSide === 'buy'
      ? parseFloat(obCL?.asks?.[0]?.price || 0)
      : parseFloat(obCL?.bids?.[0]?.price || 0);

    if (clPrice <= 0) {
      console.warn(`[TradeExecutor] CL hedge exit skipped pair ${state.pairId} — no CL price`);
      return;
    }

    try {
      const clResult = clSide === 'buy'
        ? await this._placeBuyOrder(state.exchangeExec, state.clientExec, clSymbol, clQty, clPrice, true, clType)
        : await this._placeSellOrder(state.exchangeExec, state.clientExec, clSymbol, clQty, clPrice, true, clType);

      state.clExitPrice = clPrice;

      if (exitTradeId) {
        await Trade.update({
          legB_exchange: state.exchangeExec,
          legB_symbol: clSymbol,
          legB_side: clSide,
          legB_price: clPrice,
          legB_qty: clQty,
          legB_orderId: clResult.orderId,
          legB_fillType: 'taker',
          legB_filledAt: new Date(),
        }, { where: { id: exitTradeId } });
      }
      console.log(`[TradeExecutor] CL HEDGE EXIT pair ${state.pairId} | ${clSide.toUpperCase()} ${clSymbol} qty=${clQty} @ ${clPrice} (taker)`);
    } catch (e) {
      console.error(`[TradeExecutor] CL hedge exit failed pair ${state.pairId}: ${e.message}`);
    }

    // Reset hedge state regardless of success
    state.clHedgeQty = 0;
    state.clEntryPrice = null;
    state.clExitPrice = null;
  }

  // ─── BASIS PnL HELPER ──────────────────────────────────────────────
  // Deribit inverse:   pnl = qty_USD × priceDelta / entryPrice
  //   (qty is already USD notional; no CONTRACT_SIZE multiplier needed)
  // Hyperliquid linear: pnl = priceDelta × qty
  // direction='long':  sold legA + bought legB at entry
  // direction='short': bought legA + sold legB at entry
  _calcBasisPnlUsd(state, exitPriceA, exitPriceB) {
    const qty1 = state.pairConfig.qty1;
    const qty2 = state.pairConfig.qty2;
    const eA = state.entryPriceA || exitPriceA;
    const eB = state.entryPriceB || exitPriceB;

    // legA: short when direction=long (profit when price falls)
    const deltaA = state.direction === 'long' ? eA - exitPriceA : exitPriceA - eA;
    const legAPnl = state.exchangeA === 'deribit'
      ? parseFloat(((qty1 * deltaA) / eA).toFixed(6))
      : parseFloat((deltaA * qty1).toFixed(6));

    // legB: long when direction=long (profit when price rises)
    const deltaB = state.direction === 'long' ? exitPriceB - eB : eB - exitPriceB;
    const legBPnl = state.exchangeExec === 'deribit'
      ? parseFloat(((qty2 * deltaB) / eB).toFixed(6))
      : parseFloat((deltaB * qty2).toFixed(6));

    return { legAPnl, legBPnl, totalPnl: parseFloat((legAPnl + legBPnl).toFixed(6)) };
  }

  // ─── FINALISE BASIS EXIT ────────────────────────────────────────────
  // Called when both close legs have filled.
  async _finaliseBasisExit(state, exitPriceA, exitPriceB, commissionA, commissionB) {
    const { pairId } = state;
    const { legAPnl, legBPnl, totalPnl } = this._calcBasisPnlUsd(state, exitPriceA, exitPriceB);

    // Deribit: commission in base currency → × price to get USD; Hyperliquid: already USD
    const commAusd = commissionA != null
      ? (state.exchangeA === 'deribit'
        ? parseFloat((commissionA * exitPriceA).toFixed(6))
        : parseFloat(commissionA.toFixed(6)))
      : null;
    const commBusd = commissionB != null
      ? (state.exchangeExec === 'deribit'
        ? parseFloat((commissionB * exitPriceB).toFixed(6))
        : parseFloat(commissionB.toFixed(6)))
      : null;
    const entryCommTotal = state.entryCommissionUsd ?? 0;  // combined A+B entry commissions
    const exitCommTotal = ((commAusd ?? 0) + (commBusd ?? 0)) || null;
    const totalCommUsd = exitCommTotal != null
      ? parseFloat((entryCommTotal + exitCommTotal).toFixed(6))
      : (entryCommTotal || null);

    const pnl = totalCommUsd != null
      ? parseFloat((totalPnl - totalCommUsd).toFixed(6))
      : totalPnl;

    if (pnl < 0) {
      state.dailyLoss = parseFloat((state.dailyLoss + Math.abs(pnl)).toFixed(6));
      if (state.exitReason === 'stop') { state.consecutiveLosses++; state.lastLossTime = Date.now(); }
    } else {
      state.dailyProfit = parseFloat((state.dailyProfit + pnl).toFixed(6));
      state.consecutiveLosses = 0;
    }
    state.lastTradeTime = Date.now();

    const balanceAfter = await this._getAccountBalance(state);
    if (balanceAfter != null) state._cachedBalance = balanceAfter;
    const exchangePnl = (state._entryBalanceBefore != null && balanceAfter != null)
      ? parseFloat((balanceAfter - state._entryBalanceBefore).toFixed(6)) : null;

    if (state.activeTradeId) {
      await Trade.update({
        legA_price: exitPriceA,
        legA_filledAt: new Date(),
        legA_pnl: legAPnl,
        legB_price: exitPriceB,
        legB_filledAt: new Date(),
        legB_pnl: legBPnl,
        status: 'filled',
        pnl,
        commission: totalCommUsd,
        balanceAfter,
        exchangePnl,
      }, { where: { id: state.activeTradeId } });
    }

    console.log(`[TradeExecutor] BASIS CLOSED pair ${pairId} | ${state.direction} | reason=${state.exitReason} | legA entry=${state.entryPriceA} exit=${exitPriceA} pnl=$${legAPnl} | legB entry=${state.entryPriceB} exit=${exitPriceB} pnl=$${legBPnl} | total=$${totalPnl} net=$${pnl} | dailyLoss=$${state.dailyLoss.toFixed(4)}`);

    this.tradeCounter++;
    if (aiAgent.isConfigured() && this.tradeCounter % 1000 === 0) {
      aiAgent.reviewCompletedTrade(pairId, { direction: state.direction, entryPriceA: state.entryPriceA, exitPriceA, pnl, holdMs: Date.now() - (state.entryTime || 0), exitReason: state.exitReason }, {});
    }

    // Reset all state
    state.state = STATES.IDLE;
    state.orderId = null;
    state.orderIdA = null;
    state.orderIdB = null;
    state.closeOrderIdA = null;
    state.closeOrderIdB = null;
    state.activeTradeId = null;
    state.entryPrice = null;
    state.entryPriceA = null;
    state.entryPriceB = null;
    state.entryMean = null;
    state.entryTime = null;
    state.direction = null;
    state.exitReason = null;
    state.activeQty = null;
    state.exitTradeId = null;
    state.legAFilled = false;
    state.legBFilled = false;
    state.exitLegAFilled = false;
    state.exitLegBFilled = false;
    state.entryCommissionA = null;
    state.entryCommissionUsd = null;
    state._entryBalanceBefore = null;
    state._minProfitUsd = 0;
    this._broadcastState(pairId);
  }

  async _pollFill(state) {
    const { pairId } = state;

    // ── BASIS TWO-LEG POLL ────────────────────────────────────────────
    if (state.isBasisPair) {
      if (state.state === STATES.ENTRY_PENDING) {
        // Poll legA and legB independently until both filled
        if (state.orderIdA && !state.legAFilled) {
          const sA = await this._getOrderStatus(state.exchangeA, state.clientA, state.orderIdA);
          if (sA.status === 'filled') {
            state.legAFilled = true;
            state.entryPriceA = sA.filledPrice || state.orderPrice;
            const commA = sA.commission != null
              ? (state.exchangeA === 'deribit'
                ? parseFloat((sA.commission * state.entryPriceA).toFixed(6))
                : parseFloat(sA.commission.toFixed(6)))
              : null;
            state.entryCommissionA = commA;
          } else if (sA.status === 'cancelled') {
            // If legA cancelled, cancel legB too and abort
            if (state.orderIdB && !state.legBFilled) {
              await this._cancelOrder(state.exchangeExec, state.clientExec, state.orderIdB, state.pairConfig.symbol2, state.pairConfig.type2).catch(() => { });
            }
            clearInterval(state.pollTimer); state.pollTimer = null;
            if (state.activeTradeId) await Trade.update({ status: 'cancelled' }, { where: { id: state.activeTradeId } });
            state.state = STATES.IDLE; state.direction = null; state.orderId = null;
            state.orderIdA = null; state.orderIdB = null; state.activeTradeId = null;
            this._broadcastState(pairId); return;
          }
        }
        if (state.orderIdB && !state.legBFilled) {
          const sB = await this._getOrderStatus(state.exchangeExec, state.clientExec, state.orderIdB);
          if (sB.status === 'filled') {
            state.legBFilled = true;
            state.entryPriceB = sB.filledPrice || state.orderPrice;
            state.entryPrice = state.entryPriceB;
            const commB = sB.commission != null
              ? (state.exchangeExec === 'deribit'
                ? parseFloat((sB.commission * state.entryPriceB).toFixed(6))
                : parseFloat(sB.commission.toFixed(6)))
              : null;
            state.entryCommissionUsd = parseFloat(((state.entryCommissionA ?? 0) + (commB ?? 0)).toFixed(6));
          } else if (sB.status === 'cancelled') {
            if (state.orderIdA && !state.legAFilled) {
              await this._cancelOrder(state.exchangeA, state.clientA, state.orderIdA, state.symbolA, state.typeA).catch(() => { });
            }
            clearInterval(state.pollTimer); state.pollTimer = null;
            if (state.activeTradeId) await Trade.update({ status: 'cancelled' }, { where: { id: state.activeTradeId } });
            state.state = STATES.IDLE; state.direction = null; state.orderId = null;
            state.orderIdA = null; state.orderIdB = null; state.activeTradeId = null;
            this._broadcastState(pairId); return;
          }
        }

        if (state.legAFilled && state.legBFilled) {
          clearInterval(state.pollTimer); state.pollTimer = null;
          state.filledQty += state.pairConfig.qty2;
          state.activeQty = state.pairConfig.qty2;
          await Trade.update({
            legA_price: state.entryPriceA, legA_filledAt: new Date(),
            legB_price: state.entryPriceB, legB_filledAt: new Date(),
            commission: state.entryCommissionUsd, status: 'filled',
          }, { where: { id: state.activeTradeId } });
          state.state = STATES.POSITION_OPEN;
          state.orderId = null; state.activeTradeId = null;
          console.log(`[TradeExecutor] BASIS POSITION OPEN pair ${pairId} | ${state.direction.toUpperCase()} | legA=${state.entryPriceA} legB=${state.entryPriceB} | z-exit<±${state.profitTarget} stop±${state.stopLoss}σ`);
          this._broadcastState(pairId);
        }
        return;
      }

      if (state.state === STATES.EXIT_PENDING) {
        // Poll legA
        if (state.closeOrderIdA && !state.exitLegAFilled) {
          const sA = await this._getOrderStatus(state.exchangeA, state.clientA, state.closeOrderIdA);
          if (sA.status === 'filled') {
            state.exitLegAFilled = true;
            state._exitPriceA = sA.filledPrice || state.orderPrice;
            state._exitCommA = sA.commission;
            // Sequential mode: legA just filled — place legB now if not yet placed
            if (state.isDeribitBasis && !state._exitLegBPlaced && state._pendingLegBSide) {
              const resultB = await (state._pendingLegBSide === 'sell'
                ? this._placeSellOrder(state.exchangeExec, state.clientExec, state.pairConfig.symbol2, state.pairConfig.qty2, state._pendingLegBPrice, true, state.pairConfig.type2)
                : this._placeBuyOrder(state.exchangeExec, state.clientExec, state.pairConfig.symbol2, state.pairConfig.qty2, state._pendingLegBPrice, true, state.pairConfig.type2));
              state._exitLegBPlaced = true;
              if (resultB.fillStatus !== 'error') {
                state.closeOrderIdB = resultB.orderId;
                state.exitLegBFilled = resultB.fillStatus === 'filled';
                state._exitPriceB = resultB.filledPrice || state._pendingLegBPrice;
                state._exitCommB = resultB.commission;
                if (state.exitTradeId) await Trade.update({ legB_orderId: resultB.orderId }, { where: { id: state.exitTradeId } }).catch(() => { });
              } else {
                state._exitLegBPlaced = false; // retry next poll
              }
            }
          } else if (sA.status === 'cancelled') {
            // LegA cancelled — abort exit, do NOT place legB
            clearInterval(state.pollTimer); state.pollTimer = null;
            if (state.exitTradeId) await Trade.update({ status: 'cancelled' }, { where: { id: state.exitTradeId } }).catch(() => { });
            state.state = STATES.POSITION_OPEN; state.exitReason = null;
            state.closeOrderIdA = null; state.closeOrderIdB = null;
            state.exitLegAFilled = false; state.exitLegBFilled = false;
            state._exitLegBPlaced = false;
            console.log(`[TradeExecutor] BASIS exit: legA cancelled, aborting — legB NOT placed pair ${pairId}`);
            this._broadcastState(pairId); return;
          }
        }
        // Poll legB (once placed)
        if (state.closeOrderIdB && !state.exitLegBFilled) {
          const sB = await this._getOrderStatus(state.exchangeExec, state.clientExec, state.closeOrderIdB);
          if (sB.status === 'filled') {
            state.exitLegBFilled = true;
            state._exitPriceB = sB.filledPrice || state.orderPrice;
            state._exitCommB = sB.commission;
          } else if (sB.status === 'cancelled' && state.exitLegAFilled) {
            // LegB cancelled after legA filled — retry at market
            console.warn(`[TradeExecutor] BASIS exit: legB cancelled after legA filled — retrying market pair ${pairId}`);
            state.closeOrderIdB = null;
            state._exitLegBPlaced = false;
          }
        }
        if (state.exitLegAFilled && state.exitLegBFilled) {
          clearInterval(state.pollTimer); state.pollTimer = null;
          await this._finaliseBasisExit(state, state._exitPriceA, state._exitPriceB, state._exitCommA, state._exitCommB);
        }
        return;
      }
      return;
    }

    // ── SINGLE-LEG POLL (unchanged logic) ─────────────────────────────
    const { status, filledPrice, filledSz, commission } = await this._getOrderStatus(state.exchangeExec, state.clientExec, state.orderId);

    if (status === 'filled') {
      clearInterval(state.pollTimer);
      state.pollTimer = null;

      const price = filledPrice || state.orderPrice;

      if (state.state === STATES.ENTRY_PENDING) {
        const actualQty = filledSz > 0 ? filledSz : state.pairConfig.qty2;
        state.entryPrice = price;
        state.filledQty += actualQty;
        state.activeQty = actualQty;

        const entryCommissionUsd = commission != null
          ? (state.exchangeExec === 'deribit'
            ? parseFloat((commission * price).toFixed(6))
            : parseFloat(commission.toFixed(6)))
          : null;
        state.entryCommissionUsd = entryCommissionUsd;

        if (state.activeTradeId) {
          await Trade.update({
            legA_price: price, legA_qty: actualQty, legA_filledAt: new Date(),
            commission: entryCommissionUsd, status: 'filled',
          }, { where: { id: state.activeTradeId } });
        }

        state.state = STATES.POSITION_OPEN;
        const commStr = entryCommissionUsd != null ? ` commission=$${entryCommissionUsd}` : '';
        console.log(`[TradeExecutor] POSITION OPEN pair ${pairId} | ${state.direction.toUpperCase()} ${state.pairConfig.symbol2} @ ${price} qty=${actualQty}${commStr}`);

        // Place CL taker hedge at 70% of filled BRENT qty (single-leg CL/BRENT only)
        const entryTradeId = state.activeTradeId;
        state.orderId = null; state.activeTradeId = null;
        if (!state.isBasisPair && state.pairConfig.symbol1) {
          await this._placeClHedge(state, actualQty, entryTradeId);
        }

      } else if (state.state === STATES.EXIT_PENDING) {
        const exitPrice = price;
        const qty = state.activeQty || state.pairConfig.qty2;
        const priceDelta = state.direction === 'long'
          ? exitPrice - state.entryPrice
          : state.entryPrice - exitPrice;
        const grossPnl = this._calcPnlUsd(state, priceDelta, qty, state.entryPrice);

        const exitCommissionUsd = commission != null
          ? (state.exchangeExec === 'deribit'
            ? parseFloat((commission * exitPrice).toFixed(6))
            : parseFloat(commission.toFixed(6)))
          : null;
        const totalCommissionUsd = (state.entryCommissionUsd != null && exitCommissionUsd != null)
          ? parseFloat((state.entryCommissionUsd + exitCommissionUsd).toFixed(6))
          : exitCommissionUsd ?? state.entryCommissionUsd ?? null;
        const pnl = totalCommissionUsd != null
          ? parseFloat((grossPnl - totalCommissionUsd).toFixed(6))
          : grossPnl;

        if (pnl < 0) {
          state.dailyLoss = parseFloat((state.dailyLoss + Math.abs(pnl)).toFixed(6));
          if (state.exitReason === 'stop') { state.consecutiveLosses++; state.lastLossTime = Date.now(); }
        } else {
          state.dailyProfit = parseFloat((state.dailyProfit + pnl).toFixed(6));
          state.consecutiveLosses = 0;
        }
        state.lastTradeTime = Date.now();

        const balanceAfter = await this._getAccountBalance(state);
        if (balanceAfter != null) state._cachedBalance = balanceAfter;
        const exchangePnl = (state._entryBalanceBefore != null && balanceAfter != null)
          ? parseFloat((balanceAfter - state._entryBalanceBefore).toFixed(6)) : null;

        if (state.activeTradeId) {
          await Trade.update({
            legA_price: exitPrice, legA_filledAt: new Date(), status: 'filled',
            pnl, legA_pnl: grossPnl, commission: totalCommissionUsd, balanceAfter, exchangePnl,
          }, { where: { id: state.activeTradeId } });
        }

        const commStr = totalCommissionUsd != null ? ` fees=$${totalCommissionUsd}` : '';
        console.log(`[TradeExecutor] POSITION CLOSED pair ${pairId} | ${state.direction} ${state.pairConfig.symbol2} | reason=${state.exitReason} | entry=${state.entryPrice} exit=${exitPrice} gross=$${grossPnl}${commStr} net=$${pnl} | dailyLoss=$${state.dailyLoss.toFixed(4)}`);

        this.tradeCounter++;
        if (aiAgent.isConfigured() && this.tradeCounter % 1000 === 0) {
          aiAgent.reviewCompletedTrade(pairId, { direction: state.direction, entryPriceA: state.entryPrice, exitPriceA: exitPrice, pnl, holdMs: Date.now() - (state.entryTime || 0), exitReason: state.exitReason }, {});
        }

        // Close CL taker hedge (single-leg CL/BRENT only) — must happen before state reset
        const exitTradeIdForHedge = state.activeTradeId;
        if (!state.isBasisPair && state.clHedgeQty > 0) {
          await this._closeClHedge(state, exitTradeIdForHedge);
        }

        state.state = STATES.IDLE; state.orderId = null; state.activeTradeId = null;
        state.entryPrice = null; state.entryMean = null; state.entryTime = null;
        state.direction = null; state.exitReason = null; state.activeQty = null;
        state.exitTradeId = null; state.entryCommissionUsd = null;
        state._entryBalanceBefore = null;
        this._broadcastState(pairId);
      }

    } else if (status === 'cancelled') {
      clearInterval(state.pollTimer);
      state.pollTimer = null;
      console.log(`[TradeExecutor] Order externally cancelled pair ${pairId} state=${state.state}`);
      if (state.activeTradeId) await Trade.update({ status: 'cancelled' }, { where: { id: state.activeTradeId } });
      state.orderId = null; state.activeTradeId = null;
      state.state = state.state === STATES.ENTRY_PENDING ? STATES.IDLE : STATES.POSITION_OPEN;
      if (state.state === STATES.IDLE) { state.direction = null; state.exitReason = null; }
      this._broadcastState(pairId);
    }
    // status === 'open': keep polling
  }

  // ─── STATE / BROADCAST ─────────────────────────────────────────────

  // ─── EXCHANGE RECONCILIATION (runs every 5 min per active pair) ─────────
  //
  // Queries the exchange for live positions, open orders and fills,
  // then compares against the bot's in-memory state and DB records.
  // Detects desyncs and corrects them:
  //   • Stale DB records stuck in "open" → backfilled to filled/cancelled
  //   • In-memory position count mismatches → logged and corrected
  //   • Orphaned open orders the bot no longer knows about → cancelled
  //
  // Also called immediately when daily loss limit is hit, before emergency close.

  _startReconcileTimer(pairId) {
    const state = this.pairs.get(pairId);
    if (!state) return;
    if (state._reconcileTimer) clearInterval(state._reconcileTimer);
    state._reconcileTimer = setInterval(async () => {
      const s = this.pairs.get(pairId);
      if (!s || !s.enabled) {
        clearInterval(state._reconcileTimer);
        state._reconcileTimer = null;
        return;
      }
      await this._reconcileWithExchange(pairId).catch(e =>
        console.error(`[Reconcile] Error pair ${pairId}: ${e.message}`)
      );
    }, 5 * 60 * 1000); // every 5 minutes
    console.log(`[Reconcile] Timer started pair ${pairId} (every 5 min)`);
  }

  async _reconcileWithExchange(pairId) {
    const state = this.pairs.get(pairId);
    if (!state) return;
    const prefix = `[Reconcile] pair ${pairId}`;

    // ── 1. Fetch live exchange data ─────────────────────────────────────────
    let exPositions = [];
    let exOpenOrders = [];
    let exBalance = null;

    if (state.isDeribitBasis) {
      const cred = state.clientExec?.credential || state.clientA?.credential;
      if (!cred?.apiKey || !cred?.secretKey) {
        console.warn(`${prefix} — no Deribit credentials, skipping`);
        return;
      }
      const sym = (state.pairConfig?.symbol2 || '').toUpperCase();
      const currency = sym.startsWith('ETH') ? 'ETH' : sym.includes('USDC') ? 'USDC' : 'BTC';
      const credA = state.clientA?.credential;

      const [posResult, orderResult, summaryResult] = await Promise.all([
        signedRequest(`/api/v2/private/get_positions?currency=${currency}`, credA.apiKey, credA.secretKey).catch(() => null),
        signedRequest(`/api/v2/private/get_open_orders_by_currency?currency=${currency}`, credA.apiKey, credA.secretKey).catch(() => null),
        signedRequest(`/api/v2/private/get_account_summary?currency=${currency}&extended=true`, credA.apiKey, credA.secretKey).catch(() => null),
      ]);

      exPositions = Array.isArray(posResult?.result) ? posResult.result : [];
      exOpenOrders = Array.isArray(orderResult?.result) ? orderResult.result : [];
      const eq = summaryResult?.result?.equity;
      const ix = summaryResult?.result?.index_price;
      if (eq != null && ix != null) exBalance = parseFloat((eq * ix).toFixed(2));
      else if (eq != null) exBalance = parseFloat(eq.toFixed(6));
      const feeLevel = summaryResult?.result?.fee_level ?? null;
      if (feeLevel != null) state._feeLevel = feeLevel;

    } else if (state.exchangeExec === 'hyperliquid') {
      const client = state.clientExec;
      const address = client?.exchange?.wallet?.address || client?.vaultAddress;
      if (!address) return;
      const chState = await client.info.perpetuals.getClearinghouseState(address).catch(() => null);
      exPositions = chState?.assetPositions?.map(p => p.position) || [];
      exBalance = parseFloat(chState?.marginSummary?.accountValue || 0);
      exOpenOrders = []; // HyperLiquid xyz DEX orders not queryable via this API
    }

    // ── 2. Position size reconciliation ────────────────────────────────────
    if (state.isBasisPair && state.maxPositions > 1) {
      const symA = state.symbolA;
      const symB = state.pairConfig?.symbol2;

      // Expected position from in-memory openPositions
      let expectedNetA = 0, expectedNetB = 0;
      for (const pos of state.openPositions) {
        if (pos.posState === 'closed') continue;
        if (pos.direction === 'long') {
          // long: sold futures (legA), bought perp (legB)
          expectedNetA -= (pos.qty1 || state.pairConfig.qty1);
          expectedNetB += (pos.qty2 || state.pairConfig.qty2);
        } else {
          expectedNetA += (pos.qty1 || state.pairConfig.qty1);
          expectedNetB -= (pos.qty2 || state.pairConfig.qty2);
        }
      }

      const exPosA = exPositions.find(p => p.instrument_name === symA || p.coin === symA);
      const exPosB = exPositions.find(p => p.instrument_name === symB || p.coin === symB);
      const exNetA = parseFloat(exPosA?.size ?? exPosA?.szi ?? 0);
      const exNetB = parseFloat(exPosB?.size ?? exPosB?.szi ?? 0);
      const diffA = Math.round(exNetA - expectedNetA);
      const diffB = Math.round(exNetB - expectedNetB);

      if (Math.abs(diffA) > 5 || Math.abs(diffB) > 5) {
        console.warn(`${prefix} POSITION MISMATCH detected!`);
        console.warn(`${prefix}   ${symA}: exchange=${exNetA}  bot_expected=${expectedNetA}  diff=${diffA}`);
        console.warn(`${prefix}   ${symB}: exchange=${exNetB}  bot_expected=${expectedNetB}  diff=${diffB}`);
        this._broadcastState(pairId);
      } else {
        console.log(`${prefix} positions match ✓  ${symA}=${exNetA}  ${symB}=${exNetB}`);
      }
    }

    // ── 3. Orphaned open orders on exchange the bot doesn't know about ────
    const botKnownOrders = new Set();
    for (const pos of (state.openPositions || [])) {
      if (pos.orderIdA) botKnownOrders.add(String(pos.orderIdA));
      if (pos.orderIdB) botKnownOrders.add(String(pos.orderIdB));
      if (pos.closeOrderIdA) botKnownOrders.add(String(pos.closeOrderIdA));
      if (pos.closeOrderIdB) botKnownOrders.add(String(pos.closeOrderIdB));
    }
    if (state.orderId) botKnownOrders.add(String(state.orderId));
    if (state.orderIdA) botKnownOrders.add(String(state.orderIdA));
    if (state.orderIdB) botKnownOrders.add(String(state.orderIdB));
    if (state.closeOrderIdA) botKnownOrders.add(String(state.closeOrderIdA));
    if (state.closeOrderIdB) botKnownOrders.add(String(state.closeOrderIdB));

    for (const order of exOpenOrders) {
      const oid = String(order.order_id || order.oid);
      if (!botKnownOrders.has(oid)) {
        console.warn(`${prefix} ORPHAN ORDER on exchange — cancelling: ${order.instrument_name} ${order.direction} ${order.amount} @ ${order.price} id=${oid}`);
        const credA = state.clientA?.credential;
        if (credA?.apiKey) {
          await signedRequest(`/api/v2/private/cancel?order_id=${oid}`, credA.apiKey, credA.secretKey).catch(() => { });
        }
      }
    }

    // ── 4. DB stale "open" record backfill ─────────────────────────────────
    const staleRecords = await Trade.findAll({
      where: { pairId, status: 'open' },
      order: [['createdAt', 'DESC']],
      limit: 50,   // process 50 at a time, next run gets the rest
    }).catch(() => []);

    let backfilledCount = 0;
    for (const rec of staleRecords) {
      try {
        const orderId = rec.legA_orderId;
        if (!orderId) {
          await Trade.update({ status: 'cancelled' }, { where: { id: rec.id } });
          backfilledCount++;
          continue;
        }
        if (state.isDeribitBasis) {
          const credA = state.clientA?.credential;
          if (!credA?.apiKey) continue;
          const orderState = await signedRequest(
            `/api/v2/private/get_order_state?order_id=${orderId}`,
            credA.apiKey, credA.secretKey
          ).catch(() => null);
          const os = orderState?.result?.order_state;
          if (os === 'filled') {
            await Trade.update({ status: 'filled', legA_filledAt: new Date() }, { where: { id: rec.id } });
            backfilledCount++;
          } else if (os === 'cancelled' || os === 'rejected') {
            await Trade.update({ status: 'cancelled' }, { where: { id: rec.id } });
            backfilledCount++;
          }
          // 'open' = still live, leave it; 'unknown' = skip
        }
        // HyperLiquid xyz DEX orders cannot be queried this way
      } catch (e) {
        console.warn(`${prefix} stale record ${rec.id} check error: ${e.message}`);
      }
    }
    if (backfilledCount > 0) {
      console.log(`${prefix} backfilled ${backfilledCount} stale DB records`);
    }

    // ── 5. Balance + positions update ──────────────────────────────────────
    if (exBalance != null) {
      state._cachedBalance = exBalance;
      if (state._startBalance == null) {
        state._startBalance = exBalance;
        // Session start — always updated on each enable
        StatArbInput.update({ sessionStartBalance: exBalance }, { where: { id: pairId } }).catch(() => { });
        // Lifetime start — set once on the very first enable, never overwritten
        // Use conditional update: only writes if botStartBalance IS NULL in DB
        StatArbInput.update(
          { botStartBalance: exBalance, botStartedAt: new Date() },
          { where: { id: pairId, botStartBalance: null } }
        ).catch(() => { });
        console.log(`${prefix} session start balance: $${exBalance.toFixed(2)}`);
      }
      console.log(`${prefix} balance updated: $${exBalance.toFixed(2)}`);
    }
    if (exPositions.length > 0) {
      state._livePositions = exPositions.map(p => ({
        instrument: p.instrument_name || p.coin || '',
        size: parseFloat(p.size ?? p.szi ?? 0),
        direction: p.direction || (parseFloat(p.size ?? p.szi ?? 0) >= 0 ? 'buy' : 'sell'),
        avgPrice: parseFloat(p.average_price_usd ?? p.average_price ?? p.entryPx ?? 0),
      })).filter(p => p.size !== 0);
    }
    // Cumulative maker rebate (negative commissions = rebates received)
    if (state.isDeribitBasis || state.exchangeExec === 'deribit') {
      try {
        const [[row]] = await sequelize.query(
          `SELECT COALESCE(SUM(commission), 0) AS total FROM trade_logs WHERE pairId = :pairId AND status = 'filled' AND commission < 0`,
          { replacements: { pairId } }
        );
        state._makerRebate = parseFloat(Math.abs(row.total).toFixed(4));
      } catch (e) {
        console.warn(`${prefix} rebate query failed: ${e.message}`);
      }
    }

    this._broadcastAccountInfo(pairId);

    console.log(`${prefix} reconciliation complete — ${staleRecords.length} stale checked, ${backfilledCount} backfilled, ${exOpenOrders.length} open orders checked`);
  }

  // Close all exchange positions and cancel all open orders for a pair.
  // Called on daily loss limit breach or manual emergency stop.
  async _emergencyCloseAll(pairId, reason = 'emergency') {
    const state = this.pairs.get(pairId);
    if (!state) return;
    const prefix = `[EmergencyClose] pair ${pairId} reason=${reason}`;
    console.warn(`${prefix} — starting`);

    // First reconcile to get the true picture
    await this._reconcileWithExchange(pairId).catch(() => { });

    if (state.isDeribitBasis) {
      const credA = state.clientA?.credential;
      if (!credA?.apiKey) return;
      const currency = (state.pairConfig?.symbol2 || 'BTC-PERPETUAL').startsWith('ETH') ? 'ETH' : 'BTC';

      // 1. Cancel ALL open orders
      const openOrders = await signedRequest(
        `/api/v2/private/get_open_orders_by_currency?currency=${currency}`,
        credA.apiKey, credA.secretKey
      ).catch(() => null);
      for (const o of (openOrders?.result || [])) {
        await signedRequest(`/api/v2/private/cancel?order_id=${o.order_id}`, credA.apiKey, credA.secretKey)
          .catch(() => { });
        console.warn(`${prefix} cancelled order ${o.order_id} ${o.instrument_name} ${o.direction} ${o.amount}`);
      }

      // 2. Close all open positions at market
      const positions = await signedRequest(
        `/api/v2/private/get_positions?currency=${currency}`,
        credA.apiKey, credA.secretKey
      ).catch(() => null);
      for (const p of (positions?.result || [])) {
        if (!p.size || p.size === 0) continue;
        const closeDir = p.direction === 'buy' ? 'sell' : 'buy';
        const closeAmt = Math.abs(p.size);
        const path = closeDir === 'buy'
          ? `/api/v2/private/buy?instrument_name=${p.instrument_name}&amount=${closeAmt}&type=market`
          : `/api/v2/private/sell?instrument_name=${p.instrument_name}&amount=${closeAmt}&type=market`;
        await signedRequest(path, credA.apiKey, credA.secretKey).catch(() => { });
        console.warn(`${prefix} market-closed ${p.instrument_name} ${closeDir} ${closeAmt}`);
      }
    }

    // Clear all in-memory positions
    for (const pos of (state.openPositions || [])) {
      pos.posState = 'closed';
      if (pos._pollTimer) { clearInterval(pos._pollTimer); pos._pollTimer = null; }
    }
    state.openPositions = [];
    state.state = STATES.IDLE;
    state._exiting = false;
    console.warn(`${prefix} — complete, all positions closed`);
    this._broadcastState(pairId);
  }

  getState(pairId) {
    const state = this.pairs.get(pairId);
    if (!state) return { enabled: false, state: STATES.IDLE };
    return {
      enabled: state.enabled,
      state: state.state,
      orderId: state.orderId,
      orderPrice: state.orderPrice,
      entryPrice: state.entryPrice,
      direction: state.direction,
      exitReason: state.exitReason,
      profitTarget: state.profitTarget,
      stopLoss: state.stopLoss,
      activeTradeId: state.activeTradeId,
      entryZScore: state.entryZScore,
      entrySpread: state.entrySpread,
      filledQty: state.filledQty,
      dailyLoss: state.dailyLoss,
      dailyLossLimit: state.dailyLossLimit,
      execSymbol: state.pairConfig?.symbol2 || null,
      execExchange: state.exchangeExec || null,
      enabledAt: state._enabledAt?.toISOString() || null,
      // Multi-position fields
      maxPositions: state.maxPositions > 1 ? state.maxPositions : undefined,
      openPositions: state.maxPositions > 1 ? state.openPositions.filter(p => p.posState !== 'closed').map(p => ({
        posId: p.posId,
        direction: p.direction,
        gridLevel: p.gridLevel,
        entryPriceA: p.entryPriceA,
        entryPriceB: p.entryPriceB,
        entrySpread: p.entrySpread,
        entryZScore: p.entryZScore,
        qty1: p.qty1,
        qty2: p.qty2,
        posState: p.posState,
        minProfitUsd: p._minProfitUsd,
        entryTime: p.entryTime,
        entryCommissionA: p.entryCommissionA,
        entryCommissionUsd: p.entryCommissionUsd,
      })) : undefined,
    };
  }

  _broadcastState(pairId) {
    orderbookManager.broadcast({ type: 'trade_state', pairId, ...this.getState(pairId) });
  }

  getAccountInfo(pairId) {
    const state = this.pairs.get(pairId);
    if (!state) return null;
    return {
      balance: state._cachedBalance,
      startBalance: state._startBalance,
      positions: state._livePositions || [],
      feeLevel: state._feeLevel,
      makerRebate: state._makerRebate,
    };
  }

  _broadcastAccountInfo(pairId) {
    const info = this.getAccountInfo(pairId);
    if (info) orderbookManager.broadcast({ type: 'account_info', pairId, ...info });
  }
}

module.exports = new TradeExecutor();
