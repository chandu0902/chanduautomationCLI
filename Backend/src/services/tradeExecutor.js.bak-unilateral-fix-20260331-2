class TradeExecutor {
  constructor() {
    this.pairs = new Map();
    this.startedAt = Date.now();
    this.tradeCounter = 0;
  }

  async _getAccountBalance(state) {
    try {
      if (state.exchangeExec === 'hyperliquid') {
        const client = state.clientExec;
        const address = client.exchange?.wallet?.address
          || client.walletAddress
          || client._walletAddress
          || client.vaultAddress;
        if (!address) return null;
        const chState = await client.info.perpetuals.getClearinghouseState(address);
        return parseFloat(chState?.marginSummary?.accountValue || 0);
      }
      if (state.exchangeExec === 'deribit') {
        const cred = state.clientExec?.credential;
        if (!cred?.apiKey || !cred?.secretKey) return null;
        // Derive currency from the exec symbol: BTC-PERPETUAL → BTC, ETH-PERPETUAL → ETH, *-USDC → USDC
        const sym = (state.execSymbol || state.pairConfig?.symbol2 || '').toUpperCase();
        const currency = sym.includes('USDC') ? 'USDC'
          : sym.startsWith('ETH') ? 'ETH'
            : 'BTC';
        const resp = await signedRequest(
          `/api/v2/private/get_account_summary?currency=${currency}&extended=true`,
          cred.apiKey, cred.secretKey
        );
        const equity = resp?.result?.equity;
        if (equity != null) {
          // USDC contracts are already USD-denominated; inverse (BTC/ETH) need × index_price
          if (currency === 'USDC') return parseFloat(equity.toFixed(2));
          const indexPrice = resp?.result?.index_price;
          if (indexPrice) return parseFloat((equity * indexPrice).toFixed(2));
          return parseFloat(equity);
        }
        return null;
      }
    } catch (e) {
      console.warn(`[TradeExecutor] Failed to fetch balance: ${e.message}`);
    }
    return null;
  }

  async _initClient(exchange, credentials) {
    const ex = exchange.toLowerCase();
    if (ex === 'deribit') {
      return await initializeClient('deribit', {
        apiKey: credentials.apiKey,
        secret: credentials.secret,
      });
    } else if (ex === 'hyperliquid') {
      const client = await initializeClient('hyperliquid', {
        secret: credentials.secret,
        vaultAddress: credentials.vaultAddress || undefined,
      });
      if (client.connect) await client.connect();
      await this._loadDexAssets(client);
      return client;
    }
    throw new Error(`Unsupported exchange: ${exchange}`);
  }

  async _loadDexAssets(client) {
    const sc = client.symbolConversion;
    await sc.ensureInitialized();
    if (sc.stopPeriodicRefresh) sc.stopPeriodicRefresh();
    try {
      const perpDexs = await sc.httpApi.makeRequest({ type: 'perpDexs' }, 20);
      if (!Array.isArray(perpDexs) || perpDexs.length < 2) return;
      for (let i = 1; i < perpDexs.length; i++) {
        const dex = perpDexs[i];
        if (!dex || !dex.name) continue;
        const offset = 110000 + (i - 1) * 10000;
        try {
          const resp = await sc.httpApi.makeRequest({ type: 'metaAndAssetCtxs', dex: dex.name }, 20);
          if (!resp || !resp[0] || !resp[0].universe) continue;
          resp[0].universe.forEach((asset, idx) => {
            sc.assetToIndexMap.set(asset.name, offset + idx);
          });
          console.log(`[TradeExecutor] Loaded ${resp[0].universe.length} ${dex.name} dex assets`);
        } catch (e) {
          console.error(`[TradeExecutor] Failed to load ${dex.name} dex assets: ${e.message}`);
        }
      }
    } catch (e) {
      console.error(`[TradeExecutor] Failed to load dex list: ${e.message}`);
    }
  }

  _buildHyperliquidCoin(symbol, type) {
    if (type === 'perps') return symbol.endsWith('-PERP') ? symbol : `${symbol}-PERP`;
    return `${type}:${symbol}`;
  }

  _parseHyperliquidOrderResponse(result) {
    const status0 = result?.response?.data?.statuses?.[0];
    if (!status0) return { orderId: null, fillStatus: 'error', errorMsg: 'No status in response' };
    if (status0.filled) return { orderId: status0.filled.oid, fillStatus: 'filled', errorMsg: null };
    if (status0.resting) return { orderId: status0.resting.oid, fillStatus: 'resting', errorMsg: null };
    const errorMsg = typeof status0.error === 'string' ? status0.error : JSON.stringify(status0);
    return { orderId: null, fillStatus: 'error', errorMsg };
  }

  async _placeSellOrder(exchange, client, symbol, qty, price, isMarket, type) {
    const ex = exchange.toLowerCase();
    console.log(`[TradeExecutor] ${isMarket ? 'MARKET' : 'LIMIT'} SELL ${symbol} qty=${qty} @ ${price} on ${ex}`);
    if (ex === 'deribit') {
      const cred = client.credential;
      const orderType = isMarket ? 'market' : 'limit';
      const result = await sellorder(symbol, qty, orderType, price, cred.apiKey, cred.secretKey);
      const order = result?.result?.order;
      const orderId = order?.order_id || null;
      const orderState = order?.order_state;
      const fillStatus = !orderId ? 'error'
        : orderState === 'filled' ? 'filled'
          : 'resting';
      const filledPrice = orderState === 'filled' ? (order.average_price || price) : null;
      const errorMsg = !orderId ? (typeof result === 'string' ? result : JSON.stringify(result)) : null;
      let commission = null;
      if (orderState === 'filled' && orderId) {
        try {
          const tradeResp = await signedRequest(
            `/api/v2/private/get_user_trades_by_order?order_id=${orderId}`,
            cred.apiKey, cred.secretKey
          );
          const fills = Array.isArray(tradeResp?.result) ? tradeResp.result : [];
          if (fills.length > 0) {
            commission = fills.reduce((sum, f) => sum + (f.fee ?? 0), 0);
          }
        } catch (e) {
          console.warn(`[_placeSellOrder] fee fetch failed for ${orderId}: ${e.message}`);
        }
      }
      return { orderId, result, fillStatus, filledPrice, commission, errorMsg };
    } else if (ex === 'hyperliquid') {
      const coin = this._buildHyperliquidCoin(symbol, type);
      const result = await hypeplaceOrder({ client, symbol: coin, isBuy: false, quantity: qty, Price: price, isMarket });
      const parsed = this._parseHyperliquidOrderResponse(result);
      return { ...parsed, result };
    }
    throw new Error(`Unsupported exchange: ${exchange}`);
  }

  async _placeBuyOrder(exchange, client, symbol, qty, price, isMarket, type) {
    const ex = exchange.toLowerCase();
    console.log(`[TradeExecutor] ${isMarket ? 'MARKET' : 'LIMIT'} BUY ${symbol} qty=${qty} @ ${price} on ${ex}`);
    if (ex === 'deribit') {
      const cred = client.credential;
