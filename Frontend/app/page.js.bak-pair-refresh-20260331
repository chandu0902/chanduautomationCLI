                    <span className="text-xs text-slate-500 uppercase tracking-wider">{capitalize(exchange2)} / {type2.toUpperCase()}</span>
                    <span className="text-base font-bold text-white font-mono">{symbol2}</span>
                  </div>
                </div>
              </div>
              <button
                onClick={handleSave}
                disabled={saving}
                className="px-8 py-3 rounded-xl bg-gradient-to-r from-blue-500 to-violet-600 text-white text-base font-semibold shadow-lg shadow-blue-500/20 hover:shadow-blue-500/30 hover:from-blue-400 hover:to-violet-500 transition-all duration-200 cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed"
