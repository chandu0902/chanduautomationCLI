          </div>
        </div>
      </div>


      {/* Save Button */}
      {allSelected && (
        <div className="animate-fade-in mb-8">
          <div className="rounded-2xl border border-slate-800/60 bg-gradient-to-r from-blue-500/5 via-slate-900/80 to-violet-500/5 p-5">
            <div className="flex items-center justify-between gap-4 flex-wrap">
              <div className="flex items-center gap-5 flex-wrap">
